#!/usr/bin/env python3
"""s9 발사대 — 본체는 곁의 `s9.py` 다 (REQ-20260905-003).

파이썬은 **직접 실행한 스크립트의 바이트코드를 캐시하지 않는다.** 실측
2026-09-05: `s9 now` 한 번 0.225초 중 0.188초가 2만4천 줄을 매번 컴파일하는
값이었고 실제 일은 0.035초였다 — 시험 한 파일이 s9 를 200번 불러 45초 중 38초가
그것이었고, 매 프롬프트의 훅도 같은 값을 냈다. 그래서 본체를 모듈 파일로 두고
여기서 importlib 의 로더로 읽는다: 로더가 `bin/__pycache__` 에 바이트코드를 두고
mtime·크기로 검증하니, 본체를 고치면 다음 호출이 다시 컴파일해 쓴다. 쓸 수 없는
자리면 그냥 컴파일한다 — 느릴 뿐 틀리지 않는다.

`__file__` 은 이 파일이다 — 본체가 제 자신을 다시 부를 때(serve --supervise ·
metrics run · 감시자) 이 경로를 써야 그 자식도 캐시를 탄다. 본체 소스의 자리는
`__source__` 로 넘긴다(코드 도장이 그것을 stat 한다). 시험이 이 파일을 모듈로
실을 때(SourceFileLoader)도 같은 길이라, 본체의 이름공간이 그 모듈에 그대로 선다.
"""
import importlib.machinery
import os
import sys

# 윈도우에서 출력을 UTF-8 로 고정한다 (REQ-20260903-005) — 판을 가르는 자리는
# 도구마다 같은 글자로 서 있고, 시험이 그것을 못박는다. 본체에도 같은 문이
# 있지만 본체를 못 읽는 사고의 트레이스백까지 깨지지 않게 여기에도 세운다.
if os.name == "nt":
    for _std in (sys.stdout, sys.stderr):
        try:
            _std.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, ValueError, OSError):
            pass

__source__ = os.path.join(os.path.dirname(os.path.realpath(__file__)), "s9.py")
exec(importlib.machinery.SourceFileLoader(__name__, __source__).get_code(__name__),
     globals())
