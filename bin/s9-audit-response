#!/usr/bin/env python3
"""section9 response audit hook (Claude Code Stop).

턴이 끝날 때 transcript에서 어시스턴트의 마지막 응답 텍스트를 추출해,
이 세션의 진행 중 REQ(binding.last_req)의 ## Notes 에 append 한다.
→ 터미널에만 남던 작업 보고/구현 설명이 문서에 영구 기록된다.

Request 턴에만 붙는다 — 프롬프트 훅이 Request일 때 last_req를 set,
Question/Nothing일 때 pause 하므로 엉뚱한 REQ에 붙지 않는다
(last_req 자체는 유지 — 진행 중 위임 캡처/스트림 활성 판정 보존, REQ-20260823-072).

질문 턴(캡처 pause)에는 바인딩의 last_qst 로 폴백해 그 답을 질문 문서(QST)에
`answer` 로 붙인다 (REQ-20260826-017). 답이 채팅에만 남아 두 시간 뒤 "답변을
했었나"가 되던 경로를 닫는 것 — last_req 는 건드리지 않으므로 Request 턴 동작은
그대로다.

원칙: 실패 시 조용히 exit 0. 비활성화: S9_AUDIT=off
"""
import datetime
import json
import os
import re
import shutil
import subprocess
import sys


# 윈도우에서 출력을 UTF-8 로 고정한다 (REQ-20260903-005). 이 도구들의 출력은
# 거의 다 한국어인데, 파이프로 받으면 파이썬이 콘솔 코드페이지(한국어 윈도우는
# cp949)로 인코딩한다 — 실측에서 그 출력을 UTF-8 로 읽은 쪽이 통째로 깨졌다
# (`UnicodeDecodeError: 0xc0 in position 3`). 파일에 남는 기록도 같은 이유로
# 판마다 다른 바이트가 된다. 판을 가르는 자리는 이름을 붙여 한 곳에 둔다:
# 여기가 그 자리이고, 도구마다 같은 글자로 서 있는지는 시험이 못박는다.
if os.name == "nt":
    for _std in (sys.stdout, sys.stderr):
        try:
            _std.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, ValueError, OSError):
            pass

S9 = os.path.join(os.path.dirname(os.path.abspath(__file__)), "s9")
# `bin/s9` 를 부르는 argv (REQ-20260903-005). 경로 하나만 넘기면 **윈도우에서
# 부를 수가 없다** — 그 판에는 shebang 이 없어 확장자 없는 스크립트가
# `CreateProcess` 를 통과하지 못한다(WinError 193/2). 판을 갈라 분기하는 대신
# 판에 기대는 것을 없앤다: 지금 도는 인터프리터로 그 파일을 연다. 리눅스·맥에서
# 하던 일과 결과가 같고(같은 python3 가 같은 스크립트를 연다), 실행 권한 비트나
# `env` 의 존재에도 기대지 않게 된다.
S9_ARGV = [sys.executable, S9]
MAX_CHARS = 12000
# 응답 머리의 시각 도장: `[YYYY-MM-DD HH:MM:SS ZONE - 이름]`
#
# 시간대 라벨을 `KST` 로 못박지 않는다 (REQ-20260903-013). 표시 시간대는 개인
# 설정을 따르는데(REQ-20260828-024 가 프롬프트 훅에서 상수를 걷어냈다) **이쪽만
# 남아 있었다.** KST 아닌 사람이 규약대로 `EST` 를 적으면 이 정규식이 못 알아보고,
# 보정이 "도장이 없다"로 갈라져 **머리에 도장을 하나 더 붙인다** — 두 개가 된다.
# 라벨은 세 꼴을 받는다: 이름(KST·EDT), 수치 오프셋(+09:00), `local`.
STAMP_RE = re.compile(
    r"\A`\[(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}) "
    r"([A-Za-z][A-Za-z0-9]{1,11}|[+-]\d{2}:?\d{2}) - ([^\]\n]+)\]`")
STAMP_DRIFT_SEC = 60      # 이보다 어긋나면 바로잡았다는 사실도 남긴다


def now_stamp(env=None):
    """지금 시각 — 재는 자리는 `s9 now` 한 곳이다 (REQ-20260903-013).

    여기 UTC+9 상수가 남아 있었다. 프롬프트 훅은 개인 설정 timezone 을 따르게
    고쳤는데(REQ-20260828-024) 기록을 바로잡는 이쪽은 그대로여서, KST 아닌
    사람의 문서에는 **훅이 확신 있게 틀린 시각을 적었다.** 같은 물음에 답이 둘이면
    언젠가 갈린다 — 그 둘째를 없앤다.

    부르지 못하면 시스템 로컬로 물러난다: 시각 한 줄 때문에 캡처를 통째로
    잃지 않는다."""
    try:
        out = run(env or dict(os.environ), "now")
        if out.returncode == 0 and out.stdout.strip():
            return out.stdout.strip()
    except Exception:
        pass
    now = datetime.datetime.now().astimezone()
    return f"{now:%Y-%m-%d %H:%M:%S} " + (now.strftime("%Z") or "local")


def correct_stamp(text, now_str):
    """응답 머리의 시각을 **실제 시각**으로 바로잡는다 (REQ-20260826-038).

    모델이 쓰는 시각은 언제나 프롬프트 훅이 주입한 값의 복사본이다 — 턴이
    길면 그만큼 과거를 가리키고, 주입이 없으면 지어낼 수밖에 없다. 모델은
    자기가 말을 마치는 시각을 알 수 없다. **그러니 정확성을 모델에게 맡기지
    않는다**: 턴이 끝나는 지금이 그 응답의 실제 시각이고, 그것을 아는 것은
    이 훅이다.

    이름(역할)은 모델이 쓴 것을 그대로 둔다 — 그건 모델만 아는 사실이다.
    도장이 아예 없으면 붙인다: 기록은 언제 한 말인지 말할 수 있어야 한다.

    반환: (바로잡은 텍스트, 어긋난 초 또는 None)
    """
    m = STAMP_RE.match(text or "")
    if not m:
        return f"`[{now_str} - lead]`\n\n" + (text or ""), None
    try:
        fmt = "%Y-%m-%d %H:%M:%S"
        drift = int(abs((datetime.datetime.strptime(now_str[:19], fmt)
                         - datetime.datetime.strptime(m.group(1), fmt))
                        .total_seconds()))
    except ValueError:
        drift = None
    fixed = f"`[{now_str} - {m.group(3)}]`" + text[m.end():]
    return fixed, drift



def _detect_root(data):
    """세션 cwd가 s9 리포(인스턴스)면 그 루트를 S9_ROOT로 승격 — 한 머신에서
    업스트림 카피와 인스턴스를 병행할 때 기록이 세션 위치를 따라간다
    (REQ-20260824-053). 명시된 S9_ROOT가 항상 우선."""
    if os.environ.get("S9_ROOT"):
        return
    cwd = (data.get("cwd") or "").strip()
    if cwd and os.path.exists(os.path.join(cwd, "bin", "s9")) \
            and os.path.isdir(os.path.join(cwd, "vault")):
        os.environ["S9_ROOT"] = cwd

def _mirror_dir(root):
    """기록을 쓸 자리 — 켜짐 판정과 자리 판정을 **한 번에** 받아 온다.

    판정은 bin/s9 한 곳에 있다(REQ-20260827-078). 꺼져 있으면 빈 문자열이다.
    못 읽으면 사람별 자리를 스스로 짜지 않고 옛 공용 자리로 물러난다 — 기록을
    남기는 쪽이 안전한 기본값이고, 자리를 잘못 짜면 resume 이 못 찾는다.
    """
    try:
        out = subprocess.run([*S9_ARGV, "stream", "--dir"], capture_output=True,
                             encoding="utf-8", errors="replace", env={**os.environ, "S9_ROOT": root},
                             timeout=10)
        if out.returncode == 0:
            return out.stdout.strip()
    except Exception:
        pass
    return os.path.join(root, "streams")


MIRROR_PREFIX_CHECK = 4096      # 되감김 판별용으로 앞머리를 이만큼 비교한다


def mirror_transcript(tp):
    """transcript 를 section9/streams/ 로 미러 — **늘어난 만큼만** 쓴다.

    파일명은 원본 basename(=전체SID.jsonl)이다. resume 이 찾는 이름과 100%
    일치해야 크로스머신 resume 이 된다(DOC-20260823-002).

    예전에는 매 턴 `copyfile` 로 전체를 다시 썼다. 세션이 자랄수록 턴당 비용이
    커지고 누적은 대략 제곱으로 는다 — 실측(REQ-20260827-039): 7.7MB 세션에서
    한 턴에 7.7MB, 하루 누적 7GB 규모. 미러 50개 156MB 중 원본이 사라져 미러만
    남은 것은 1개뿐이었다. 미러를 없앨 게 아니라 **값을 치르는 방식**이 틀렸다.

    이어 쓰기의 함정: transcript 는 압축(compact)으로 줄거나 다시 쓰일 수 있다.
    그때 뒤에만 붙이면 미러는 원본과 다른 파일이 된다. 그래서 길이만 보지 않고
    **앞머리가 그대로인지도** 본다 — 아니면 전체 복사로 물러난다.

    반환: "full" | "append" | "skip" | "" (실패). 테스트가 이 판단을 본다.
    """
    try:
        root = os.environ.get("S9_ROOT") or os.path.dirname(
            os.path.dirname(os.path.realpath(__file__)))
        # 사용자가 껐으면 아무것도 쓰지 않는다 (REQ-20260827-042). 깃헙에 안
        # 올라가는 것도 여기서 저절로 성립한다 — **없어서 안 올라간다.**
        dst_dir = _mirror_dir(root)
        if not dst_dir:
            return "off"
        os.makedirs(dst_dir, exist_ok=True)
        dst = os.path.join(dst_dir, os.path.basename(tp))
        ssz = os.path.getsize(tp)
        try:
            dsz = os.path.getsize(dst)
        except OSError:
            dsz = -1
        if dsz < 0 or ssz < dsz:
            shutil.copyfile(tp, dst)          # 첫 복사 · 되감김(압축)
            return "full"
        if dsz and not _same_head(tp, dst, min(dsz, MIRROR_PREFIX_CHECK)):
            shutil.copyfile(tp, dst)          # 앞머리가 바뀜 — 다른 파일이다
            return "full"
        if ssz == dsz:
            return "skip"                     # 늘어난 게 없으면 건드리지 않는다
        with open(tp, "rb") as src, open(dst, "ab") as out:
            src.seek(dsz)
            while True:
                chunk = src.read(1 << 20)
                if not chunk:
                    break
                out.write(chunk)
        return "append"
    except Exception:
        return ""                             # 미러 실패가 응답 캡처를 막지 않는다


def _same_head(a, b, n):
    try:
        with open(a, "rb") as fa, open(b, "rb") as fb:
            return fa.read(n) == fb.read(n)
    except OSError:
        return False


def run(env, *argv, inp=None):
    return subprocess.run([*S9_ARGV, *argv], input=inp, capture_output=True,
                          encoding="utf-8", errors="replace", env=env, timeout=15)


def pending_questions(env):
    """답을 기다리는 질문 문서들 (REQ-20260827-049).

    예전에는 `last_qst` 한 칸뿐이었다. 그래서 **질문이 답보다 빨리 오면 앞
    질문이 지워졌다** — 실사고 20:25 질문이 20:28 질문에 덮여 영영 미답으로
    남았다. 연달아 묻는 대화에서는 반드시 일어난다.

    이제 `pending_qst` 목록에 쌓고 그 턴의 답을 **모두에게** 붙인다. 한 답이
    여러 질문에 붙는 것이 이상해 보일 수 있지만, 실제로 그 한 응답이 그
    질문들을 함께 다룬 것이라 사실에 맞다 — 붙일 곳이 없어 잃는 것보다 낫다.

    `last_qst` 는 폴백으로 남긴다: 대시보드·기존 훅이 읽는 이름이라 지우면
    다른 자리가 깨진다.
    """
    out = run(env, "bind")
    if out.returncode != 0:
        return []
    try:
        b = json.loads(out.stdout) or {}
    except ValueError:
        return []
    q = b.get("pending_qst") or []
    if isinstance(q, str):
        q = [x for x in q.split(",") if x.strip()]
    q = [x.strip() for x in q if x and x.strip()]
    if q:
        return q
    one = (b.get("last_qst") or "").strip()
    return [one] if one else []


def last_assistant_text(transcript_path):
    """마지막 assistant 텍스트와 그 model 을 함께 반환 (text, model).
    model 은 리드 에이전트 귀속(--agent lead:<model>)에 쓴다."""
    text, model = None, None
    with open(transcript_path, encoding="utf-8") as f:
        for line in f:
            try:
                obj = json.loads(line)
            except ValueError:
                continue
            if obj.get("type") != "assistant":
                continue
            msg = obj.get("message") or {}
            parts = [c.get("text", "") for c in (msg.get("content") or [])
                     if isinstance(c, dict) and c.get("type") == "text"]
            t = "\n\n".join(p for p in parts if p).strip()
            if t:
                text = t
                model = msg.get("model") or model
    return text, model


def main():
    if os.environ.get("S9_AUDIT", "").lower() == "off":
        return
    data = json.load(sys.stdin)
    _detect_root(data)
    if data.get("stop_hook_active"):
        return
    tp = data.get("transcript_path")
    if not tp or not os.path.exists(tp):
        return
    session = (data.get("session_id") or "unknown")[:8]
    env = dict(os.environ)
    env["S9_SESSION"] = session
    mirror_transcript(tp)  # 분류와 무관하게 매 턴 스트림 미러링 (전체SID 파일명)
    run(env, "bind", "transcript_path", tp)  # live tail 경로 갱신
    run(env, "bind", "cwd", data.get("cwd", ""))  # resume용 cwd

    text, model = last_assistant_text(tp)
    if not text:
        return
    active = run(env, "last", "--active").stdout.strip()
    pend = pending_questions(env)
    # 질문이 걸려 있으면 답은 **질문 문서로 간다** (REQ-20260827-031).
    #
    # 예전에는 진행 중 REQ 가 없을 때만 질문을 봤다. 터미널로 물으면 프롬프트
    # 훅이 그 턴의 캡처를 멈춰(`last --pause`) 조건이 맞아떨어졌지만, **대시보드로
    # 물으면 그 훅을 안 탄다**(수신함 Monitor 경로). 캡처를 멈추는 사람이 없으니
    # 세션이 붙들던 REQ 가 그대로 나오고, 답은 그 REQ 의 response 노트로 갔다 —
    # 질문 문서는 비어 있는 채 남았다. 실사고: 미답 5건이 전부 대시보드 질문.
    # 사용자는 주로 대시보드로 말하므로 질문의 **기본 경로가 통째로 막혀** 있었고,
    # 사람 눈에는 "운에 맡기는" 것으로 보였다.
    #
    # 요청의 작업 보고는 규약상 리드가 직접 남기는 것이 1순위이고(CLAUDE.md 6항)
    # 이 자동 캡처는 그 안전망이다. 안전망이 질문의 답을 삼켜서는 안 된다.
    req, label = (pend[0], "answer") if pend else (active, "response")
    if not req:
        return  # Nothing/Fragment 턴 — 붙일 문서가 없다
    # 시각은 모델이 아니라 훅이 책임진다 (REQ-20260826-038) — 자르기 전에
    # 바로잡는다(도장은 머리에 있으니 잘림과 무관하지만 순서를 고정해 둔다).
    text, drift = correct_stamp(text, now_stamp(env))
    if drift is not None and drift >= STAMP_DRIFT_SEC:
        run(env, "log", f"stamp 보정: 응답 시각이 {drift}s 어긋나 실제 시각으로 고쳤다")
    if len(text) > MAX_CHARS:
        text = text[:MAX_CHARS] + "\n\n…(truncated)"
    # 리드 에이전트 귀속: 오케스트레이터(메인 세션)를 lead:<model> 로 기록
    agent = f"lead:{model}" if model else "lead"
    if label == "answer":
        # 기다리던 질문 **전부**에 붙인다. 하나가 사라졌다고 나머지 답까지
        # 버리지 않는다 — 하나라도 붙으면 그 턴은 성공이다.
        ok = 0
        for q in pend:
            r = run(env, "note", q, "--label", label, "--agent", agent,
                    inp=text)
            if r.returncode == 0:
                ok += 1
                run(env, "log", f"answer → {q} by {agent} ({len(text)} chars)")
        run(env, "bind", "pending_qst", "")
        run(env, "bind", "last_qst", "")
        if ok:
            return
        # 하나도 못 붙였으면 진행 중 요청으로 물러난다 — 붙일 곳이 없다고
        # 답을 통째로 버리면 지금 고치는 것과 같은 실패다 (REQ-20260827-031).
        if not active:
            return
        req, label = active, "response"
    out = run(env, "note", req, "--label", label, "--agent", agent, inp=text)
    if out.returncode == 0:
        run(env, "log", f"{label} → {req} by {agent} ({len(text)} chars)")


if __name__ == "__main__":
    try:
        main()
    except Exception:
        sys.exit(0)
