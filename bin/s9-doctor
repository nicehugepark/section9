#!/usr/bin/env python3
"""s9 doctor — 네트워크/자원 상태 진단과 즉시 복구 (REQ-20260825-099).

배경(2026-08-25 실측): WSL virtioproxy 모드에서 새로 bind 한 리스닝 포트는
곧바로 접속되지 않는다 — 호스트에 공개(publish)되기까지 지연이 있고, 그
사이 127.0.0.1 접속은 ECONNREFUSED 다. 평소 ~1초지만 윈도우 측이 압박을
받으면(동시 캡처·대량 포트 생성) 수 초~무한으로 늘어나고, 그때 브라우저는
ERR_NO_BUFFER_SPACE 를 낸다. 기존에 떠 있던 포트는 멀쩡해서 증상이
"방화벽이 막았다"처럼 보이고 OS 재시작으로 대응하기 쉽다.

그래서 이 명령은 **공개 지연을 초 단위로 재고**, 우리가 흘린 자원을 회수한다.

그리고 **윈도우 쪽 동적 포트 소진도**를 함께 본다(REQ-20260825-100). 실제
원인은 리눅스가 아니라 호스트였다 — WSL 포트 중계 COM 대리 프로세스가 동적
포트 16,384개 중 15,709개를 Bound 로 잡고 놓지 않았다. 이 상태에서 리눅스
쪽 자원을 아무리 회수해도 풀리지 않으므로, 그 점유자를 지목해 회수한다.
회수는 `wsl --shutdown` 보다 덜 파괴적이지만 공짜가 아니다 — COM 대리는 필요할
때 다시 뜨지만, **그 중계가 나르던 TCP 연결은 전부 끊긴다**(브라우저 탭·VS Code
Remote 채널·DB 클라이언트). 실행 중인 WSL 세션까지 함께 내려간 사례가 있다
(2026-09-02, REQ-20260902-066). 「세션은 살아남는다」는 거둔 단언이다.

세 번째 축이 **예방**이다(REQ-20260825-102). 캡처가 남긴 브라우저를 그때그때
회수하는 것만으로는 부족했다 — 세션이 중간에 죽거나 캡처가 강제 종료되면
finally 가 돌지 않아 고아 브라우저가 조용히 쌓이고, 그 하나하나가 호스트
포트를 붙잡는다. 그래서 **표식(s9shot-/cdp-prof-)을 가진 오래된 브라우저와
프로필 디렉토리를 주인 없이도 쓸어내는 sweep** 을 두고, 캡처 직전과 서버
감시 주기에서 호출한다.

사용:
  s9-doctor            진단만 (읽기 전용)
  s9-doctor --sweep    고아 캡처 브라우저·프로필 디렉토리만 조용히 회수
  s9-doctor --fix      우리가 흘린 자원 회수(고아 테스트 서버·좀비 캡처·임시 파일)
  s9-doctor --recover  동적 포트를 독차지한 WSL 포트 중계 프로세스 회수(확인 후)
  s9-doctor --json     기계 판독용
"""
import argparse
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time


# 윈도우에서 출력을 UTF-8 로 고정한다 (REQ-20260903-005). 이 도구들의 출력은
# 거의 다 한국어인데, 파이프로 받으면 파이썬이 콘솔 코드페이지(한국어 윈도우는
# cp949)로 인코딩한다 — 실측에서 그 출력을 UTF-8 로 읽은 쪽이 통째로 깨졌다
# (`UnicodeDecodeError: 0xc0 in position 3`). 파일에 남는 기록도 같은 이유로
# 판마다 다른 바이트가 된다. 판을 가르는 자리는 이름을 붙여 한 곳에 둔다:
# 여기가 그 자리이고, 도구마다 같은 글자로 서 있는지는 시험이 못박는다.
if os.name == "nt":
    for _std in (sys.stdout, sys.stderr):
        try:
            _std.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, ValueError, OSError):
            pass

ROOT = os.environ.get("S9_ROOT") or os.path.dirname(
    os.path.dirname(os.path.abspath(__file__)))
ORPHAN_AGE = 180          # 이보다 오래 산 테스트 서버는 고아로 본다


def _envint(name, default):
    """환경변수 하나에서 양의 정수 하나 — 못 읽거나 0 이하면 기본값."""
    try:
        v = int((os.environ.get(name) or "").strip())
    except (TypeError, ValueError):
        return default
    return v if v > 0 else default


# **동시 상한 표** (REQ-20260903-004). 비용은 총량이 아니라 동시 최고치라,
# 흩어져 있으면 겹칠 때의 합을 아무도 모른다. 이 도구는 s9 가 못 뜰 때도 써야
# 해서 s9 를 import 하지 않는다 — 그래서 표를 두 벌 든다. 두 벌이 갈리는 것은
# 시간 문제이므로 tests/test_concurrency.py 가 매번 같은지 확인한다.
CONCURRENCY = {
    "headless": _envint("S9_MAX_HEADLESS", 8),
    "test_jobs": _envint("S9_MAX_JOBS", 8),
    "conns": _envint("S9_MAX_CONNS", 256),
}
PROBE_TIMEOUT = 2.0

# 윈도우 동적 포트 소진도 — 고갈된 뒤가 아니라 임계에서 먼저 알린다.
PORT_WARN = 0.60
PORT_CRIT = 0.85
# 회수 대상 판정: 한 프로세스가 범위의 이만큼을 혼자 잡고 있으면 지배적 점유다.
RELAY_SHARE = 0.30
# 2026-08-25 실측된 WSL 포트 중계 COM 대리의 CLSID (확증용 — 판정 필수 조건은 아니다)
WIN_RELAY_CLSID = "{17696EAC-9568-4CF5-BB8C-82515AAD6C09}"


# 우리 대역은 커널 임시 범위(32768~)와 윈도우 동적 범위(49152~) **아래**에
# 넓게 편다 (REQ-20260904-017 · REQ-20260905-005). 처음엔 풀 18800~18999 바로
# 위에 프로브를 붙여 뒀는데, 풀이 칸 8 로 자라자 프로브와 겹치고 회수 대역을
# 넘은 감시자가 고아로 남았다. 붙여 둘 이유가 없다 — 사이를 비워 둔다:
#     풀      18800 ~ 23999   (칸 수에 따라 자람, 꼭대기 고정 · 회수 대역)
#     (비움)  24000 ~ 29999
#     프로브  30000 ~ 30009
#     더미    31999           (아무도 bind 하지 않는 포트 — 시험용)
# tests/portpool.py 가 풀 꼭대기를 POOL_HI 에 맞추고, test_doctor_probe 가
# 둘이 갈리지 않는지 본다.
PROBE_PORTS = range(30000, 30010)
# 대기 파라미터 — tests/portpool.py 의 wait_server 와 같은 규율: 두드리는
# 횟수가 곧 비용이다(연결 하나 = 윈도우 동적 포트 하나).
PROBE_FIRST, PROBE_MAX, PROBE_GROWTH = 0.05, 2.0, 1.7


def _probe_listener():
    """프로브 리스너 — 임시 포트(0)가 아니라 우리 대역에 세운다.

    예전엔 `bind(("127.0.0.1", 0))` 이었다. 커널 임시 범위라 윈도우 동적
    범위와 겹치고, `tests/portpool.py` 가 시험에서 적발하는 바로 그 행위다 —
    경로가 tests/ 만 보고 있어 도구는 안 걸렸다(devops 판정, REQ-20260904-013).
    """
    last = None
    for port in PROBE_PORTS:
        s = socket.socket()
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            s.bind(("127.0.0.1", port))
            s.listen(8)
            return s, port, None
        except OSError as e:
            last = e
            s.close()
    return None, None, last


def probe_new_port(budget=12.0, _connect=None, _sleep=None):
    """새 포트를 열고 접속 가능해질 때까지 걸리는 시간을 잰다.

    binary 판정이 아니라 **지연 측정**인 이유: 이 증상은 "안 된다"가 아니라
    "늦어진다"이고, 늦어지는 정도가 곧 윈도우 측 압박의 크기다. 0초면 건강,
    1~3초면 정상 범위(virtioproxy 공개 지연), 그 이상이면 서버 기동 코드가
    타임아웃으로 죽기 시작한다.

    **진단이 병을 키우면 안 된다** (REQ-20260904-017). 예전엔 0.25초 고정
    간격으로 최대 12초를 두드렸다 — 건강할 때 분당 1개지만, 공개가 늦어지는
    **바로 그때** 분당 최대 48개 = 시간당 2,880개다. 실측 소모 속도(2,670/h,
    REQ-20260903-003)와 같은 자릿수다. `wait_server` 에서 끊은 되먹임이 도구
    쪽엔 그대로 남아 있었다. 이제 지수 백오프로 12초 안에 10회 이하다.

    그리고 **횟수를 센다.** 0.25초 고정 간격은 7% 창(12~16ms 실패)을 0.25 로
    묻어 지연 숫자에서 안 보이게 했다 — 세지 않는 재시도는 결함을 가린다.
    `attempts` 가 2 이상이면 첫 시도가 거부된 것이고, 그것이 곧 창의 크기다.
    """
    srv, port, err = _probe_listener()
    if srv is None:
        return {"ok": False, "stage": "bind", "error": str(err), "latency": None}
    connect = _connect or (lambda p: socket.create_connection(("127.0.0.1", p), 1).close())
    sleep = _sleep or time.sleep

    import threading

    def accept_loop():
        while True:
            try:
                c, _a = srv.accept()
                c.close()
            except OSError:
                return
    threading.Thread(target=accept_loop, daemon=True).start()

    t0 = time.time()
    attempts, wait, spent = 0, PROBE_FIRST, 0.0
    while True:
        attempts += 1
        try:
            connect(port)
            lat = time.time() - t0
            srv.close()
            return {"ok": True, "port": port, "latency": round(lat, 2),
                    "attempts": attempts}
        except OSError:
            # 예산은 **잠재운 시간**으로 센다 — 벽시계로 세면 잠을 흉내 낸
            # 시험에서 무한히 돌고, 실전에서도 두드리는 횟수가 곧 비용이다.
            if spent + wait >= budget:
                break
            sleep(wait)
            spent += wait
            wait = min(PROBE_MAX, wait * PROBE_GROWTH)
    srv.close()
    return {"ok": False, "stage": "publish", "port": port,
            "error": f"{budget:.0f}초 안에 공개되지 않음", "latency": None,
            "attempts": attempts}


def etime_sec(tok):
    """`[[dd-]hh:]mm:ss` → 초. 맥의 ps 에는 초 단위 `etimes` 가 없다."""
    tok = (tok or "").strip()
    if tok.isdigit():
        return int(tok)
    days = 0
    if "-" in tok:
        d, _, tok = tok.partition("-")
        if not d.isdigit():
            return None
        days = int(d)
    parts = tok.split(":")
    if not parts or not all(p.isdigit() for p in parts) or len(parts) > 3:
        return None
    sec = 0
    for p in parts:
        sec = sec * 60 + int(p)
    return days * 86400 + sec


def ps_rows():
    """(pid, ppid, 경과초, 커맨드) — ps 한 번으로 끝낸다(의존성 0).

    맥의 `ps` 는 GNU 가 아니다 (REQ-20260829-037): `etimes` 키워드가 없어
    옛 형태는 **아무 줄도 못 내고 조용히 빈 목록**이었다 — 그러면 진단이
    "s9 serve 프로세스 0개"라고 태연히 거짓말한다. BSD 형태를 폴백으로 둔다.
    """
    forms = ((["ps", "-eo", "pid,ppid,etimes,args"], True),
             (["ps", "-A", "-ww", "-o", "pid=,ppid=,etime=,command="], False))
    for argv, skip_header in forms:
        try:
            out = subprocess.run(argv, capture_output=True,
                                 encoding="utf-8", errors="replace",
                                 timeout=10).stdout
        except Exception:
            continue
        rows = []
        for line in out.splitlines()[1 if skip_header else 0:]:
            parts = line.strip().split(None, 3)
            if len(parts) != 4 or not parts[0].isdigit() \
                    or not parts[1].isdigit():
                continue
            sec = etime_sec(parts[2])
            if sec is None:
                continue
            rows.append((int(parts[0]), int(parts[1]), sec, parts[3]))
        if rows:
            return rows
    return []


# 부모가 이것들이면 진짜 부모(테스트 러너)는 이미 죽어 재양육된 것이다.
INIT_NAMES = ("/init", "/sbin/init", "systemd", "launchd")
# tests/portpool.py 의 고정 풀이 쓰는 대역. 풀은 칸 수(S9_TEST_PORT_SLOTS)에
# 따라 자라므로 회수 대역은 **풀이 닿을 수 있는 끝까지** 잡는다 — 여기 밖이면
# 회수 대상이 아니므로, 좁게 잡아 놓치는 쪽이 넓게 잡는 쪽보다 나쁘다(이 대역은
# 테스트 전용이다). 꼭대기는 위 표의 풀 끝.
POOL_LO, POOL_HI = 18800, 23999
PORT_RE = re.compile(r"--port\s+(\d+)")


def proc_cmd(pid):
    """그 pid 의 명령줄 (모르면 "").

    갈래가 셋이다 — `/proc` · `ps` · 윈도우. 종전에는 `/proc` 다음이 곧바로
    `ps` 였고, 그래서 **네이티브 윈도우에서는 언제나 빈 문자열**이었다
    (REQ-20260903-005). 진단이 "모른다"가 아니라 "없다"로 답하면, 이 값을
    쓰는 `reparented`·고아 회수가 조용히 틀린 판정을 낸다.
    """
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return f.read().decode("utf-8", "ignore").replace("\0", " ").strip()
    except OSError:
        pass
    if os.name == "nt":
        # 한 pid 만 묻는다 — 이 도구는 몇 개만 보므로 전수 조회가 필요 없다.
        # **첫 문장이 인코딩을 정한다**: PowerShell 은 기본적으로 콘솔
        # 코드페이지로 쓰고, 그러면 받는 쪽이 UTF-8 로 풀다 죽어 빈 문자열이
        # 돌아온다 — 실측으로 잡힌 자리다 (s9.WIN_PS_SCRIPT 와 같은 이유).
        for exe in ("powershell", "pwsh"):
            if not shutil.which(exe):
                continue
            try:
                r = subprocess.run(
                    [exe, "-NoProfile", "-NonInteractive", "-Command",
                     "[Console]::OutputEncoding = "
                     "[System.Text.Encoding]::UTF8; "
                     f"(Get-CimInstance Win32_Process -Filter "
                     f"'ProcessId={int(pid)}').CommandLine"],
                    capture_output=True, timeout=20,
                    encoding="utf-8", errors="replace")
                return (r.stdout or "").strip()
            except Exception:
                return ""
        return ""
    try:
        return subprocess.run(["ps", "-p", str(pid), "-o", "args="],
                              capture_output=True, timeout=5,
                              encoding="utf-8",
                              errors="replace").stdout.strip()
    except Exception:
        return ""


def reparented(ppid):
    """부모를 잃고 init 에 재양육됐는가 — 즉 주인이 죽었는가."""
    if ppid <= 1:
        return True
    cmd = proc_cmd(ppid)
    if not cmd:
        return False
    head = cmd.split()[0]
    return any(head == n or head.endswith(n) for n in INIT_NAMES)


def live_test_runs(base=None):
    """지금 도는 시험 실행의 pid 들 — 실행 루트 s9run-<pid>- 의 주인이 살아 있는 것.

    러너(tests/__main__.py)가 실행마다 이 루트를 만들고 끝나면 지운다. 그래서
    이 목록이 비어 있지 않다는 것은 「누군가의 스위트가 돌고 있다」는 뜻이다.
    """
    # 러너는 자식의 TMPDIR 을 제 실행 루트(/tmp/s9run-<pid>-…)로 돌린다 — 그
    # 안에서 이 도구가 불리면 gettempdir() 은 루트 **안**을 가리켜 형제 실행을
    # 못 본다. 루트의 부모와 시스템 /tmp 를 함께 본다.
    bases = [base] if base else []
    if not bases:
        t = os.path.realpath(tempfile.gettempdir())
        for b in (t, os.path.dirname(t) if TMP_RUN_RE.match(os.path.basename(t)) else "", "/tmp"):
            if b and b not in bases:
                bases.append(b)
    pids = set()
    for b in bases:
        try:
            names = os.listdir(b)
        except OSError:
            continue
        for name in names:
            m = TMP_RUN_RE.match(name)
            if m and owner_alive(int(m.group(1))):
                pids.add(int(m.group(1)))
    return pids


def scan(rows, live_runs=None):
    """살아 있는 s9 서버와 헤드리스 브라우저를 가른다.

    **스위트가 도는 동안은 풀의 재양육 서버를 거두지 않는다** (REQ-20260905-005).
    시험은 감시자(`serve --supervise`)를 double fork 로 **일부러** 재양육시켜
    띄운다 — 그것은 고아가 아니라 시험 중인 물건인데, 「풀 안 + 재양육」만 보면
    똑같이 보인다. 실제 사고 2026-09-05: 회수 대역을 풀 끝까지 넓히자 대시보드의
    1분 틱이 돌고 있는 시험의 감시자를 죽여 전체 스위트가 292→521초가 됐고
    시험 3건이 실패했다. 그래서 살아 있는 실행 루트(s9run-<pid>-)가 하나라도
    있으면 풀의 재양육 서버는 미룬다 — 실행이 끝나면(루트가 사라지면) 다음
    틱과 러너의 끝 회수가 거둔다. `live_runs` 를 넘기면 그것을 쓴다(시험용).

    고아 판정은 **나이가 아니라 주인 사망**이다(REQ-20260826-002 와 같은 규칙).
    나이로 가르면 오래 걸리는 스위트의 멀쩡한 서버를 죽이거나, 방금 버려진
    서버를 유예 시간 동안 방치한다 — 실제로 유예(180초) 탓에 갓 고아가 된
    테스트 서버들이 풀(18800~18863)을 잠식해 다음 스위트가 '포트 풀 소진'으로
    통째로 깨졌다. 테스트 러너가 죽으면 그 서버는 init 에 재양육되므로,
    그 사실만으로 즉시 고아다."""
    serves, orphans, chromes = [], [], []
    running = live_test_runs() if live_runs is None else live_runs
    for pid, ppid, age, cmd in rows:
        if "s9 serve" in cmd or "bin/s9 serve" in cmd:
            serves.append((pid, age, cmd))
            m = PORT_RE.search(cmd)
            in_pool = bool(m) and POOL_LO <= int(m.group(1)) <= POOL_HI
            if in_pool and reparented(ppid) and not running:
                orphans.append((pid, age, cmd))
        elif "chrome" in cmd.lower() and "--headless" in cmd:
            chromes.append((pid, age, cmd))
    return serves, orphans, chromes


def listeners():
    try:
        out = subprocess.run(["ss", "-ltn"], capture_output=True,
                             encoding="utf-8", errors="replace",
                             timeout=10).stdout
        return max(len(out.splitlines()) - 1, 0)
    except Exception:
        return -1


def socket_summary():
    try:
        out = subprocess.run(["ss", "-s"], capture_output=True,
                             encoding="utf-8", errors="replace",
                             timeout=10).stdout
        for line in out.splitlines():
            if line.startswith("TCP:"):
                return line.strip()
    except Exception:
        pass
    return ""


def wsl_mode():
    for cmd in (["wslinfo", "--networking-mode"],):
        try:
            r = subprocess.run(cmd, capture_output=True,
                               encoding="utf-8", errors="replace", timeout=5)
            if r.returncode == 0 and r.stdout.strip():
                return r.stdout.strip()
        except Exception:
            pass
    return ""


def windows_ports(timeout=25):
    """윈도우 동적 포트 소진도와 최다 점유자 — 실패해도 진단을 막지 않는다.

    WSL(virtioproxy)은 리스닝 포트를 호스트에 공개하면서 호스트의 동적 포트를
    소비한다. 그 범위가 마르면 새 포트 공개가 실패하고, 윈도우 앱은
    WSAENOBUFS(브라우저의 ERR_NO_BUFFER_SPACE)를 본다."""
    ps = shutil.which("powershell.exe")
    if not ps:
        return {}
    script = (
        "$ErrorActionPreference='SilentlyContinue';"
        "$b=@(Get-NetTCPConnection -State Bound);"
        "$g=$b | Group-Object OwningProcess | Sort-Object Count -Descending"
        " | Select-Object -First 1;"
        "$pr=Get-CimInstance Win32_Process -Filter ('ProcessId=' + $g.Name);"
        "$s=Get-NetTCPSetting -SettingName InternetCustom;"
        "[pscustomobject]@{bound=$b.Count;start=$s.DynamicPortRangeStartPort;"
        "count=$s.DynamicPortRangeNumberOfPorts;top_pid=[int]$g.Name;"
        "top_count=$g.Count;top_name=$pr.Name;top_cmd=$pr.CommandLine}"
        " | ConvertTo-Json -Compress")
    try:
        r = subprocess.run([ps, "-NoProfile", "-NonInteractive", "-Command",
                            script], capture_output=True,
                                encoding="utf-8", errors="replace",
                           timeout=timeout)
        return json.loads(r.stdout.strip().splitlines()[-1])
    except Exception:
        return {}


def port_verdict(win):
    """소진도 등급 — 윈도우 쪽을 못 읽었으면 빈 판정(진단은 계속된다)."""
    if not win or not win.get("count"):
        return {}
    used = win.get("bound") or 0
    total = win["count"]
    ratio = used / total if total else 0.0
    level = ("critical" if ratio >= PORT_CRIT
             else "warn" if ratio >= PORT_WARN else "ok")
    return {"bound": used, "total": total, "ratio": round(ratio, 3),
            "level": level}


def relay_hoarder(win, share=RELAY_SHARE):
    """동적 포트를 독차지한 WSL 포트 중계 프로세스 — 회수해도 되는 유일한 대상.

    조건 둘을 모두 만족해야 한다: (1) 범위의 지배적 비율을 혼자 점유,
    (2) COM 대리(dllhost.exe). 사용자의 브라우저·앱은 아무리 많이 잡고 있어도
    대상이 아니다 — 그건 안내로만 다룬다."""
    if not win or not win.get("count"):
        return None
    cnt = win.get("top_count") or 0
    if cnt < share * win["count"]:
        return None
    if (win.get("top_name") or "").lower() != "dllhost.exe":
        return None
    cmd = win.get("top_cmd") or ""
    return {"pid": win.get("top_pid"), "name": win.get("top_name"),
            "count": cnt, "cmd": cmd,
            "is_known_relay": WIN_RELAY_CLSID.lower() in cmd.lower()}


def reclaim_relay(target, timeout=30):
    """지목된 중계 프로세스를 종료해 점유 포트를 즉시 반환시킨다."""
    tk = shutil.which("taskkill.exe") or "taskkill.exe"
    r = subprocess.run([tk, "/PID", str(target["pid"]), "/F"],
                       capture_output=True,
                           encoding="utf-8", errors="replace", timeout=timeout)
    return {"pid": target["pid"], "rc": r.returncode,
            "out": (r.stdout or r.stderr).strip()}


# 캡처가 남긴 표식 — 이 이름을 가진 브라우저·프로필은 우리 것이라 주인이
# 사라져도 회수할 수 있다.
SHOT_MARKERS = ("s9shot-", "cdp-prof-")
SWEEP_AGE = 600           # 이보다 오래된 캡처 잔여물은 주인이 없다고 본다
WIN_TEMP = "/mnt/c/Temp"


# 소유자 표식은 `s9shot-<pid>` 정확히 그 형태다. 끝을 막지 않으면 부분매치가
# 난다 — `s9shot-9j2anjm6`(랜덤 접미사가 숫자로 시작) 이 pid 9 로 읽혀 "죽은
# 주인"으로 판정되고 즉시 삭제 대상이 된다. 실제로 이 함정이 테스트의 임시
# 루트를 통째로 지워 플레이크를 만들었다. 뒤에 영숫자·밑줄·하이픈이 이어지면
# 그건 우리 표식이 아니다.
OWNER_RE = re.compile(r"s9shot-(\d+)(?![0-9A-Za-z_-])")
# 캡처 하나가 브라우저 프로세스를 여럿 띄운다(렌더러·GPU·유틸리티 — 실측 11개).
# 그래서 개체수는 프로세스가 아니라 **표식(= 캡처 한 건)** 단위로 센다.
MARKER_RE = re.compile(r"(s9shot-\d+|cdp-prof-[A-Za-z0-9_.\-]+)")

# 표식만으로는 우리 브라우저를 다 보지 못한다 (REQ-20260907-036).
# 실측 2026-09-07 14:31: 주인 없는 headless chrome.exe 5건의 프로필이
# `C:\Temp\s9roster-2054874` · `s9cdp95b` · `s9belt-3523657` · `s9projclick`
# 였다 — 전부 `s9 shot` 을 거치지 않고 검증 중에 임시로 지은 이름이라
# SHOT_MARKERS 에 걸리지 않았고, 세지도 지우지도 않아 가장 오래된 것이
# 18시간 37분을 살았다. 회수 기록은 그동안 「브라우저 0개」였다.
#
# 이름 목록을 늘리는 것은 해결이 아니다 — 다음에 새 이름이 나오면 같은 자리에서
# 또 넘어진다. 그래서 이름 대신 **띄운 방식**으로 본다: 우리가 띄우는 캡처
# 브라우저는 예외 없이 ① `--headless` 이고 ② `--user-data-dir` 이 캡처용 임시
# 뿌리(C:\Temp · TMPDIR) 안이다. 사람이 쓰는 브라우저는 둘 다 아니다 —
# headless 로 띄우지 않고, 프로필을 임시 폴더에 두지 않는다. 그 둘이 함께일 때만
# 우리 것으로 보는 것이 「남의 브라우저는 절대 죽이지 않는다」의 근거다.
PROFILE_RE = re.compile(r'--user-data-dir=(?:"([^"]*)"|(\S+))')


def _norm_path(p):
    r"""윈도우 표기와 WSL 표기를 한 모양으로 — `C:\Temp\x` 와 `/mnt/c/Temp/x` 는
    같은 자리다. 비교 전용이라 소문자로 눕힌다."""
    q = (p or "").replace("\\", "/").lower().rstrip("/")
    m = re.match(r"^([a-z]):/(.*)$", q)
    if m:
        q = "/mnt/%s/%s" % (m.group(1), m.group(2))
    return q


def wsl_path(p):
    """윈도우 경로를 이 쪽에서 열 수 있는 경로로 (대소문자는 보존)."""
    q = (p or "").replace("\\", "/")
    m = re.match(r"^([A-Za-z]):/(.*)$", q)
    if m:
        return "/mnt/%s/%s" % (m.group(1).lower(), m.group(2))
    return q


def capture_temp_roots():
    """캡처 프로필이 놓이는 자리. 여기 **밖**의 프로필은 우리 것이 아니다."""
    out = []
    for r in (WIN_TEMP, os.environ.get("TMPDIR") or "/tmp", "/tmp"):
        n = _norm_path(r)
        if n and n not in out:
            out.append(n)
    return out


def profile_of(cmd):
    m = PROFILE_RE.search(cmd or "")
    return (m.group(1) or m.group(2) or "") if m else ""


def under_capture_temp(prof):
    n = _norm_path(prof)
    if not n:
        return False
    return any(n == r or n.startswith(r + "/") for r in capture_temp_roots())


def classify_browsers(rows):
    """브라우저 행 목록에서 **우리가 띄운 것**만 골라 표식을 붙인다.

    두 번 훑는다. 첫 번째로 `--headless` + 캡처용 임시 프로필을 가진 행을 찾아
    그 프로필을 「우리 프로필」로 등록하고, 두 번째로 같은 프로필을 쓰는 행을
    모두 우리 것으로 본다 — 렌더러·GPU 같은 자식 프로세스는 명령줄에
    `--headless` 를 달지 않지만 프로필은 같기 때문이다.

    표식(`s9shot-<pid>`·`cdp-prof-`)이 있는 행은 예전대로 그대로 잡는다.
    개체수를 세는 단위(marker)는 표식이 있으면 표식, 없으면 프로필 경로다 —
    어느 쪽이든 「캡처 한 건」에 하나씩 대응한다."""
    owned = set()
    for row in rows:
        cmd = row.get("cmd") or ""
        prof = profile_of(cmd)
        if "--headless" in cmd and under_capture_temp(prof):
            owned.add(_norm_path(prof))
    out = []
    for row in rows:
        cmd = row.get("cmd") or ""
        prof = profile_of(cmd)
        mk = MARKER_RE.search(cmd)
        if mk:
            marker = mk.group(1)
        elif _norm_path(prof) in owned:
            marker = _norm_path(prof)
        else:
            continue
        m = OWNER_RE.search(cmd)
        out.append({"pid": row.get("pid"), "cmd": cmd,
                    "age": row.get("age") or 0, "marker": marker,
                    "profile": prof,
                    "owner": int(m.group(1)) if m else None})
    return out


def scan_shot_browsers():
    """표식을 가진 브라우저 목록 — [{pid, cmd, age, owner}].

    리눅스 `ps` 로는 이걸 볼 수 없다. WSL에서 띄운 Windows 브라우저는 부모가
    사라지면 리눅스 쪽 흔적이 없어지고 윈도우에만 남는다 — 2026-08-25 에
    chrome.exe 165개가 상한(SHOT_MAX_HEADLESS) 계산에서 통째로 빠진 이유가
    그것이다. 그래서 개체수는 반드시 윈도우 쪽에서 센다."""
    ps = shutil.which("powershell.exe")
    if not ps:
        # 윈도우가 아닌 곳(macOS·네이티브 리눅스)에서도 같은 규칙이 필요하다.
        # 그쪽엔 포트를 대신 붙드는 중계가 없어 망이 끊기지는 않지만, 고아
        # 브라우저가 FD·메모리·CPU를 먹는 누수 자체는 똑같이 일어난다.
        rows = [{"pid": pid, "cmd": cmd, "age": age}
                for pid, _ppid, age, cmd in ps_rows()
                if "chrome" in cmd.lower() or "msedge" in cmd.lower()]
        return classify_browsers(rows)
    # 표식으로 미리 거르지 않는다 (REQ-20260907-036) — 걸러 버리면 표식 없는
    # 우리 브라우저가 애초에 보이지 않는다. 판정은 classify_browsers 한 곳에서만.
    script = (
        "$ErrorActionPreference='SilentlyContinue';"
        "@(Get-CimInstance Win32_Process -Filter \"Name='chrome.exe' or "
        "Name='msedge.exe'\" | ForEach-Object "
        "{ [pscustomobject]@{pid=$_.ProcessId;cmd=$_.CommandLine;"
        "age=[int]((Get-Date)-$_.CreationDate).TotalSeconds} }) "
        "| ConvertTo-Json -Compress")
    try:
        r = subprocess.run([ps, "-NoProfile", "-NonInteractive", "-Command",
                            script], capture_output=True,
                                encoding="utf-8", errors="replace", timeout=60)
        rows = json.loads(r.stdout.strip() or "[]")
    except Exception:
        return []
    if isinstance(rows, dict):        # 한 건이면 ConvertTo-Json 이 배열을 벗긴다
        rows = [rows]
    return classify_browsers(rows)


def owner_alive(pid):
    """캡처를 띄운 s9 프로세스가 아직 살아 있는가.

    나이가 아니라 **소유자 생존**이 고아의 정의다. 나이로 가르면 유예 시간
    동안 계속 쌓이고, 유예를 줄이면 진행 중인 캡처를 죽인다. 소유자를 보면
    둘 다 없다 — 죽는 순간 고아고, 살아 있는 동안은 절대 건드리지 않는다.

    판정이 애매할 때는 **살아 있는 쪽으로 기운다**(권한 오류 등). pid 재사용을
    구분하지 않는 것도 같은 이유다 — 최악이라야 고아 하나가 그 pid 의 수명만큼
    더 사는 것이고, 반대 실수는 진행 중인 캡처를 죽이는 것이다."""
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False


def reap_orphan_servers():
    """주인을 잃은 테스트 서버를 회수한다 — 브라우저와 같은 규칙, 같은 이유.

    스위트가 중간에 죽으면 그 서버는 init 에 재양육돼 영원히 남고, 고정 풀
    (18800~18863)의 칸을 하나씩 잠식한다. 실제로 6개가 그렇게 남아 다음
    스위트가 '포트 풀 소진'으로 5건 통째로 깨졌다."""
    _serves, orphans, _chromes = scan(ps_rows())
    n = 0
    for pid, _age, _cmd in orphans:
        try:
            os.kill(pid, signal.SIGTERM)
            n += 1
        except OSError:
            pass
    return n


def kill_win(pids):
    ps = shutil.which("powershell.exe")
    if not pids:
        return 0
    if not ps:
        n = 0
        for pid in pids:
            try:
                os.kill(pid, signal.SIGTERM)
                n += 1
            except OSError:
                pass
        return n
    ids = ",".join(str(p) for p in pids)
    try:
        subprocess.run([ps, "-NoProfile", "-NonInteractive", "-Command",
                        f"Stop-Process -Id {ids} -Force "
                        f"-ErrorAction SilentlyContinue"],
                       capture_output=True, timeout=60)
        return len(pids)
    except Exception:
        return 0


def sweep_stale_shots(max_age=SWEEP_AGE, browsers=None):
    """고아 캡처 브라우저·프로필을 회수한다 (REQ-20260826-002).

    회수 기준은 두 가지고, 순서가 중요하다:
      1. **소유자 사망** — 표식이 `s9shot-<pid>` 라 띄운 프로세스를 특정할 수
         있다. 그 프로세스가 없으면 이 브라우저는 아무도 거두지 않는다 =
         즉시 고아. 유예 없음.
      2. 소유자를 특정할 수 없는 표식(cdp-prof-)만 나이로 가른다 — 차선책이다.
    이 정의 덕분에 "쌓이는 시간"이 없다. 캡처가 끝나거나 세션이 죽는 순간
    고아가 되고, 다음 sweep(= 다음 캡처 직전 또는 5분 주기)에서 사라진다."""
    out = {"procs": 0, "orphans": 0, "stale": 0, "profiles": 0, "alive": 0}
    rows = scan_shot_browsers() if browsers is None else browsers
    orphan_pids, stale_pids, live_markers = [], [], set()
    dead_profiles = set()
    for b in rows:
        marker = b.get("marker") or f"pid:{b.get('pid')}"
        prof = b.get("profile") or profile_of(b.get("cmd"))
        if b["owner"] is not None:
            if owner_alive(b["owner"]):
                live_markers.add(marker)
            else:
                orphan_pids.append(b["pid"])
                dead_profiles.add(prof)
        elif b["age"] > max_age:
            stale_pids.append(b["pid"])
            dead_profiles.add(prof)
        else:
            live_markers.add(marker)
    out["orphans"] = kill_win(orphan_pids)
    out["stale"] = kill_win(stale_pids)
    out["procs"] = out["orphans"] + out["stale"]
    # 회수한 브라우저가 쓰던 프로필 디렉터리도 함께 지운다 (REQ-20260907-036).
    # 아래 이름 훑기는 표식으로 시작하는 이름만 보므로, 표식 없는 이름
    # (s9roster-… · s9projclick)의 프로필은 여기서만 지워진다 — 이름이 아니라
    # **방금 회수한 그 프로세스가 쓰던 경로**라서 오인이 없다. 캡처용 임시
    # 뿌리 밖은 손대지 않는다.
    for prof in dead_profiles:
        if not prof or not under_capture_temp(prof):
            continue
        path = wsl_path(prof)
        try:
            if os.path.isdir(path):
                shutil.rmtree(path, ignore_errors=True)
                out["profiles"] += 1
        except OSError:
            pass
    # 개체수는 프로세스가 아니라 캡처 건수다 — 캡처 하나가 렌더러·GPU 등
    # 프로세스 11개를 띄우므로(실측), 프로세스로 세면 상한 8은 첫 캡처에서
    # 이미 초과한다. 상한이 곧바로 무의미해지는 그 함정을 여기서 막는다.
    out["alive"] = len(live_markers)
    out["alive_procs"] = len(rows) - len(orphan_pids) - len(stale_pids)

    now = time.time()
    for base in (WIN_TEMP, os.environ.get("TMPDIR", "/tmp")):
        try:
            names = os.listdir(base)
        except OSError:
            continue
        for name in names:
            if not name.startswith(SHOT_MARKERS):
                continue
            path = os.path.join(base, name)
            m = OWNER_RE.search(name)
            try:
                if m:
                    if owner_alive(int(m.group(1))):
                        continue          # 진행 중인 캡처의 프로필
                elif now - os.path.getmtime(path) < max_age:
                    continue
                if os.path.isdir(path):
                    shutil.rmtree(path, ignore_errors=True)
                else:
                    os.remove(path)
                out["profiles"] += 1
            except OSError:
                pass
    return out


def scratch_bytes():
    """캡처·임시 산출물이 쌓인 크기 — 정리 대상 규모 파악용."""
    total = 0
    for base in (os.path.join(ROOT, "state", "shots"),):
        for dirpath, _d, files in os.walk(base):
            for fn in files:
                try:
                    total += os.path.getsize(os.path.join(dirpath, fn))
                except OSError:
                    pass
    return total


SHOT_KEEP_SEC = 3 * 86400      # 캡처 산출물 보관 기간 (사흘)


def prune_shot_files(max_age=SHOT_KEEP_SEC):
    """오래된 캡처 산출물 정리 — 프로세스만 회수하고 파일을 남기면 디스크가
    조용히 찬다(REQ-20260825-099: "임시파일로 만들거나 프로세스를 제대로 닫으라").

    검증 근거로 남겨야 하는 최근 캡처는 건드리지 않는다 — 사흘이 지난 것만."""
    freed, n = 0, 0
    base = os.path.join(ROOT, "state", "shots")
    now = time.time()
    for dirpath, _d, files in os.walk(base):
        for fn in files:
            p = os.path.join(dirpath, fn)
            try:
                st = os.stat(p)
                if now - st.st_mtime <= max_age:
                    continue
                os.remove(p)
                freed += st.st_size
                n += 1
            except OSError:
                pass
    return n, freed


def human(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024:
            return f"{n:.0f}{unit}"
        n /= 1024
    return f"{n:.0f}TB"


# ---------------------------------------------------------------------------
# 시스템 전반 점검 (REQ-20260829-004)
#
# 2026-08-29 재부팅 직후 대시보드가 안 열리고 새 서버가 안 떴다. 이미 떠 있던
# 것은 멀쩡했다 — DOC-20260826-008 이 '고갈의 지문'이라 못박은 그 비대칭이다.
# 그런데 원인은 포트가 아니라 부트였다: systemd-tmpfiles 가 sysinit 을 73초
# 붙잡아 그동안 아무것도 리슨하지 못했다(REQ-20260829-003). 그때 doctor 는
# '정상' 한 줄만 냈다 — 원인이 시야 밖이었다.
#
# 지문이 겹치는 원인이 여럿이면 진단은 그 전부를 봐야 한다. 그래서 포트 밖의
# 자리(부트·/tmp·디스크·서버 응답·훅·도구)를 함께 본다. 판정은 순수 함수로,
# 수집은 따로 둔다 — 등급이 실제 시스템 상태에 기대지 않아야 시험할 수 있다.

# ok < unknown < warn < critical. '모른다'는 경고보다 약하다 — 못 읽은 것을
# 이유로 사람을 깨우지는 않는다.
LEVEL_ORDER = {"ok": 0, "unknown": 1, "warn": 2, "critical": 3}
LEVEL_MARK = {"ok": "✓", "unknown": "?", "warn": "△", "critical": "✗"}

# 부트: WSL 은 사용자 세션을 10초만 기다린다. 그 창을 넘기면 세션이 없는 채로
# 뜨고, 30초를 넘으면 서버 기동을 기다리는 코드가 줄줄이 깨진다.
BOOT_WARN, BOOT_CRIT = 10.0, 30.0
# /tmp: 부트마다 통째로 지워지는 자리라 쌓인 만큼 그대로 기동 비용이 된다.
TMP_WARN, TMP_CRIT = 2000, 20000
TMP_DIR_GROWN = 1 << 20   # ext4 디렉터리는 한 번 커지면 줄지 않는다
TMP_OURS = ("s9gate-", "s9shot-", "cdp-prof-", "claude-")
TMP_STALE_AGE = 3600      # 테스트 실행이 한 시간을 넘지는 않는다
# 아이노드 (REQ-20260910-012). 러너의 두 줄과 같은 값이어야 한다
# (tests/tmproot.py 의 INODE_RUN_NEED·INODE_FLOOR) — 판정이 두 벌이면 한쪽이
# 괜찮다고 하는 자리에서 다른 쪽이 멈춘다. 근거는 그 파일에 적혀 있다.
TMP_INODE_WARN, TMP_INODE_CRIT = 50_000, 10_000
DISK_WARN, DISK_CRIT = 90.0, 95.0
SERVE_SLOW = 2.0
S9_HOOK_EVENTS = ("UserPromptSubmit", "SessionStart", "Stop", "SessionEnd",
                  "SubagentStop", "PostToolUse", "PreCompact", "PostCompact")
CHROME_CANDIDATES = (
    "/mnt/c/Program Files/Google/Chrome/Application/chrome.exe",
    "/mnt/c/Program Files (x86)/Google/Chrome/Application/chrome.exe",
)


def worst_level(levels):
    return max(levels, key=lambda x: LEVEL_ORDER.get(x, 0), default="ok")


def _v(key, label, level, line, advice=None):
    return {"key": key, "label": label, "level": level, "line": line,
            "advice": advice}


# --- 판정 (순수 함수) ---------------------------------------------------------

def boot_verdict(b):
    init = (b.get("init") or "").strip()
    if init != "systemd":
        return _v("boot", "부트", "ok",
                  f"부트: systemd 미사용({init or '알 수 없음'}) — 기동 지연 없음")
    sec = b.get("userspace_sec")
    tail = f" (userspace {sec:.1f}초)" if sec is not None else ""
    if b.get("user_session_failed"):
        return _v("boot", "부트", "critical",
                  f"부트: systemd 사용자 세션이 서지 못했다{tail} — "
                  f"/run/user 가 없어 systemctl --user 가 버스에 못 붙는다",
                  "부트가 WSL 의 사용자 세션 대기 창(10초)을 놓쳤다. "
                  "`systemd-analyze blame` 으로 sysinit 을 붙잡는 유닛을 찾아라. "
                  "고칠 생각이 없으면 /etc/wsl.conf 에서 systemd=false 로 끈다.")
    if sec is None:
        return _v("boot", "부트", "unknown", "부트: 기동 시간을 읽지 못했다")
    level = ("critical" if sec >= BOOT_CRIT
             else "warn" if sec >= BOOT_WARN else "ok")
    advice = None
    if level != "ok":
        advice = (f"부트가 {sec:.0f}초 걸린다 — 그동안 아무것도 리슨하지 못한다. "
                  f"재부팅 직후라면 대시보드가 안 열리고 새 서버만 안 뜨는, "
                  f"포트 고갈과 똑같은 모습이 된다. `systemd-analyze blame` 으로 "
                  f"sysinit 을 붙잡는 유닛을 찾아라.")
    return _v("boot", "부트", level, f"부트: userspace {sec:.1f}초", advice)


def tmp_verdict(t):
    n = int(t.get("entries") or 0)
    ours = int(t.get("ours") or 0)
    dir_bytes = int(t.get("dir_bytes") or 0)
    level = "critical" if n > TMP_CRIT else "warn" if n > TMP_WARN else "ok"
    line = f"/tmp: 최상위 {n}개"
    if ours:
        line += f" (우리 것 {ours}개)"
    advice = []
    # 아이노드는 개수와 따로 본다 (REQ-20260910-012) — 최상위가 여덟 개여도
    # 바닥날 수 있고, 바닥나면 테스트도 s9 명령도 임시 파일을 못 만들어 죽는다.
    ino_free, ino_total = t.get("inode_free"), t.get("inode_total")
    if ino_free is not None and ino_total:
        line += f" · 아이노드 {ino_free:,}/{ino_total:,} 남음"
        if ino_free < TMP_INODE_CRIT:
            level = "critical"
            advice.append(f"아이노드가 {ino_free:,}개뿐이다 — 이 자리를 쓰는 "
                          f"모든 것이 임시 파일을 못 만들고 죽는다. "
                          f"`s9 doctor --fix` 로 거두고, 그래도 모자라면 "
                          f"무엇이 수만 개를 품고 있는지 찾아라.")
        elif ino_free < TMP_INODE_WARN:
            level = worst_level([level, "warn"])
            advice.append(f"아이노드가 {ino_free:,}개 남았다 — 전체 테스트 한 "
                          f"번이 약 {TMP_INODE_WARN:,}개를 쓴다.")
    if dir_bytes > TMP_DIR_GROWN:
        line += f" · 디렉터리 {human(dir_bytes)} — 과거 누적의 흔적"
        advice.append("/tmp 디렉터리가 한때 수만 개를 담았다(ext4 디렉터리는 "
                      "줄지 않는다). 부트마다 이 자리를 통째로 지우므로 그만큼 "
                      "기동이 느려진다 — 임시 디렉터리를 만들고 안 지우는 쪽을 "
                      "찾아라.")
    if n > TMP_WARN:        # 개수 때문에 오른 등급일 때만 — 아이노드는 제 말을 한다
        advice.append(f"지금도 {n}개가 쌓여 있다.")
    return _v("tmp", "/tmp", level, line, " ".join(advice) or None)


def disk_verdict(rows):
    if not rows:
        return _v("disk", "디스크", "unknown", "디스크: 읽지 못했다")
    worst = max(rows, key=lambda r: r["used_pct"])
    p = worst["used_pct"]
    level = ("critical" if p >= DISK_CRIT
             else "warn" if p >= DISK_WARN else "ok")
    line = "디스크: " + " · ".join(
        f"{r['path']} {r['used_pct']:.0f}%" for r in rows)
    advice = None
    if level != "ok":
        advice = (f"{worst['path']} 가 {p:.0f}% 찼다 — s9 는 쓰기부터 실패한다. "
                  f"state/shots · state/snapshots 부터 비워라.")
    return _v("disk", "디스크", level, line, advice)


def serve_verdict(s):
    port = s.get("port")
    if not s.get("listening"):
        return _v("serve", "s9 serve", "warn",
                  f"s9 serve: 포트 {port} 에 리스너가 없다 — 서버가 안 떠 있다",
                  "`s9 serve` 로 띄워라. 일부러 내린 것이면 무시해도 된다.")
    if not s.get("responds"):
        return _v("serve", "s9 serve", "critical",
                  f"s9 serve: 포트 {port} 는 열려 있는데 응답이 없다",
                  "리슨만 하고 답하지 않는 서버가 가장 헷갈린다 — 포트 점검은 "
                  "통과하기 때문이다. `s9 serve stop` 후 다시 띄워라.")
    lat = s.get("latency")
    slow = lat is not None and lat >= SERVE_SLOW
    line = f"s9 serve: 포트 {port} 응답" + (f" ({lat:.2f}초)" if lat is not None
                                          else "")
    return _v("serve", "s9 serve", "warn" if slow else "ok", line,
              "응답이 느리다 — 스트림이 몰렸거나 디스크가 밀리는 중이다."
              if slow else None)


def hooks_verdict(h):
    missing = list(h.get("claude_missing") or [])
    parts, advice = [], []
    if missing:
        parts.append(f"claude 훅 {len(missing)}개 없음({', '.join(missing)})")
        advice.append("`s9-install` 로 훅을 다시 깔아라 — 훅이 빠지면 감사 "
                      "기록이 조용히 끊긴다.")
    if not h.get("git_hook"):
        parts.append("git pre-commit 없음")
        advice.append("커밋 검사(pre-commit 훅)가 없다 — `s9-install` 이 훅 자리를 git 에게 "
                      "물어 설치한다.")
    if not parts:
        return _v("hooks", "훅", "ok", "훅: claude 훅 · git pre-commit 모두 설치됨")
    return _v("hooks", "훅", "warn", "훅: " + " · ".join(parts),
              " ".join(advice))


def repo_verdict(r):
    """s9 는 자기 저장소 안에서 돈다 — 그 자리가 커밋을 받을 수 있어야 한다.

    2026-08-29 실제로 main 디렉토리의 core.bare 가 true 로 뒤집혀 status·add·
    commit 이 전부 'must be run in a work tree' 로 거부됐다. 파일은 멀쩡해서
    아무 증상 없이 커밋 시점에야 드러난다."""
    if r.get("is_bare"):
        return _v("repo", "저장소", "critical",
                  "저장소: core.bare=true 로 표시돼 있다 — 이 자리에서는 "
                  "status·add·commit 이 전부 거부된다",
                  "작업 트리가 실제로 있는데 bare 로 표시돼 있다. "
                  "`git config core.bare false` 로 되돌려라.")
    if not r.get("worktree_ok"):
        return _v("repo", "저장소", "critical",
                  "저장소: 작업 트리를 찾지 못했다",
                  "이 자리가 git 저장소가 맞는지 확인하라 — 커밋 검사(pre-commit 훅)도 "
                  "감사 기록도 여기에 기댄다.")
    # 미커밋 코드가 있으면 무인 작업자가 worktree 대신 본 저장소로 간다
    # (REQ-20260829-028-62x6). 되찾는 값이 커밋이라는 것을 여기서도 말한다 —
    # 강제가 아니라 유인이다. 고장이 아니므로 등급은 ok 그대로 둔다.
    dirty = list(r.get("code_dirty") or [])
    tail = ""
    if dirty:
        tail = (f" · 커밋하지 않은 코드 변경 {len(dirty)}건({', '.join(dirty[:3])}"
                + (" 외" if len(dirty) > 3 else "")
                + ") — 그동안 백그라운드 작업자는 worktree 대신 본 저장소에 앉는다")
    return _v("repo", "저장소", "ok",
              f"저장소: {r.get('branch') or '?'} · "
              f"worktree {r.get('worktrees') or 0}개" + tail,
              ("커밋하면 작업자가 다시 자기 worktree를 받는다."
               if dirty else None))


# 프로젝트 등록부 (REQ-20260908-025). 두 어긋남은 조용히 남는다 — 화면 어디에도
# 나타나지 않아 아무도 모른다. ① 두 설치의 vault 가 만나면 같은 slug 의 프로젝트
# 문서가 둘이 될 수 있다(git 충돌로 멈추지만, 사람이 잘못 풀면 남는다). ② 문서가
# `project: <slug>` 로 가리키는 프로젝트 문서가 아예 없을 수 있다. doctor 는 세어
# 보여 줄 뿐 고치지 않는다 — 어느 id 를 남기고 어느 이름이 맞는지는 사람의 판정이다.
# 이 도구는 s9 가 못 뜰 때도 써야 해서 s9 를 import 하지 않는다(위 CONCURRENCY 와
# 같은 규율) — vault 파일의 프론트매터를 직접 읽는다.
PROJECT_DOC_MAX = 20000     # 안전장치: 이보다 많으면 세다 만다(진단이 느려지지 않게)
PROJECT_EX = 3              # 줄에 붙이는 예시 개수


def _front(fp, keys):
    """문서 프론트매터에서 필요한 키만 읽는다 — 본문은 읽지 않는다."""
    out = {}
    try:
        with open(fp, encoding="utf-8", errors="replace") as f:
            if f.readline().strip() != "---":
                return out
            for line in f:
                if line.strip() == "---":
                    break
                m = re.match(r"^([A-Za-z_][A-Za-z0-9_]*):\s*(.*)$", line.rstrip("\n"))
                if m and m.group(1) in keys:
                    out[m.group(1)] = m.group(2).strip().strip('"\'')
    except OSError:
        return out
    return out


def project_info(root=None):
    """vault 의 프로젝트 등록부와 문서가 가리키는 slug 를 맞춰 본다."""
    base = root or ROOT
    vault = os.path.join(base, "vault")
    pdir = os.path.join(vault, "projects")
    empty = {"readable": False, "registered": {}, "duplicates": [],
             "unknown": [], "docs": 0}
    if not os.path.isdir(pdir):
        return empty
    try:
        names = sorted(os.listdir(pdir))
    except OSError:
        return empty
    registered = {}
    for fn in names:
        if not fn.endswith(".md"):
            continue
        meta = _front(os.path.join(pdir, fn), ("id", "slug"))
        # slug 프론트매터가 없으면 파일 이름이 곧 slug 다 (s9 의 project_path 와 같은 규칙).
        slug = meta.get("slug") or fn[:-3]
        registered.setdefault(slug, []).append(
            {"id": meta.get("id") or "?", "file": fn})

    counts, examples, docs = {}, {}, 0
    pabs = os.path.abspath(pdir)
    for dirpath, dirnames, filenames in os.walk(vault):
        dirnames[:] = [d for d in dirnames if d not in ("assets", "attachments")]
        if os.path.abspath(dirpath) == pabs:
            continue
        for fn in filenames:
            if not fn.endswith(".md"):
                continue
            docs += 1
            if docs > PROJECT_DOC_MAX:
                break
            meta = _front(os.path.join(dirpath, fn), ("id", "project"))
            slug = meta.get("project") or ""
            if not slug or slug in registered:
                continue
            counts[slug] = counts.get(slug, 0) + 1
            examples.setdefault(slug, []).append(meta.get("id") or fn[:-3])

    duplicates = [{"slug": s, "docs": v} for s, v in sorted(registered.items())
                  if len(v) > 1]
    unknown = [{"slug": s, "count": counts[s],
                "examples": examples[s][:PROJECT_EX]}
               for s in sorted(counts, key=lambda k: (-counts[k], k))]
    return {"readable": True, "registered": registered,
            "duplicates": duplicates, "unknown": unknown, "docs": docs}


def project_verdict(p):
    """어긋남이 없으면 조용하다(ok 는 advise 에 실리지 않는다)."""
    if not p.get("readable"):
        return _v("project", "프로젝트", "unknown",
                  "프로젝트: 등록부를 읽지 못했다 — vault/projects 가 없다",
                  "이 자리가 section9 저장소가 맞는지 확인하라.")
    lines, advice = [], []
    for d in p.get("duplicates") or []:
        # 안쪽 목록은 쉼표, 어긋남끼리는 " · " — 둘이 같은 글자면 어디까지가
        # 한 어긋남인지 읽는 사람이 가를 수 없다.
        who = ", ".join(f"{x['id']}({x['file']})" for x in d["docs"])
        lines.append(f"slug 하나에 프로젝트 문서가 {len(d['docs'])}개 — "
                     f"{d['slug']}: {who}")
        advice.append("두 설치의 vault 가 합류할 때 생긴다. 어느 id 를 남길지 "
                      "사람이 정해 나머지 문서를 지우고, 남긴 slug 로 문서의 "
                      "project 값을 맞춰라(이름을 바꿀 거면 `s9 project rename`).")
    unk = p.get("unknown") or []
    if unk:
        total = sum(u["count"] for u in unk)
        detail = ", ".join(
            f"{u['slug']} {u['count']}건({', '.join(u['examples'])}"
            + (" 외" if u["count"] > len(u["examples"]) else "") + ")"
            for u in unk[:PROJECT_EX])
        more = (f" 외 slug {len(unk) - PROJECT_EX}개"
                if len(unk) > PROJECT_EX else "")
        lines.append(f"등록되지 않은 slug 를 가리키는 문서 {total}건 — "
                     f"{detail}{more}")
        known = ", ".join(sorted(p.get("registered") or {})) or "없음"
        advice.append(f"쓰려던 이름이면 `s9 new project --slug <slug>` 로 등록하고, "
                      f"잘못 적힌 이름이면 그 문서의 project 값을 등록된 slug 로 "
                      f"고쳐라(등록된 slug: {known}).")
    if not lines:
        return _v("project", "프로젝트", "ok",
                  f"프로젝트: 등록 {len(p.get('registered') or {})}개 · 문서 "
                  f"{p.get('docs') or 0}건이 모두 등록된 slug 를 가리킨다")
    return _v("project", "프로젝트",
              "critical" if p.get("duplicates") else "warn",
              "프로젝트: " + " · ".join(lines), " ".join(advice))


PY_FLOOR = (3, 10)     # pyproject.toml requires-python — 여기와 그 파일이 같은 값이어야 한다


def deps_verdict(x):
    req = list(x.get("missing_required") or [])
    opt = list(x.get("missing_optional") or [])
    if req:
        return _v("deps", "도구", "critical",
                  f"도구: 필수 없음 — {', '.join(req)}",
                  "이게 없으면 s9 자체가 돌지 않는다.")
    py = tuple(x.get("python") or ())
    if py and py[:2] < PY_FLOOR:
        # 맥의 기본 python3 는 3.9 (CommandLineTools) 다 — 하한을 말해 주는 자리가 없어
        # 시험 22파일이 원인 모를 TypeError(staticmethod 호출, 3.10+) 로 깨졌다
        # (REQ-20260906-017-2n7g, 맥미니 실측 2026-09-06). 막지는 않는다 — 하네스의
        # 대부분은 3.9 에서도 돌므로 거부는 진단이 아니라 고장이다.
        cur = ".".join(str(n) for n in py[:3])
        floor = ".".join(str(n) for n in PY_FLOOR)
        return _v("deps", "도구", "warn",
                  f"파이썬: {cur} < {floor} (pyproject requires-python)",
                  f"시험 일부와 3.{PY_FLOOR[1]}+ 문법에 기댄 기능이 깨진다. {floor} 이상을 "
                  "설치해 `python3` 가 그것을 가리키게 하라 "
                  "(맥: brew install python@3.12 · 우분투: apt install python3.12).")
    if opt:
        return _v("deps", "도구", "warn",
                  f"도구: 없어도 되는 것이 빠졌다 — {', '.join(opt)}",
                  "그 기능만 안 된다. 캡처 줄이기는 있으면 쓰고 없으면 원본을 "
                  "그대로 둔다 — 넣으려면 `apt install pngquant`(맥은 "
                  "`brew install pngquant`, 윈도우는 pngquant.org 의 실행 파일 "
                  "하나). 넣는 순간부터 새로 찍는 캡처가 저절로 작아진다.")
    return _v("deps", "도구", "ok", "도구: 필요한 것이 모두 있다")


# --- 수집 -------------------------------------------------------------------

def git_hooks_dir(cwd):
    """훅 자리는 경로를 짓지 말고 git 에게 묻는다.

    worktree의 .git 은 디렉토리가 아니라 파일이라 <repo>/.git/hooks 를 지어내면
    없는 자리를 가리킨다 — 그러면 '설치 안 됨'을 '저장소 아님'으로 오판한다
    (REQ-20260829-001 이 검사 시험 쪽에서 만난 그 함정)."""
    try:
        r = subprocess.run(["git", "rev-parse", "--git-path", "hooks"],
                           cwd=cwd, capture_output=True,
                               encoding="utf-8", errors="replace", timeout=10)
    except Exception:
        return ""
    if r.returncode != 0 or not r.stdout.strip():
        return ""
    p = r.stdout.strip()
    return p if os.path.isabs(p) else os.path.abspath(os.path.join(cwd, p))


def boot_info():
    init = ""
    try:
        with open("/proc/1/comm", encoding="utf-8") as f:
            init = f.read().strip()
    except OSError:
        pass
    out = {"init": init, "userspace_sec": None, "user_session_failed": False}
    if init != "systemd":
        return out
    try:
        r = subprocess.run(["systemctl", "show",
                            "-p", "UserspaceTimestampMonotonic",
                            "-p", "FinishTimestampMonotonic"],
                           capture_output=True,
                               encoding="utf-8", errors="replace", timeout=10)
        vals = dict(l.split("=", 1) for l in r.stdout.splitlines() if "=" in l)
        u = int(vals.get("UserspaceTimestampMonotonic") or 0)
        fin = int(vals.get("FinishTimestampMonotonic") or 0)
        if fin > u:
            out["userspace_sec"] = (fin - u) / 1e6
    except Exception:
        pass
    # 세션이 실제로 섰는지는 XDG 런타임 자리로 본다 — WSL 이 10초 안에 세션을
    # 못 받으면 이 디렉토리가 아예 생기지 않는다.
    out["user_session_failed"] = not os.path.isdir(f"/run/user/{os.getuid()}")
    return out


def tmp_inodes(path="/tmp"):
    """(남은 아이노드, 전체) — 세지 않는 파일시스템이면 (None, None).

    최상위 개수만으로는 못 보는 자리다 (REQ-20260910-012): 2026-09-10 에는
    최상위가 여덟 개였는데 그중 하나가 32,746개를 품고 있었고, 아이노드는
    바닥이었다. 개수가 아니라 남은 아이노드를 봐야 「곧 아무것도 못 돈다」가
    보인다.
    """
    try:
        st = os.statvfs(path)
    except OSError:
        return (None, None)
    total = getattr(st, "f_files", 0) or 0
    if total <= 0:
        return (None, None)
    return (int(getattr(st, "f_favail", 0) or 0), int(total))


def tmp_info(path="/tmp"):
    ino_free, ino_total = tmp_inodes(path)
    try:
        names = os.listdir(path)
        dir_bytes = os.stat(path).st_size
    except OSError:
        return {"entries": 0, "dir_bytes": 0, "ours": 0,
                "inode_free": ino_free, "inode_total": ino_total}
    return {"entries": len(names), "dir_bytes": dir_bytes,
            "ours": sum(1 for n in names if n.startswith(TMP_OURS)),
            "inode_free": ino_free, "inode_total": ino_total}


def disk_info():
    rows, seen = [], set()
    for path in ("/", ROOT):
        try:
            st = os.statvfs(path)
        except OSError:
            continue
        key = (st.f_blocks, st.f_fsid)
        if key in seen:
            continue
        seen.add(key)
        total = st.f_blocks * st.f_frsize
        free = st.f_bavail * st.f_frsize
        if not total:
            continue
        rows.append({"path": path, "used_pct": 100.0 * (total - free) / total})
    return rows


def _dash_port():
    """이 저장소의 대시보드 포트 — bin/s9 s9_port 와 같은 서열:
    S9_PORT > state/port > 9909."""
    if os.environ.get("S9_PORT"):
        try:
            return int(os.environ["S9_PORT"])
        except ValueError:
            pass
    try:
        with open(os.path.join(ROOT, "state", "port"), encoding="utf-8") as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return 9909


def serve_info():
    # 지문(serve-code.json)의 포트는 **그 pid 가 살아 있을 때만** 믿는다
    # (REQ-20260830-005). 실사고 2026-08-30 아침: 시험이 남긴 죽은 임시 포트
    # 지문을 그대로 믿고 두드리며 "서버가 안 떠 있다"고 했다 — 실제 대시보드는
    # 9909 에서 멀쩡히 돌고 있었다 (REQ-20260830-004). 죽었으면 규범 포트로.
    port = _dash_port()
    try:
        with open(os.path.join(ROOT, "state", "serve-code.json"), encoding="utf-8") as f:
            d = json.load(f) or {}
        pid = int(d.get("pid") or 0)
        if pid > 0:
            os.kill(pid, 0)          # 죽었으면 OSError → 지문 불신
            port = int(d.get("port") or port)
    except Exception:
        pass
    out = {"port": port, "listening": False, "responds": False,
           "latency": None}
    try:
        with socket.socket() as s:
            s.settimeout(1.0)
            out["listening"] = s.connect_ex(("127.0.0.1", port)) == 0
    except OSError:
        return out
    if not out["listening"]:
        return out
    import urllib.error
    import urllib.request
    t0 = time.time()
    try:
        with urllib.request.urlopen(
                f"http://127.0.0.1:{port}/api/serveinfo", timeout=8) as r:
            r.read(256)
            out["responds"] = True
    except urllib.error.HTTPError:
        out["responds"] = True   # 답은 했다 — 살아 있다는 뜻이다
    except Exception:
        out["responds"] = False
    out["latency"] = round(time.time() - t0, 2)
    return out


# 하네스별 로그인 흔적 (REQ-20260905-014). section9 은 Claude 기본이되 어느 하네스든
# 붙어 쓰는 것이 목표라(PROTOCOL 0'), 판을 가르는 자리는 이 표 하나다 — 실행 파일과
# 로그인 흔적 파일·안내. bin/s9-install 이 같은 표를 들고 설치 끝에 안내한다
# (두 벌이 갈리는지는 tests/test_login_check.py 가 본다).
LOGIN_MARKS = {
    "claude": {"exe": "claude", "mark": ".credentials.json", "home_env": "CLAUDE_CONFIG_DIR",
               "home": "~/.claude", "how": "터미널에서 `claude` 를 한 번 띄워 /login 으로 로그인",
               # native 설치기가 놓는 자리 — PATH 에 아직 안 보여도 여기서 찾는다 (agent_cli_path)
               "dirs": ["~/.local/bin"]},
    "codex": {"exe": "codex", "mark": "auth.json", "home_env": "CODEX_HOME",
              "home": "~/.codex", "how": "`codex login`"},
    "gemini": {"exe": "gemini", "mark": "oauth_creds.json", "home_env": "",
               "home": "~/.gemini", "how": "터미널에서 `gemini` 를 한 번 띄워 로그인"},
}


def agent_cli_path(exe, dirs=(), which=None):
    """에이전트 CLI 실행 파일의 자리 → (경로 또는 None, PATH 에 있었는가).

    PATH 에 없으면 표(LOGIN_MARKS)의 `dirs` — native 설치기가 놓는 `~/.local/bin` — 를 본다.
    Windows 실측 2026-09-13 (REQ-20260913-024): 공식 설치기는 `%USERPROFILE%\\.local\\bin\\claude.exe`
    에 놓고 사용자 PATH 에 그 폴더를 더하지만 그 PATH 는 **새 프로세스부터** 보인다 — 설치한
    그 터미널과 WSL 이 띄운 cmd.exe 는 옛 PATH 라 `shutil.which("claude")` 가 None 이었고, 설치
    안내는 「에이전트 CLI 가 없다」, `s9 code` 는 「claude 명령을 찾을 수 없다」로 끝났다.
    리눅스·맥의 native 설치기도 같은 폴더에 놓으므로 판을 묻지 않고 두 이름(맨 이름·`.exe`)을 본다.
    세 벌(s9·s9-install·s9-doctor)은 같은 코드다 — tests/test_login_check.py L10 이 대조한다.
    """
    found = (which or shutil.which)(exe)
    if found:
        return found, True
    for d in dirs or ():
        base = os.path.normpath(os.path.join(os.path.expanduser(d), exe))
        for cand in (base, base + ".exe"):
            if os.path.isfile(cand):
                return cand, False
    return None, False


def login_second_signal(name, home, platform=None, run=None):
    """파일 표식이 없을 때의 둘째 신호 (REQ-20260906-070). 맥의 Claude Code 는 자격증명을
    파일(.credentials.json)이 아니라 Keychain 에 둔다 — 파일만 보면 로그인 뒤에도 「없다」로
    읽혀 첫 `s9 code` 가 로그인 화면에서 맴돌았다(맥미니 실제 발생 2026-09-06 13:32).
    둘: ① 설정 디렉토리의 `.claude.json` 에 oauthAccount 가 있다(모든 판) ② 맥이면
    Keychain 에 「Claude Code-credentials」 항목이 있다. 값은 읽지 않는다 — 있는지만 본다."""
    if name != "claude":
        return False
    cfg = os.path.expanduser(home)
    default_home = (os.path.realpath(cfg)
                    == os.path.realpath(os.path.expanduser("~/.claude")))
    cands = [os.path.join(cfg, ".claude.json")]
    if default_home:
        cands.append(os.path.expanduser("~/.claude.json"))     # 기본 자리만 바깥에 있다
    for p in cands:
        try:
            with open(p, encoding="utf-8") as f:
                if '"oauthAccount"' in f.read():
                    return True
        except OSError:
            pass
    # Keychain 항목은 계정(사용자)의 것이지 설정 디렉토리의 것이 아니다 — 다른
    # 설정 디렉토리(프로필·시험의 임시 자리)에 「로그인됨」을 물려주면 그 자리는
    # 자격증명이 없는데도 검사가 통과시킨다 (REQ-20260906-015, test_login_check l4).
    if default_home and (platform or sys.platform) == "darwin":
        try:
            r = (run or subprocess.run)(["security", "find-generic-password", "-s",
                                         "Claude Code-credentials"],
                                        capture_output=True, timeout=10)
            return r.returncode == 0
        except Exception:
            return False
    return False


def login_info(marks=None, which=None, second=None):
    """설치된 하네스마다 (실행 파일 있음, 로그인 흔적 있음)."""
    marks = marks or LOGIN_MARKS
    which = which or shutil.which
    out = {}
    for name, m in marks.items():
        path, on_path = agent_cli_path(m["exe"], m.get("dirs") or (), which)
        exe = bool(path)
        home = (os.environ.get(m["home_env"]) if m.get("home_env") else "") or m["home"]
        mark = os.path.exists(os.path.join(os.path.expanduser(home), m["mark"]))
        logged = exe and (mark or (second or login_second_signal)(name, home))
        out[name] = {"installed": exe, "logged_in": logged, "how": m["how"], "path": path,
                     "on_path": on_path,
                     "hint": ("" if (on_path or not path) else
                              f"{name} 는 PATH 밖에 있다({path}) — 새 터미널을 열거나 PATH 에 그 폴더를 더하라")}
    return out


def login_verdict(li):
    """설치된 하네스가 하나도 로그인돼 있지 않으면 warn — 설치가 끝났는데 첫 세션이
    로그인 화면에서 막히는 것이 실사고(새 머신 설치, 2026-09-05)다."""
    installed = [k for k, v in li.items() if v["installed"]]
    logged = [k for k in installed if li[k]["logged_in"]]
    if not installed:
        return _v("login", "에이전트 로그인", "warn", "설치된 에이전트 CLI 없음(claude·codex·gemini)",
                  "하나를 설치하고 로그인하라 — 기본은 Claude Code.")
    if not logged:
        k = installed[0]
        return _v("login", "에이전트 로그인", "warn", f"{', '.join(installed)} 설치됨 · 로그인 없음",
                  f"{li[k]['how']} — 로그인 없이는 `s9 code` 가 첫 화면에서 막힌다."
                  + (f" {li[k]['hint']}." if li[k].get("hint") else ""))
    hints = [li[k]["hint"] for k in logged if li[k].get("hint")]
    return _v("login", "에이전트 로그인", "ok", " · ".join(f"{k} 로그인" for k in logged),
              " · ".join(hints) or None)


def claude_home():
    """Claude Code 설정 디렉토리 — `CLAUDE_CONFIG_DIR` 이 있으면 그것, 없으면 `~/.claude`.

    bin/s9-install 의 같은 이름 함수와 뜻이 같아야 한다: 설치가 쓰는 자리와 검사가
    보는 자리가 다르면 계정 프로필로 뜬 세션의 doctor 가 훅을 「없다」고 한다 — 맥
    tar.gz 실측에서 CLAUDE_CONFIG_DIR 로 깐 자리가 「훅 8개 없음」으로 읽혔다
    (REQ-20260913-002-2n7g, 2026-09-13).
    """
    return (os.environ.get("CLAUDE_CONFIG_DIR") or "").strip() \
        or os.path.expanduser("~/.claude")


def hooks_info():
    missing = []
    try:
        with open(os.path.join(claude_home(), "settings.json"), encoding="utf-8") as f:
            hooks = (json.load(f) or {}).get("hooks") or {}
    except Exception:
        hooks = {}
    for ev in S9_HOOK_EVENTS:
        blob = json.dumps(hooks.get(ev) or [], ensure_ascii=False)
        if "s9-audit" not in blob:
            missing.append(ev)
    hd = git_hooks_dir(ROOT)
    return {"claude_missing": missing, "hooks_dir": hd,
            "git_hook": bool(hd) and os.path.exists(
                os.path.join(hd, "pre-commit"))}


TMP_RUN_RE = re.compile(r"^s9run-(\d+)-")
# 우리 접두어지만 실행 사이에 공유하는 자리 — 테스트 포트 락. 지우면 두 실행이
# 같은 포트를 제 것이라 믿는다 (tests/tmproot.py 의 KEEP 과 같은 목록이어야 한다).
TMP_KEEP = ("s9-portpool",)


def sweep_stale_tmp(base="/tmp", now=None, age=TMP_STALE_AGE):
    """테스트가 /tmp 에 흘린 임시 자리를 거둔다 (REQ-20260829-003).

    러너(tests/__main__.py)가 실행 전용 루트로 막았지만, 옛 체크아웃과
    worktree의 러너 사본은 그대로 흘린다. 이 회수는 캡처 회수와 같은 틱에서
    돌아 시간축에서도 닫는다.

    규칙은 캡처 회수와 같다 — **우리 표식이 있는 것만**. 이름이 s9 로 시작하지
    않는 것(claude-*, snap-private-tmp, systemd-private-*, .X11-unix)은
    아무리 오래돼도 건드리지 않는다. 살아 있는 실행 루트(s9run-<pid>-)도
    남긴다: 지금 도는 다른 러너의 자리를 지우면 그 실행이 깨진다.

    반대로 **주인이 없는 실행 루트는 나이를 묻지 않고 거둔다** — 러너와 같은
    규칙이다(tests/tmproot.py, REQ-20260910-012). pid 가 없으면 그 실행은 이미
    끝났다는 확정이라 한 시간을 기다릴 이유가 없고, 기다리는 그 한 시간이
    2026-09-10 에 /tmp 의 아이노드를 바닥낸 자리였다.
    """
    now = time.time() if now is None else now
    gone, freed = 0, 0
    try:
        names = os.listdir(base)
    except OSError:
        return {"dirs": 0, "bytes": 0}
    for name in names:
        if not name.startswith("s9") or name in TMP_KEEP:
            continue
        m = TMP_RUN_RE.match(name)
        dead_run = False
        if m:
            if owner_alive(int(m.group(1))):
                continue
            dead_run = True         # 주인이 없다 — 나이를 묻지 않는다
        path = os.path.join(base, name)
        try:
            if not dead_run and now - os.path.getmtime(path) < age:
                continue
            size = 0
            if os.path.isdir(path) and not os.path.islink(path):
                for dirpath, _d, files in os.walk(path):
                    for f in files:
                        try:
                            size += os.path.getsize(os.path.join(dirpath, f))
                        except OSError:
                            pass
                shutil.rmtree(path, ignore_errors=True)
            else:
                size = os.path.getsize(path)
                os.remove(path)
        except OSError:
            continue
        gone += 1
        freed += size
    return {"dirs": gone, "bytes": freed}


def repo_info():
    def g(*args):
        try:
            r = subprocess.run(["git", *args], cwd=ROOT, capture_output=True,
                               encoding="utf-8", errors="replace", timeout=10)
        except Exception:
            return None
        return r.stdout.strip() if r.returncode == 0 else None
    wl = g("worktree", "list") or ""
    # 데이터 자리(state/·vault/·users/·index/·streams/)는 세지 않는다 — 워커가
    # S9_ROOT 로 본 저장소를 함께 쓰므로 worktree 기준선과 무관하다.
    shared = ("state/", "vault/", "users/", "index/", "streams/")
    # `g()` 는 stdout 을 strip 하므로 첫 줄의 앞 공백이 사라진다 — porcelain 은
    # 상태 두 글자가 자리로 의미를 갖는 형식이라 그대로 자르면 ` M bin/s9` 가
    # `in/s9` 가 된다. 여기서는 안 깎은 원문을 쓴다.
    code = []
    try:
        raw = subprocess.run(["git", "status", "--porcelain"], cwd=ROOT,
                             capture_output=True,
                                 encoding="utf-8", errors="replace",
                             timeout=20).stdout
    except Exception:
        raw = ""
    for line in raw.splitlines():
        f = line[3:].strip().strip('"') if len(line) > 3 else ""
        if " -> " in f:
            f = f.split(" -> ", 1)[1]
        if f and not f.startswith(shared):
            code.append(f)
    return {"is_bare": g("rev-parse", "--is-bare-repository") == "true",
            "worktree_ok": g("rev-parse", "--is-inside-work-tree") == "true",
            "branch": g("rev-parse", "--abbrev-ref", "HEAD") or "",
            "code_dirty": code,
            "worktrees": len([l for l in wl.splitlines() if l.strip()])}


def deps_info():
    missing_req = [b for b in ("python3", "git") if not shutil.which(b)]
    missing_opt = []
    if not (any(os.path.exists(p) for p in CHROME_CANDIDATES)
            or any(shutil.which(b) for b in
                   ("google-chrome", "chromium", "chromium-browser"))):
        missing_opt.append("chrome(캡처)")
    if not shutil.which("powershell.exe"):
        missing_opt.append("powershell.exe(윈도우 포트 조회)")
    # 캡처를 줄이는 도구 (REQ-20260908-055). 없어도 하네스는 돈다 — 그래서
    # 「선택」이고, 설치하지는 않고 절차만 찍는다. 도구 이름과 안내의 원천은
    # bin/s9.py 의 SHOT_SHRINK_TOOLS 한 곳이다. doctor 는 s9 를 import 하지
    # 않으므로(이 도구는 s9 가 못 뜰 때도 써야 한다) 이름만 여기서 다시 본다 —
    # 두 곳이 갈리면 시험(test_shot_shrink)이 잡는다.
    shrink = [n for n in ("pngquant", "oxipng") if shutil.which(n)]
    if not shrink:
        missing_opt.append("pngquant 또는 oxipng(캡처 줄이기)")
    return {"missing_required": missing_req, "missing_optional": missing_opt,
            "shrink": shrink,
            "python": tuple(sys.version_info[:3])}


# 역할 진실은 GitHub 권한이고 profile 의 role 은 캐시다 (REQ-20260902-034).
# 로컬 인가(S9_USER)는 자기신고라 인증이 아니다 — 최종 검사는 리포 권한이다.
# 둘이 어긋나면(profile 은 admin 인데 리포는 write) 사람이 알아야 한다.
GH_ROLE_MAP = {"admin": "admin", "maintain": "member", "write": "member",
               "triage": "viewer", "read": "viewer", "none": ""}


def _origin_slug():
    """origin 의 owner/repo — https·ssh 둘 다. GitHub 이 아니면 ""."""
    try:
        url = subprocess.run(["git", "remote", "get-url", "origin"], cwd=ROOT,
                             capture_output=True, encoding="utf-8", errors="replace", timeout=10).stdout.strip()
    except Exception:
        return ""
    m = re.search(r"github\.com[:/]([^/]+)/([^/]+?)(?:\.git)?/?$", url)
    return f"{m.group(1)}/{m.group(2)}" if m else ""


def _gh_json(path):
    """gh api 한 번 — 없거나 실패하면 None (확인 불가는 실패가 아니다)."""
    if not shutil.which("gh"):
        return None
    try:
        r = subprocess.run(["gh", "api", path], capture_output=True,
                           encoding="utf-8", errors="replace",
                           timeout=20)
    except Exception:
        return None
    if r.returncode != 0:
        return None
    try:
        return json.loads(r.stdout)
    except ValueError:
        return None


def _profiles():
    """users/<u>/profile.md 의 role·github — 독립 실행 도구라 손으로 읽는다."""
    out = {}
    base = os.path.join(ROOT, "users")
    try:
        names = sorted(os.listdir(base))
    except OSError:
        return out
    for u in names:
        p = os.path.join(base, u, "profile.md")
        try:
            with open(p, encoding="utf-8") as f:
                head = f.read().split("\n---\n", 1)[0]
        except OSError:
            continue
        role, gh = "member", ""
        for line in head.splitlines():
            if line.startswith("role:"):
                role = line.split(":", 1)[1].strip() or "member"
            elif line.startswith("github:"):
                gh = line.split(":", 1)[1].strip().strip('"').lstrip("@")
        out[u] = {"role": role, "github": gh}
    return out


def authz_info(slug=None, profiles=None, gh=None):
    """profile role ↔ GitHub 권한 대조 + public 리포의 데이터 노출."""
    slug = _origin_slug() if slug is None else slug
    profiles = _profiles() if profiles is None else profiles
    gh = _gh_json if gh is None else gh
    info = {"slug": slug, "checked": [], "mismatch": [], "skipped": [],
            "unavailable": False, "public": None, "vault_tracked": None}
    if not slug:
        info["unavailable"] = True
        return info
    repo = gh(f"repos/{slug}")
    if repo is None:
        info["unavailable"] = True
        return info
    info["public"] = not bool(repo.get("private"))
    try:
        ls = subprocess.run(["git", "ls-files", "vault"], cwd=ROOT,
                            capture_output=True, encoding="utf-8", errors="replace", timeout=10).stdout
        info["vault_tracked"] = bool(ls.strip())
    except Exception:
        info["vault_tracked"] = None
    for u, pr in profiles.items():
        if not pr.get("github"):
            info["skipped"].append(u)
            continue
        perm = gh(f"repos/{slug}/collaborators/{pr['github']}/permission")
        if not perm:
            info["skipped"].append(u)
            continue
        ghrole = GH_ROLE_MAP.get(str(perm.get("permission") or "none"), "")
        row = {"user": u, "profile": pr["role"], "github": perm.get("permission"),
               "expect": ghrole}
        info["checked"].append(row)
        if ghrole != pr["role"]:
            info["mismatch"].append(row)
    return info


def authz_verdict(a):
    if a.get("unavailable"):
        return _v("authz", "권한", "ok",
                  "권한: GitHub 권한을 확인할 수 없다(원격이 GitHub 이 아니거나 gh 없음)",
                  None)
    bits, level, advice = [], "ok", None
    if a.get("mismatch"):
        level = "warn"
        bits.append("역할 불일치 " + ", ".join(
            f"{m['user']}(profile {m['profile']} ≠ GitHub {m['github']})"
            for m in a["mismatch"][:3]))
        advice = ("역할의 진실은 GitHub 권한이다 — profile 의 role 을 거기에 맞추거나"
                  "(`s9 user role <이름> <역할>`, admin 만) 리포 권한을 고쳐라.")
    if a.get("public") and a.get("vault_tracked"):
        level = "warn"
        bits.append("public 리포에 vault/ 가 track 된다 — 요청·지식 문서가 공개돼 있다")
        advice = (advice or "") + (" 데이터는 사설 인스턴스 리포로 분리하라"
                                   "(`s9 instance init`, docs/08).")
    n = len(a.get("checked") or [])
    head = f"권한: 대조 {n}명" + (f" · 건너뜀 {len(a['skipped'])}" if a.get("skipped") else "")
    return _v("authz", "권한", level, head + (" · " + " · ".join(bits) if bits else ""),
              advice or None)


# 동기화 모드 (REQ-20260908-050). 실제 사고 2026-09-08: 인스턴스를 만들고 다른
# 머신에서 클론했는데 요청 문서가 GitHub 으로 나가지 않았다. 마커가 `local` 이었고
# 그 마커는 track 되므로 클론에도 그대로 실려 갔다. **아무 화면에도 나타나지 않는
# 어긋남**이라 사람이 알 길이 없었다 — 문서는 만들어지고 로컬 커밋도 되니까.
def sync_info():
    path = os.path.join(ROOT, ".s9-sync")
    try:
        with open(path, encoding="utf-8") as f:
            body = f.read()
    except OSError:
        return {"instance": False}
    head = (body.strip().split() or [""])[0].lower()
    try:
        r = subprocess.run(["git", "remote", "get-url", "origin"], cwd=ROOT,
                           capture_output=True, encoding="utf-8",
                           errors="replace", timeout=10)
        origin = r.stdout.strip() if r.returncode == 0 else ""
    except Exception:
        origin = ""
    # 되돌리지 못한 보관함 (REQ-20260908-051). 동기화의 rebase 가 남의 커밋하지
    # 않은 작업을 걷어 갔는데 되돌리지 못했으면 그 sha 가 여기 남는다 — 조용한
    # 유실이 그 사고의 본체였으므로 doctor 가 소리를 낸다.
    orphan = []
    try:
        with open(os.path.join(ROOT, "state", "sync-stash-orphan.txt"),
                  encoding="utf-8") as f:
            orphan = [l.strip() for l in f if l.strip()]
    except OSError:
        pass
    # 보관함에 이미 쌓인 autostash (REQ-20260914-005-62x6). 위의 orphan 파일은
    # 되돌리기 검사가 선 뒤의 실패만 받는다 — 그 전에 쌓인 것은 어느 화면에도
    # 안 떴다(2026-09-14 기준 다섯, 09-06~09-14). git 은 되돌리기에 실패한
    # autostash 를 보관함에 넣고 rebase 를 returncode 0 으로 끝내므로, 커밋하지
    # 않은 작업이 그 안에 있는데 아무도 모른다. 그래서 보관함을 직접 센다.
    stuck = 0
    try:
        r = subprocess.run(["git", "stash", "list"], cwd=ROOT,
                           capture_output=True, encoding="utf-8",
                           errors="replace", timeout=10)
        if r.returncode == 0:
            stuck = sum(1 for l in r.stdout.splitlines()
                        if l.strip().endswith("autostash"))
    except Exception:
        pass
    return {"instance": True,
            "mode": "local" if head == "local" else "remote",
            "chosen": "아직 고르지 않음" not in body,
            "orphan": orphan,
            "autostash": stuck,
            "origin": origin}


def sync_verdict(s):
    orphan = s.get("orphan") or []
    stuck = s.get("autostash") or 0
    if orphan:
        last = orphan[-1].split()[-1]
        # orphan 파일은 검사가 선 뒤의 실패만 받는다 — 그 전에 쌓인 것까지 세어
        # 함께 적는다 (REQ-20260914-005-62x6). 이 줄 하나만 보고 「1건」으로 읽고
        # 넘어가면 나머지는 또 안 보인다.
        more = (f" · 보관함에는 autostash 가 {stuck}건 있다"
                if stuck > len(orphan) else "")
        return _v("sync", "동기화", "critical",
                  f"동기화: 되돌리지 못한 보관함 {len(orphan)}건 — 커밋하지 않은 "
                  f"작업이 그 안에 갇혀 있다 (마지막 {last[:8]}){more}",
                  f"`git stash apply {last}` 로 작업 트리에 되돌린 뒤, 되돌렸으면 "
                  "state/sync-stash-orphan.txt 를 지워라."
                  + (" 나머지는 `git stash list` 로 보고 하나씩 되돌려라."
                     if more else ""))
    if not s.get("instance"):
        # 코드 저장소를 그냥 클론한 자리 — 어떤 git 쓰기도 하지 않는다(설계 그대로)
        return _v("sync", "동기화", "ok", "동기화: 인스턴스가 아니다 — git 쓰기 없음")
    mode, origin = s["mode"], s.get("origin") or ""
    if mode == "remote" and not origin:
        return _v("sync", "동기화", "warn",
                  "동기화: remote 인데 origin 이 없다 — 로컬 commit 만 남는다",
                  "`git remote add origin <주소>` 로 내보낼 곳을 정하라.")
    if mode == "local" and origin:
        lvl = "warn" if s.get("chosen") else "critical"
        why = ("사람이 고른 값이다" if s.get("chosen")
               else "아무도 고른 적이 없다 — 설치가 기본으로 둔 값이다")
        return _v("sync", "동기화", lvl,
                  f"동기화: local 인데 origin 이 있다 — 문서가 밖으로 나가지 않는다 ({why})",
                  "`s9 sync --on` 으로 켜라. 이 마커는 track 되므로 한 번 켜면 "
                  "다른 머신의 클론에도 따라간다.")
    if stuck:
        n = stuck
        return _v("sync", "동기화", "warn",
                  f"동기화: 보관함에 남은 autostash {n}건 — 되돌아가지 못한 "
                  f"커밋하지 않은 작업이 그 안에 있다",
                  "`git stash list` 로 보고 `git stash apply stash@{0}` 로 "
                  "작업 트리에 되돌려라. 필요 없는 것이면 `git stash drop`.")
    return _v("sync", "동기화", "ok",
              f"동기화: {mode}" + (f" · origin {origin}" if origin else ""))


def system_checks():
    return [boot_verdict(boot_info()),
            tmp_verdict(tmp_info()),
            disk_verdict(disk_info()),
            serve_verdict(serve_info()),
            repo_verdict(repo_info()),
            sync_verdict(sync_info()),
            project_verdict(project_info()),
            hooks_verdict(hooks_info()),
            login_verdict(login_info()),
            deps_verdict(deps_info()),
            authz_verdict(authz_info())]


def tunnel_info(root=None):
    """ssh 터널 상태 (REQ-20260906-010) — s9 가 못 뜰 때도 읽어야 하니 상태 파일을
    직접 본다(state/tunnel-<로컬포트>.json). 비밀 이름만 있고 값은 없는 파일이다."""
    import glob
    rows = []
    for fp in sorted(glob.glob(os.path.join(root or ROOT, "state", "tunnel-*.json"))):
        try:
            with open(fp, encoding="utf-8") as f:
                d = json.load(f)
        except (OSError, ValueError):
            continue
        r = {k: d.get(k) for k in ("secret", "lport", "rport", "pid", "child_pid",
                                   "retries", "status", "started", "retry_in")}
        r["alive"] = owner_alive(int(d.get("pid") or 0))
        rows.append(r)
    return rows


def tunnel_line(rows):
    if not rows:
        return "ssh 터널: 없음"
    parts = []
    for r in rows:
        if not r["alive"]:
            m = "중단됨"
        elif r.get("status") == "reconnecting":
            m = f"연결 대기({r.get('retry_in')}s)"
        else:
            m = "실행 중"
        parts.append(f"{r['lport']}→{r['rport']} {m}(재시도 {r.get('retries') or 0}회)")
    return f"ssh 터널 {len(rows)}개: " + " · ".join(parts)


def diagnose():
    rows = ps_rows()
    serves, orphans, chromes = scan(rows)
    probe = probe_new_port()
    d = {
        "probe": probe,
        "degraded": not probe["ok"],
        "listeners": listeners(),
        "tcp": socket_summary(),
        "wsl_networking": wsl_mode(),
        "serve_procs": len(serves),
        "orphan_test_servers": [{"pid": p, "age": a} for p, a, _ in orphans],
        "headless_chrome": [{"pid": p, "age": a} for p, a, _ in chromes],
        "shots_bytes": scratch_bytes(),
        "windows_ports": windows_ports(),
        "system": system_checks(),
        "tunnels": tunnel_info(),
    }
    return d, orphans, chromes


def fix(orphans, chromes, older_than=ORPHAN_AGE):
    """우리가 흘린 것만 회수한다 — 사용자의 서버·브라우저는 건드리지 않는다."""
    killed = []
    for pid, age, _cmd in orphans:
        try:
            os.kill(pid, signal.SIGTERM)
            killed.append(("orphan-server", pid, age))
        except OSError:
            pass
    for pid, age, _cmd in chromes:
        if age > older_than:      # 진행 중 캡처는 죽이지 않는다
            try:
                os.kill(pid, signal.SIGTERM)
                killed.append(("headless-chrome", pid, age))
            except OSError:
                pass
    return killed


def advise(d):
    """덜 파괴적인 순서로 다음 조치를 제시한다.

    순서의 근거: 리눅스 쪽 회수(비파괴) → 유발 행위 중단 → 대기 → 호스트
    점유자 회수(중계만 죽고 세션은 산다) → wsl --shutdown(모든 세션이 죽는다).
    호스트 포트가 이미 고갈됐다면 리눅스 회수로는 절대 안 풀리므로, 그때는
    회수 단계를 앞으로 당긴다."""
    out = []
    lat = (d.get("probe") or {}).get("latency")
    win = d.get("windows_ports") or {}
    pv = port_verdict(win)
    target = relay_hoarder(win)
    pct = f"{pv['ratio'] * 100:.0f}%" if pv else ""

    if pv and pv["level"] != "ok":
        out.append(f"윈도우 동적 포트 {pv['bound']}/{pv['total']} 사용 "
                   f"({pct}) — WSL이 새 포트를 호스트에 공개할 자리가 "
                   f"{'없다' if pv['level'] == 'critical' else '얼마 남지 않았다'}. "
                   f"이건 리눅스 쪽 문제가 아니라 호스트 쪽에 남은 포트가 없는 것이다.")
        if target:
            kind = ("WSL 포트 중계(COM 대리)" if target["is_known_relay"]
                    else "COM 대리 프로세스")
            out.append(f"점유자: pid {target['pid']} {target['name']} — "
                       f"{target['count']}개. {kind}로 보인다.")
            # 거둔 단언을 다시 적지 않는다 (REQ-20260904-014). 「세션은
            # 살아남는다」는 REQ-20260902-066 이 근거 없음으로 판정했고, 그
            # 중계가 나르던 연결이 전부 끊기는 것은 설계상 확실하다 — 사람이
            # 고장 났을 때 읽는 이 문장이 거짓이면 안내가 곧 피해가 된다.
            out.append(f"`s9-doctor --recover` — 그 프로세스를 종료해 포트를 "
                       f"즉시 반환시킨다. 중계는 다시 뜨지만 그것이 나르던 연결"
                       f"(브라우저 탭·원격 편집기 채널)은 전부 끊기고, WSL 세션"
                       f"까지 함께 내려간 사례가 있다 — 하던 일이 끊겨도 되는 "
                       f"때에 사람이 직접 실행하라.")
        elif win.get("top_name"):
            out.append(f"최다 점유자는 pid {win.get('top_pid')} "
                       f"{win['top_name']} ({win.get('top_count')}개) — "
                       f"우리 자원이 아니라 자동 정리 대상이 아니다. "
                       f"그 앱을 먼저 종료하라.")

    if d["degraded"]:
        out.append("degraded — 새 포트가 제한 시간 안에 공개되지 않는다. "
                   "기존에 떠 있던 서버는 계속 동작하므로 증상이 헷갈린다.")
        steps = []
        recover_step = ("`s9-doctor --recover` — 동적 포트를 독차지한 중계 "
                        "프로세스를 종료한다(세션은 유지된다).")
        if target and pv.get("level") == "critical":
            # 호스트 포트가 이미 말랐다면 리눅스 쪽 회수로는 풀리지 않는다.
            steps.append(recover_step)
        steps.append("`s9-doctor --fix` — 부모가 사라진 테스트 서버·좀비 헤드리스 "
                     "브라우저를 정리한다(비파괴).")
        steps.append("동시 실행 중인 캡처·서버 기동을 멈춘다 — 포트 생성이 "
                     "계속되면 공개 지연이 더 늘어난다.")
        steps.append("1~2분 뒤 재실행. 지연은 윈도우 측이 자원을 해제하면 "
                     "스스로 줄어든다 — 이 상태는 영구 고장이 아니다.")
        if target and pv.get("level") != "critical":
            steps.append(recover_step)
        steps.append("마지막 수단이 `wsl --shutdown` 이다(실행 중인 "
                     "세션·에이전트가 함께 종료된다).")
        out += [f"{i}) {t}" for i, t in enumerate(steps, 1)]
        out += system_advice(d)
        return out

    if lat is not None and lat >= 3:
        out.append(f"느림 — 새 포트 공개까지 {lat}초 걸렸다. 서버 기동 대기가 "
                   f"5초 안팎인 코드는 이 상태에서 실패한다.")
        out.append("동시 캡처·테스트 수를 줄이고, 서버 기동 대기 시간을 "
                   "넉넉히(20초 이상) 잡아라.")
        out += system_advice(d)
        return out

    sys_out = system_advice(d)
    if sys_out:
        # 포트가 멀쩡해도 시스템이 아프면 '정상'이라 말하지 않는다 — 그 한 줄
        # 때문에 사용자가 원인을 못 찾고 재부팅으로 갔다(REQ-20260829-004).
        out.append(f"네트워크는 정상이다(공개 지연 "
                   f"{lat if lat is not None else 0}초). 걸린 것은 다른 데 있다:")
        out += sys_out
    else:
        out.append(f"정상 — 새 포트 공개까지 {lat if lat is not None else 0}초.")
    if d["orphan_test_servers"]:
        out.append(f"부모가 사라진 테스트 서버 {len(d['orphan_test_servers'])}개가 남아 "
                   f"있다 — `s9-doctor --fix` 로 정리하라.")
    return out


def system_advice(d):
    """시스템 점검 중 ok 가 아닌 것만, 나쁜 순서로."""
    rows = [r for r in (d.get("system") or []) if r["level"] != "ok"]
    rows.sort(key=lambda r: -LEVEL_ORDER.get(r["level"], 0))
    out = []
    for r in rows:
        out.append(f"{LEVEL_MARK.get(r['level'], '·')} {r['line']}")
        if r.get("advice"):
            out.append(f"   {r['advice']}")
    return out


def exit_code(d):
    """포트가 멀쩡해도 시스템에 critical 이 있으면 실패로 끝낸다 — 무인 호출이
    종료코드만 보고 '괜찮다'고 넘기지 않도록."""
    if d.get("degraded"):
        return 1
    levels = [r["level"] for r in (d.get("system") or [])]
    return 1 if worst_level(levels) == "critical" else 0


def main():
    ap = argparse.ArgumentParser(prog="s9-doctor", description=__doc__)
    ap.add_argument("--sweep", action="store_true",
                    help="부모가 사라진 캡처 브라우저·프로필만 조용히 정리(진단 생략)")
    ap.add_argument("--fix", action="store_true",
                    help="부모가 사라진 테스트 서버·좀비 헤드리스 브라우저 정리")
    ap.add_argument("--recover", action="store_true",
                    help="동적 포트를 독차지한 WSL 포트 중계 프로세스 종료")
    ap.add_argument("--yes", action="store_true",
                    help="--recover 확인 프롬프트 생략(백그라운드 실행용)")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    if args.sweep:
        # 캡처 직전·서버 감시 주기에서 부르는 경로 — 진단(프로브·powershell 조회)을
        # 생략해 싸게 끝낸다. 조용히 실행하고 회수한 게 있을 때만 한 줄 남긴다.
        sw = sweep_stale_shots()
        sw["servers"] = reap_orphan_servers()
        sw["tmp"] = sweep_stale_tmp()
        if args.json:
            print(json.dumps(sw, ensure_ascii=False))
        elif (sw["procs"] or sw["profiles"] or sw["servers"]
              or sw["tmp"]["dirs"]):
            print(f"정리: 부모가 사라진 캡처 브라우저 {sw['procs']}개 · "
                  f"프로필 {sw['profiles']}개 · "
                  f"부모가 사라진 테스트 서버 {sw['servers']}개 · "
                  f"임시 자리 {sw['tmp']['dirs']}개")
        return 0

    d, orphans, chromes = diagnose()
    if args.recover:
        target = relay_hoarder(d.get("windows_ports") or {})
        if not target:
            print("종료 대상이 없다 — 동적 포트를 독차지한 중계 프로세스가 "
                  "확인되지 않는다. 진단만 출력한다.\n", file=sys.stderr)
        else:
            pv = port_verdict(d["windows_ports"])
            print(f"종료 대상: pid {target['pid']} {target['name']} — 동적 포트 "
                  f"{target['count']}개 점유 (전체 {pv['bound']}/{pv['total']})")
            print(f"  {target['cmd']}")
            # 대가를 줄여 적지 않는다 (REQ-20260902-066). 예전 문구는 "실행 중인
            # WSL 세션은 유지된다"고 단언했고, 그 단언을 믿고 60% 무인 종료를
            # 걸었다가 2026-09-02 하루에 아홉 번 발동해 일곱 번이 실패로
            # 남았다 — 같은 날 사용자가 "자꾸 wsl 이 죽는 것 같다"고 물었다.
            print("종료하면 그 포트가 즉시 반환된다. COM 대리 프로세스라 필요 시 "
                  "다시 뜬다. 다만 공개된 포트는 재공개까지 끊기고, 실행 중인 "
                  "WSL 세션까지 함께 내려간 사례가 있다 — 지금 하던 일이 끊겨도 "
                  "되는 때인지 보고 골라라.")
            go = args.yes
            if not go:
                try:
                    go = input("종료할까? [y/N] ").strip().lower() == "y"
                except EOFError:
                    go = False
            if go:
                d["recovered"] = reclaim_relay(target)
                time.sleep(2.0)
                d["windows_ports"] = windows_ports()
                d["probe_after_recover"] = probe_new_port()
                d["degraded"] = not d["probe_after_recover"]["ok"]
            else:
                print("취소했다.\n")
    if args.fix:
        d["fixed"] = [{"kind": k, "pid": p, "age": a}
                      for k, p, a in fix(orphans, chromes)]
        d["swept"] = sweep_stale_shots()
        d["swept_tmp"] = sweep_stale_tmp()
        pruned_n, pruned_b = prune_shot_files()
        d["pruned_shots"] = {"files": pruned_n, "bytes": pruned_b}
        d["shots_bytes"] = scratch_bytes()
        time.sleep(0.5)
        d["probe_after_fix"] = probe_new_port()
        d["degraded"] = not d["probe_after_fix"]["ok"]
    d["concurrency"] = CONCURRENCY
    d["login"] = login_info()
    d["advice"] = advise(d)

    if args.json:
        print(json.dumps(d, ensure_ascii=False, indent=1))
        return exit_code(d)

    lat = (d.get("probe") or {}).get("latency")
    mark = ("✗ degraded" if d["degraded"]
            else f"✓ 정상 (공개 지연 {lat}초)" if lat is not None else "✓ 정상")
    print(f"네트워크(신규 포트 공개): {mark}")
    if d["probe"].get("error"):
        print(f"  프로브 실패: {d['probe']['stage']} — {d['probe']['error']}")
    print(f"리스너 {d['listeners']}개 · {d['tcp']}")
    if d["wsl_networking"]:
        print(f"WSL 네트워킹 모드: {d['wsl_networking']}")
    print(f"s9 serve 프로세스 {d['serve_procs']}개 "
          f"(부모가 사라진 테스트 서버 {len(d['orphan_test_servers'])}개) · "
          f"헤드리스 브라우저 {len(d['headless_chrome'])}개 · "
          f"캡처 산출물 {human(d['shots_bytes'])}")
    print(tunnel_line(d.get("tunnels") or []))
    # **겹칠 때의 합을 사람이 물을 수 있어야 한다** (REQ-20260903-004).
    # 비용은 총량이 아니라 동시 최고치인데, 상한이 흩어져 있으면 그 합을
    # 아무도 모른다. 여기 한 줄로 세워 둔다 — 값은 bin/s9 의 CONCURRENCY 한 표.
    cc = d.get("concurrency") or {}
    if cc:
        print("동시 상한: "
              + " · ".join(f"{k} {v}" for k, v in cc.items())
              + f" (한때 합 최대 {sum(cc.values())})")
    pv = port_verdict(d.get("windows_ports") or {})
    if pv:
        mark2 = {"ok": "✓", "warn": "△", "critical": "✗"}[pv["level"]]
        print(f"윈도우 동적 포트: {mark2} {pv['bound']}/{pv['total']} "
              f"({pv['ratio'] * 100:.0f}%)")
    if d.get("recovered"):
        r = d["recovered"]
        print(f"  종료: WSL 포트 중계 pid={r['pid']} "
              f"({'성공' if r['rc'] == 0 else 'rc=' + str(r['rc'])}) {r['out']}")
    if "probe_after_recover" in d:
        print("종료 후 프로브: "
              + ("✓ 정상" if d["probe_after_recover"]["ok"]
                 else "✗ 여전히 degraded"))
    for f in d.get("fixed", []):
        print(f"  정리: {f['kind']} pid={f['pid']} ({f['age']}s)")
    sw = d.get("swept")
    if sw and (sw["procs"] or sw["profiles"]):
        print(f"  정리: 부모가 사라진 캡처 브라우저 {sw['procs']}개 · "
              f"프로필 {sw['profiles']}개")
    st = d.get("swept_tmp")
    if st and st["dirs"]:
        print(f"  정리: 테스트가 흘린 임시 자리 {st['dirs']}개 "
              f"({human(st['bytes'])})")
    pr = d.get("pruned_shots")
    if pr and pr["files"]:
        print(f"  정리: 오래된 캡처 산출물 {pr['files']}개 ({human(pr['bytes'])})")
    if "probe_after_fix" in d:
        print("종료 후 프로브: "
              + ("✓ 정상" if d["probe_after_fix"]["ok"] else "✗ 여전히 degraded"))
    for r in d.get("system", []):
        print(f"{LEVEL_MARK.get(r['level'], '·')} {r['line']}")
    print()
    for line in d["advice"]:
        print(line)
    return exit_code(d)


if __name__ == "__main__":
    sys.exit(main())
