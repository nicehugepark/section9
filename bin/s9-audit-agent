#!/usr/bin/env python3
"""section9 delegation audit hook (Claude Code PostToolUse, matcher=Agent).

리드가 Agent 툴로 위임한 순간, 그 위임을 **사람의 기억이 아니라 구조로** 등록한다
(REQ-20260825-088, 설계 DOC-20260825-003):

  1. active_reqs 클레임        — 병렬 위임이 대시보드에서 보이게
  2. agent_transcript_path 누적 — 그 에이전트의 활동이 live 신선도의 근거가 되게
  3. contributions 에 running   — "어느 항목을 누가 지금 하고 있는가"를 문서에

배경: 2026-08-25 위임 에이전트 2개가 병렬로 돌았는데 리드가 `s9 last --add` 와
transcript 등록을 잊어 화면에 아무것도 안 보였다. 수동 규약은 남기되 기본을
자동으로 바꾼다 — 잊을 수 있는 경로는 언젠가 반드시 잊힌다.

PostToolUse 시점을 고르는 이유: PreToolUse 에는 agentId·output_file 이 아직 없다.
이 하네스의 Agent 툴은 백그라운드 스폰이라 tool_response 가 **시작 시점에**
agentId/output_file 을 돌려준다 — 즉 이 훅은 종료가 아니라 기동 시점에 돈다.
종료 시점의 마감(result=done)은 SubagentStop 훅(s9-audit-subagent)이 맡는다.

귀속 대상은 **위임을 띄운 쪽이 지명한 REQ** 를 먼저 본다 (REQ-20260828-041).
세션 클레임만 보던 종전 규칙은 리드가 자기가 클레임하지 않은 문서에 위임하면
그 위임을 엉뚱한 REQ 에 붙였다 — 2026-08-28 21:10 designer 는 039 를 작업 중인데
기록은 028 로 갔고, 039 는 화면에서 "69분째 진전 없음" 이 됐다. 지명이 없거나
유일하지 않으면 종전 경로(클레임)로 물러난다.

그 지명 해석은 이제 훅이 아니라 `bin/s9 delegate-target` 에 산다 (REQ-20260829-036)
— 훅 안쪽 정규식이 정식 id 만 보는 바람에 리드가 실제로 치는 형태(`030·031 화면
몫`)를 하나도 못 풀었고, 2026-08-29 20:09 designer 의 위임이 REQ-029 로 갔다.
그 하나가 사고 둘을 낳았다: 030 은 손이 안 보여 거짓 멈춤 + 겹친 스폰, 029 는
없는 손이 보여 진짜 멈춤이 가려짐. 그리고 클레임 경로로 물러난 귀속은
**추측이라고 적는다**(`s9 claim --guess`) — 그래야 그 손이 '어느 문서인지 모르는
손'으로 세어져 멈춤 판정이 '미상'이 되고 무인 작업자가 겹쳐 뜨지 않는다.

원칙: 실패 시 조용히 exit 0. 문서를 건드릴 근거가 없으면 아무것도 하지 않는다.
비활성화: S9_AUDIT=off
"""
import json
import os
import re
import subprocess
import sys


# 윈도우에서 출력을 UTF-8 로 고정한다 (REQ-20260903-005). 이 도구들의 출력은
# 거의 다 한국어인데, 파이프로 받으면 파이썬이 콘솔 코드페이지(한국어 윈도우는
# cp949)로 인코딩한다 — 실측에서 그 출력을 UTF-8 로 읽은 쪽이 통째로 깨졌다
# (`UnicodeDecodeError: 0xc0 in position 3`). 파일에 남는 기록도 같은 이유로
# 판마다 다른 바이트가 된다. 판을 가르는 자리는 이름을 붙여 한 곳에 둔다:
# 여기가 그 자리이고, 도구마다 같은 글자로 서 있는지는 시험이 못박는다.
if os.name == "nt":
    for _std in (sys.stdout, sys.stderr):
        try:
            _std.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, ValueError, OSError):
            pass

S9 = os.path.join(os.path.dirname(os.path.abspath(__file__)), "s9")
# `bin/s9` 를 부르는 argv (REQ-20260903-005). 경로 하나만 넘기면 **윈도우에서
# 부를 수가 없다** — 그 판에는 shebang 이 없어 확장자 없는 스크립트가
# `CreateProcess` 를 통과하지 못한다(WinError 193/2). 판을 갈라 분기하는 대신
# 판에 기대는 것을 없앤다: 지금 도는 인터프리터로 그 파일을 연다. 리눅스·맥에서
# 하던 일과 결과가 같고(같은 python3 가 같은 스크립트를 연다), 실행 권한 비트나
# `env` 의 존재에도 기대지 않게 된다.
S9_ARGV = [sys.executable, S9]

AID_RE = re.compile(r"agentId[\"'\s:=]+([0-9a-zA-Z_-]+)")
OUT_RE = re.compile(r"output_file[\"'\s:=]+(\S+?)[\"',\s]*$", re.M)


def _detect_root(data):
    """세션 cwd가 s9 인스턴스면 그 루트를 S9_ROOT로 승격 (REQ-20260824-053)."""
    if os.environ.get("S9_ROOT"):
        return
    cwd = (data.get("cwd") or "").strip()
    if cwd and os.path.exists(os.path.join(cwd, "bin", "s9")) \
            and os.path.isdir(os.path.join(cwd, "vault")):
        os.environ["S9_ROOT"] = cwd


def run(env, *argv):
    return subprocess.run([*S9_ARGV, *argv], capture_output=True,
                          encoding="utf-8", errors="replace",
                          env=env, timeout=15)


def parse_agent_result(resp):
    """Agent 툴 응답 → (agentId, output_file). 못 읽으면 ('', '').

    하네스가 dict 를 주기도 하고 사람이 읽는 텍스트를 주기도 한다 — 둘 다 받는다.
    파싱 실패를 예외로 올리지 않는 이유: 이 훅의 실패는 감사 공백일 뿐이고,
    툴 사용 자체를 막아선 안 된다."""
    if isinstance(resp, dict):
        aid = str(resp.get("agentId") or resp.get("agent_id") or "")
        out = str(resp.get("output_file") or resp.get("outputFile") or "")
        if aid and out:
            return aid, out
        resp = json.dumps(resp, ensure_ascii=False)
    if isinstance(resp, list):
        resp = "\n".join(
            x.get("text", "") if isinstance(x, dict) else str(x) for x in resp)
    if not isinstance(resp, str):
        return "", ""
    m1, m2 = AID_RE.search(resp), OUT_RE.search(resp)
    if not (m1 and m2):
        return "", ""
    return m1.group(1), m2.group(1).strip("\"',")


def actor_for(agent_type, agent_id):
    """위임 에이전트의 actor 규격 문자열 — sub:<타입>:<agentId8>."""
    t = (agent_type or "subagent").strip() or "subagent"
    return "sub:%s:%s" % (t, (agent_id or "")[:8]) if agent_id else "sub:%s" % t


def target_reqs(env, inp=None):
    """이 위임이 붙을 요청들 — ([정식 id…], 출처) (REQ-20260829-036).

    **판정은 훅이 아니라 `bin/s9` 에 산다.** 여기 있던 시절에는 시험이 잘 안
    닿았고(훅은 하네스가 부르는 자리다), 실제로 2026-08-29 20:09 의 오귀속은
    훅 안쪽 정규식 하나가 원인이었다. `s9 delegate-target` 한 번으로 끝내는
    것은 부수 효과도 있다 — 종전에는 후보마다 `s9 show`·`s9 last --owns` 를
    따로 불러 훅 하나가 s9 를 대여섯 번 띄웠다. 훅에는 20초 제한이 있다.

    출처가 "클레임" 이면 그것은 **추측**이다 — 그 사실을 그대로 돌려준다.
    """
    inp = inp or {}
    r = run(env, "delegate-target",
            "--description", str(inp.get("description") or "")[:2000],
            "--prompt", str(inp.get("prompt") or "")[:8000])
    try:
        got = json.loads(r.stdout or "{}")
    except ValueError:
        return [], ""
    reqs = [x for x in (got.get("reqs") or []) if isinstance(x, str) and x]
    return reqs, str(got.get("src") or "")


def target_req(env, inp=None, out=None):
    """옛 이름 — 하나만 돌려준다. 새 코드는 `target_reqs` 를 써라."""
    reqs, src = target_reqs(env, inp)
    if out is not None:
        out["src"] = src
    return reqs[0] if reqs else ""


def warn_undeclared(src, reqs, out):
    """지명 없는 위임에 경고를 리드에게 되돌린다 (REQ-20260830-020, 경고-only).

    귀속이 추론이면 빗나갈 수 있고, 한 오귀속이 사고 둘을 낳는다 — 손이 안
    보이는 문서는 거짓 멈춤(→ 일하는 파일 위 두 번째 손), 손이 잘못 보이는
    문서는 가려진 진짜 멈춤 (실사고 2026-08-29 20:09). 다각 검토(REQ-20260830-017)
    합의는 **경고 먼저**다: 스폰을 막지 않고(이미 떠 있다), 등록도 종전대로
    하되, 리드가 그 자리에서 바로잡을 수 있게 알린다. PostToolUse 의
    decision=block 은 도구를 되돌리지 않는다 — reason 을 모델에게 보일 뿐이다.
    hooks.json 이 stderr 를 버리고 exit 를 무는(|| true) 봉투라 stdout JSON 이
    유일한 통로다."""
    if src == "지명":
        return
    got = (" 이번에는 클레임에서 " + " · ".join(reqs) + " 로 추측해 등록했다 —"
           " 틀렸으면") if reqs else (" 등록할 곳을 못 찾아 손만 등록했다 —")
    print(json.dumps({
        "decision": "block",
        "reason": (
            "[section9 위임 지명 경고] 방금 위임의 description/prompt 에서 대상 "
            "REQ 지명을 풀지 못했다." + got +
            f" 지금 `s9 claim <올바른 REQ> --agent-transcript {out}` 로 "
            "바로잡아라. 다음 위임부터는 description 에 REQ 번호를 넣어라"
            "(예: '020 훅 검토' 또는 정식 id). 지명 없는 위임은 오귀속을 낳고, "
            "오귀속 하나가 거짓 멈춤과 겹침 스폰 둘을 만든다 (REQ-20260830-020).")},
        ensure_ascii=False))


def main():
    if os.environ.get("S9_AUDIT", "").lower() == "off":
        return
    data = json.load(sys.stdin)
    if (data.get("tool_name") or "") != "Agent":
        return
    _detect_root(data)
    aid, out = parse_agent_result(data.get("tool_response"))
    if not (aid and out):
        return

    env = dict(os.environ)
    env["S9_SESSION"] = (data.get("session_id") or "unknown")[:8]
    inp = data.get("tool_input") or {}
    reqs, src = target_reqs(env, inp)
    actor = actor_for(inp.get("subagent_type"), aid)
    if not reqs:
        # 붙일 곳이 없어도 **손이 있다는 사실은 남긴다** (REQ-20260829-036).
        # 종전에는 여기서 그냥 돌아섰고, 그러면 바인딩에 transcript 조차 안
        # 남아 `s9 workers` 도 그 손을 못 봤다 — 아무도 못 보는 손이 일하는
        # 파일 위의 두 번째 손을 부른다.
        run(env, "claim", "--agent-transcript", out)
        run(env, "log", f"위임 등록 보류(손만 등록): 대상 REQ 없음 "
                        f"(agent {aid[:8]})")
        warn_undeclared(src, reqs, out)
        return
    # 추측(클레임 경로)은 추측이라고 적는다 — 그래야 그 손이 '어느 문서인지
    # 모르는 손'으로 세어져 멈춤 판정이 '미상'이 되고 스폰이 겹치지 않는다.
    guess = ["--guess"] if src != "지명" else []
    for req in reqs:
        run(env, "claim", req, "--agent-transcript", out, *guess)
        run(env, "contrib", req, "--actor", actor,
            "--item", (inp.get("description") or "")[:120],
            "--result", "running", "--transcript", out)
    run(env, "log", f"위임 등록: {' · '.join(reqs)} ← {actor} ({src or '?'})")
    warn_undeclared(src, reqs, out)


if __name__ == "__main__":
    try:
        main()
    except Exception:
        sys.exit(0)
