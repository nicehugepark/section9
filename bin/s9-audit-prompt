#!/usr/bin/env python3
"""section9 auto-audit hook (Claude Code UserPromptSubmit).

프롬프트를 Request / Question / Fragment / Nothing 으로 1차 분류(휴리스틱)하고:
  - Request  → REQ 문서 생성 + SES 로그 + 보강 규약 주입 (오분류 시 s9 rm 정정)
  - Question → 남을 질문이면 QST 문서 생성(답은 Stop 훅이 자동으로 붙인다),
               아니면 SES 로그만 + 정정 경로 주입 (실제 요청이면 s9 new request)
  - Fragment → 짧은 파편("logout" 등) — REQ 미생성, SES 로그 + 정정 경로 주입
  - Nothing  → SES 로그만 (컨텍스트 주입 없음)

의미 판단의 최종 권한은 LLM에게 있다 — 휴리스틱은 기본값, 양방향 정정 경로 제공.
원칙: 어떤 경우에도 사용자 프롬프트를 막지 않는다 — 실패 시 조용히 exit 0.
비활성화: 환경변수 S9_AUDIT=off
"""
import glob
import json
import os
import re
import subprocess
import sys


# 윈도우에서 출력을 UTF-8 로 고정한다 (REQ-20260903-005). 이 도구들의 출력은
# 거의 다 한국어인데, 파이프로 받으면 파이썬이 콘솔 코드페이지(한국어 윈도우는
# cp949)로 인코딩한다 — 실측에서 그 출력을 UTF-8 로 읽은 쪽이 통째로 깨졌다
# (`UnicodeDecodeError: 0xc0 in position 3`). 파일에 남는 기록도 같은 이유로
# 판마다 다른 바이트가 된다. 판을 가르는 자리는 이름을 붙여 한 곳에 둔다:
# 여기가 그 자리이고, 도구마다 같은 글자로 서 있는지는 시험이 못박는다.
if os.name == "nt":
    for _std in (sys.stdout, sys.stderr):
        try:
            _std.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, ValueError, OSError):
            pass

S9 = os.path.join(os.path.dirname(os.path.abspath(__file__)), "s9")
# `bin/s9` 를 부르는 argv (REQ-20260903-005). 경로 하나만 넘기면 **윈도우에서
# 부를 수가 없다** — 그 판에는 shebang 이 없어 확장자 없는 스크립트가
# `CreateProcess` 를 통과하지 못한다(WinError 193/2). 판을 갈라 분기하는 대신
# 판에 기대는 것을 없앤다: 지금 도는 인터프리터로 그 파일을 연다. 리눅스·맥에서
# 하던 일과 결과가 같고(같은 python3 가 같은 스크립트를 연다), 실행 권한 비트나
# `env` 의 존재에도 기대지 않게 된다.
S9_ARGV = [sys.executable, S9]
TITLE_MAX = 24  # 임시 제목 — LLM이 20자 이내 명사구 제목으로 반드시 교체
# 질문 문서의 제목은 질문 그 자체다 — 요청과 달리 명사구로 교체하지 않는다
# (질문을 가장 정확히 가리키는 제목은 질문문이다). 그래서 절단만 넉넉히 둔다.
QUESTION_TITLE_MAX = 60
# 문서가 되는 질문의 하한 (REQ-20260826-017 / DOC-20260826-011). 확인·응답 종결
# 발화("이거 맞아?", "지금 되나요?")는 거의 예외 없이 이보다 짧고, 설계·구조를
# 묻는 질문은 대상과 맥락을 말해야 해서 거의 언제나 이보다 길다. 사전 판정은
# 근사일 수밖에 없으므로(남길 가치는 답이 나온 뒤에야 확정된다) 오분류는
# 양방향 정정 경로(주입 문구의 s9 rm / s9 new question)로 푼다.
QUESTION_DOC_MIN = 20

ACK = re.compile(
    r"^(?:(?:ㅇㅋ|ok|okay|yes|no|네|넵|예|응|웅|좋아|좋다|좋네|고마워|고맙다|감사|thanks|thx|"
    r"알겠어|알겠다|알았어|확인|됐다|됐어|잘했어|굿|good)[.!~ㅋㅎ\s]*)+$", re.I)
IMPERATIVE = re.compile(
    r"(해\s?줘|해\s?주세요|해라|하라|해봐|해\s?볼래|시켜|만들어|추가해|수정해|고쳐|바꿔|"
    r"삭제해|지워|없애|구현|진행해|진행하|부탁|생성해|등록해|적용해|반영해|정리해|"
    r"작성해|개선해|리팩|배포해|테스트해|확인해\s?줘|보여\s?줘|알려\s?줘)")
QUESTION_TAIL = re.compile(
    r"(\?|까요?\s*$|니\s*$|냐\s*$|나요\s*$|가요\s*$|는가\s*$|은가\s*$|인가\s*$|"
    r"건가\s*$|일까\s*$|어때\s*$|는지\s*$|그래\s*$|거야\s*$|거지\s*$|다고\s*$)")
QUESTION_HEAD = re.compile(r"^(왜|뭐|무엇|어떻게|어떤|어디|누가|누구|언제|몇|얼마)")
# 첨부 참조 줄 (REQ-20260826-034): `[Image: /경로]` · `[File: /경로]` · `[Image #1]`.
# `file` 이 처음엔 빠져 있었다 — 실사고 둘(032·031)이 둘 다 이미지라 그 형태에만
# 맞춰 좁게 썼다. 대시보드는 확장자로 마크를 가르므로(web/index.html sendChat)
# 로그·PDF 를 붙여 물으면 `[File: …]` 이 되어 같은 함정을 그대로 밟았다.
# 재작업 워커가 봉투 밖(bin/)이라 못 고치고 테스트로 못 박아 둔 것을 여기서 닫는다.
# 분류는 질문 표지를 **마지막 줄**에서 찾는데, 이미지를 붙이면 원문 마지막 줄이
# 이것이라 물음표가 밀려난다. 실사고 둘 — "이 요청은 붉은색 점은 무슨 의미야?"
# (REQ-20260826-032)와 "idle인 이유가 뭐라고?"(REQ-20260826-031). 둘 다 명백한
# 질문인데 request 카드가 됐다. 사람은 화면을 캡처해 물으므로, **가장 물어보고
# 싶을 때** 정확히 이 경로를 밟는다.
ATTACH_LINE = re.compile(
    r"^\s*\[(?:image|file|screenshot|attachment|파일|이미지|첨부)"
    r"\s*[#:][^\]]*\]\s*$",
    re.I)


def strip_attachment_refs(text):
    """첨부 참조 줄을 걷어낸 본문. 첨부뿐이면 원문 그대로(기존 동작 보존)."""
    kept = [l for l in (text or "").splitlines() if not ATTACH_LINE.match(l)]
    out = "\n".join(kept).strip()
    return out or (text or "")
ACK_TAIL = re.compile(r"(구나|군요|네요|되네|거네|겠다|알겠다|이해했다|확인했다)[.!~ ]*$")
# 메타 지시: 기존 작업/시스템에 대한 명령 (새 산출물 요청이 아님). REQ화하지 않는다.
META_VERB = re.compile(
    r"(진행(해|하|시켜)?|이어서|이어(해|가)|계속(해|\s*진행)?|착수|취소(해|하)?|삭제(해)?|지워|"
    r"켜(줘|라|)?\s*$|켜(줘|라)|꺼(줘|라)?|활성화|비활성화|승인(해)?|반려(해)?|재개(해)?|"
    r"되돌려|롤백|다시\s?해|재시도|정리해|치워|진행$)")
# 기존 REQ/DOC id 참조 (특정 문서를 가리키는 지시)
REF_ID = re.compile(r"\b(REQ|DOC|SES)-\d")
# 즉석 인터랙션 (REQ-20260825-028): 응답으로 완결되는 요청 — 출력·표시·대기·
# 관찰용. 지속 산출물 동사(PRODUCE)와 결합하지 않은 짧은 문장이면 카드를
# 만들지 않는다(규약 2조: 단순 인터랙션은 세션 로그만). 애매하면 카드가 안전.
INTERACTION = re.compile(
    r"(출력해|보여\s?줘|알려\s?줘|확인해\s?줘|대기해|기다려|확인용|테스트용|관찰용)")
PRODUCE = re.compile(
    r"(만들|구현|수정|고쳐|추가|등록|적용|반영|작성|개선|배포|삭제|지워|바꿔|리팩|설계|검토|점검)")


FRAGMENT_MAX = 20  # 이하 길이 + 명령형/질문 표지 없음 → 파편(REQ 미생성)




# 훅은 독립 실행 파일이라 s9 의 프로세스 조회를 로컬 복제한다. 복제는
# 갈라지므로, 갈라지지 않는지를 시험이 못박는다 (tests/test_platform_live.py).
# 갈래가 여기 없으면 맥에서 조용히 틀린다: `/proc` 은 리눅스에만 있다
# (REQ-20260829-037).
def _proc_backend():
    forced = (os.environ.get("S9_PROC_BACKEND") or "").strip()
    if forced in ("proc", "ps", "win", "none"):
        return forced
    if os.path.isdir("/proc/self"):
        return "proc"
    return "win" if os.name == "nt" else "ps"


# 윈도우 갈래 — `/proc` 도 `ps` 도 없는 자리에서 프로세스 목록을 주는 것은
# PowerShell 의 CIM 조회다 (s9._win_table 의 로컬 복제). 훅은 프롬프트마다
# 도는 데다 조상 체인을 열 걸음 올라가므로, **이 프로세스 안에서 한 번만**
# 묻고 캐시한다 — 매번 물으면 열 번 프로세스를 띄운다.
_WIN_ROWS = {}          # {pid: (실행 파일 이름, 부모 pid, 명령줄)}
_WIN_READ = [False]
# 첫 문장이 인코딩을 정한다 (REQ-20260903-005) — PowerShell 은 기본적으로
# 콘솔 코드페이지로 쓴다. s9.WIN_PS_SCRIPT 의 로컬 복제.
WIN_PS_SCRIPT = ("[Console]::OutputEncoding = "
                 "[System.Text.Encoding]::UTF8; "
                 "Get-CimInstance Win32_Process | ForEach-Object { "
                 "$c = $_.CommandLine; if (-not $c) { $c = $_.Name }; "
                 "[string]$_.ProcessId + ' ' + [string]$_.ParentProcessId "
                 "+ ' ' + $c }")


def _win_head(cmd):
    head = (cmd or "").strip()
    if not head:
        return ""
    if head.startswith('"'):
        head = head[1:].split('"', 1)[0]
    else:
        head = head.split(" ", 1)[0]
    return os.path.basename(head.replace("\\", "/"))


def _win_rows():
    """이름을 먼저 찾아보지 않고 **불러 본다**. `shutil` 을 들이지 않으려는
    것이기도 하고(세션 훅은 자기 복사 구현을 되찾지 않기로 한 파일이다),
    있는지 묻는 것보다 되는지 보는 편이 짧기도 하다 — PATH 에 있어도 실행
    정책에 막히면 어차피 빈손이다."""
    if _WIN_READ[0]:
        return _WIN_ROWS
    _WIN_READ[0] = True
    out = ""
    for exe in ("powershell", "pwsh"):
        try:
            out = subprocess.run([exe, "-NoProfile", "-NonInteractive",
                                  "-Command", WIN_PS_SCRIPT],
                                 capture_output=True,
                                     encoding="utf-8", errors="replace",
                                 timeout=25).stdout or ""
        except Exception:
            continue
        if out.strip():
            break
    for ln in out.splitlines():
        c = ln.strip().split(None, 2)
        if len(c) == 3 and c[0].isdigit() and c[1].isdigit():
            _WIN_ROWS[int(c[0])] = (_win_head(c[2]), int(c[1]), c[2].strip())
    return _WIN_ROWS


def _proc_info(pid):
    """(실행 파일 이름, 부모 pid) — 모르면 ("", 0)."""
    if _proc_backend() == "proc":
        try:
            with open(f"/proc/{pid}/comm", encoding="utf-8") as f:
                comm = f.read().strip()
            with open(f"/proc/{pid}/status", encoding="utf-8") as f:
                for ln in f:
                    if ln.startswith("PPid:"):
                        return comm, int(ln.split()[1])
            return comm, 0
        except (OSError, ValueError):
            return "", 0
    if _proc_backend() == "none":
        return "", 0
    if _proc_backend() == "win":
        r = _win_rows().get(int(pid))
        return (r[0], r[1]) if r else ("", 0)
    try:
        out = subprocess.run(["ps", "-o", "ppid=,comm=", "-p", str(pid)],
                             capture_output=True, encoding="utf-8", errors="replace", timeout=5).stdout
    except Exception:
        return "", 0
    c = out.strip().split(None, 1)
    if len(c) == 2 and c[0].isdigit():
        # BSD 의 comm 은 절대경로다 — 이름만 뗀다.
        return os.path.basename(c[1].strip()), int(c[0])
    return "", 0


# claude 를 실어 나르는 런타임들 — 맥에서 어떤 것으로 깔았는지 우리가 고를 수
# 없으므로 이름을 좁게 잡으면 그 기계에서만 조용히 어긋난다.
CLAUDE_COMMS = ("claude", "node", "bun", "deno")


def _exe_name(comm):
    """`node.exe` → `node` — s9.exe_name 의 로컬 복제. 이름을 그대로 견주면
    윈도우에서 조상 체인이 중간 셸에서 멈추고, 그 셸의 pid 가 `attach_pid`
    로 적힌다 (맥에서 났던 그 사고와 같은 모양)."""
    c = (comm or "").strip()
    return c[:-4] if c.lower().endswith(".exe") else c


def _claude_pid():
    """이 훅을 실행한 claude 프로세스 pid — getppid는 소멸성 중간 셸일 수 있어
    (REQ-20260824-065: 신생 유휴 세션이 attach 죽음+활동 0으로 미검출)
    조상 체인을 걸어 올라가 comm이 claude/node인 첫 프로세스를 잡는다.

    이 값이 바인딩의 `attach_pid` 가 된다. 맥에서는 `/proc` 이 없어 첫 판독이
    곧바로 실패했고, **언제나 중간 셸의 pid 가 적혔다** — 그 셸은 곧 죽으니
    생존·계정·중단·재시작이 전부 그 하나 때문에 틀렸다 (REQ-20260829-037).
    """
    pid = os.getppid()
    for _ in range(10):
        if pid <= 1:
            break
        comm, ppid = _proc_info(pid)
        if _exe_name(comm) in CLAUDE_COMMS:
            return pid
        if not ppid:
            break
        pid = ppid
    return os.getppid()

def _detect_root(data):
    """세션 cwd가 s9 리포(인스턴스)면 그 루트를 S9_ROOT로 승격 — 한 머신에서
    업스트림 카피와 인스턴스를 병행할 때 기록이 세션 위치를 따라간다
    (REQ-20260824-053). 명시된 S9_ROOT가 항상 우선."""
    if os.environ.get("S9_ROOT"):
        return
    cwd = (data.get("cwd") or "").strip()
    if cwd and os.path.exists(os.path.join(cwd, "bin", "s9")) \
            and os.path.isdir(os.path.join(cwd, "vault")):
        os.environ["S9_ROOT"] = cwd

def is_command(text):
    """슬래시 커맨드 판별 (REQ-20260825-014) — startswith('/')는 절대경로
    메시지("/home/… 이 경로도 문제가 있다")까지 커맨드로 오인해 audit이
    누락된다. 커맨드 = '/이름' 단독 토큰(이름에 추가 '/' 없음)일 때만."""
    return bool(re.match(r"^/[A-Za-z0-9_:-]+(\s|$)", text or ""))


def attachment_paths(prompt, session_full, home=None):
    """프롬프트의 [Image #N] 참조 → CC 이미지 캐시 실경로 (REQ-20260825-002).
    첨부도 요청 원문이다 — REQ body에 경로를 보존해야 세션이 사라진 뒤에도
    무엇을 보고 한 요청인지 남는다."""
    home = home or os.environ.get("HOME") or os.path.expanduser("~")
    base = os.path.join(home, ".claude", "image-cache", session_full or "")
    out = []
    for n in re.findall(r"\[Image #(\d+)\]", prompt or ""):
        out.extend(sorted(glob.glob(os.path.join(base, f"{n}.*"))))
    return out


def _cmdlines():
    """도는 프로세스들의 명령줄 — s9.proc_table 의 로컬 복제."""
    how = _proc_backend()
    if how == "none":
        return []
    if how == "proc":
        out = []
        try:
            pids = [d for d in os.listdir("/proc") if d.isdigit()]
        except OSError:
            return out
        for pid in pids:
            try:
                with open(f"/proc/{pid}/cmdline", "rb") as f:
                    out.append(f.read().decode("utf-8", "replace")
                               .replace("\0", " "))
            except OSError:
                continue
        return out
    if how == "win":
        return [c for _, _, c in _win_rows().values()]
    try:
        r = subprocess.run(["ps", "-A", "-ww", "-o", "command="],
                           capture_output=True,
                               encoding="utf-8", errors="replace", timeout=10)
    except Exception:
        return []
    return (r.stdout or "").splitlines()


def _tail_alive(needle):
    """이 수신함을 tail(Monitor) 중인 프로세스 존재 여부 — s9._inbox_watch_alive와
    동일 신호 (훅은 독립 실행 파일이라 로컬 복제).

    맥에서는 `/proc` 이 없어 언제나 거짓이었다: tail 이 실시간으로 받고 있는
    줄을 훅이 한 번 더 주입했다는 뜻이다 (REQ-20260829-037).
    """
    if not needle:
        return False
    return any("tail" in cmd and needle in cmd for cmd in _cmdlines())


def pending_context(sid8, env=None):
    """미처리 수신함 줄 + 다른 세션에 갇힌 고아 줄 주입 (REQ-20260825-001,
    REQ-20260826-023). 유휴 중 쌓인 대시보드 채팅이 다음 CLI 프롬프트에서
    소화된다 — 대시보드가 사용자에게 한 약속이 지켜지는 자리가 바로 여기다.

    tail(Monitor)이 살아 있으면 내 수신함은 Monitor가 실시간 전달 중이므로
    주입하지 않는다(커서만 전진해 중복을 막는다). **고아는 그렇지 않다** —
    어느 tail 도 그 파일을 보고 있지 않으니 tail 생존과 무관하게 주입한다.
    """
    try:
        root = os.environ.get("S9_ROOT") or os.path.dirname(
            os.path.dirname(os.path.realpath(__file__)))
        inbox = os.path.join(root, "state", "terminal", f"inbox-{sid8}.jsonl")
        if not os.path.exists(inbox):
            return ""
        alive = _tail_alive(f"inbox-{sid8}")
        # 커서(.seen) 전진 = 소비 — 이 호출은 프롬프트당 정확히 1회다
        r = subprocess.run([*S9_ARGV, "inbox", "--sid", sid8], capture_output=True,
                           encoding="utf-8", errors="replace", env=env or os.environ, timeout=15)
        info = json.loads(r.stdout or "{}")
        size = int(info.get("size") or 0)
        pending = list(info.get("pending") or [])
        orphans = list(info.get("orphans") or [])
        out = ""
        if pending and not alive:
            shown = pending[-50:]
            out += (f" ◈ 대시보드 수신함의 미처리 메시지 {len(pending)}건 — 지금 "
                    f"사용자 메시지로 간주해 함께 처리하라. Monitor 미가동 상태다: "
                    f"`tail -c +{size + 1} -f {inbox}` 를 persistent로 다시 arm하라. "
                    f"줄에 req 필드가 있으면 이미 그 REQ로 기록돼 있다 — 새로 만들지 "
                    f"말고 그 id로 상태를 관리하되, 제목이 원문 그대로면 착수 시 "
                    f"20자 이내 명사구로 교체하라(s9 set). review_refs 필드가 있으면 "
                    f"그 문서에 대한 반려성 지적일 수 있다 — 지적이 맞으면 먼저 "
                    f"in-progress 전이 후 재작업하라(REQ-041):\n"
                    + "\n".join(shown) + "\n")
        if orphans:
            n = sum(len(g["lines"]) for g in orphans)
            body = "\n".join(
                f"  - [{l.get('ts', '?')} · 세션 {g['sid']}] {l.get('text', '')}"
                for g in orphans for l in g["lines"])
            out += (f" ◈ 다른 세션 수신함에 갇혀 있던 미전달 메시지 {n}건 — 대상 "
                    f"세션이 수신 대기를 돌리지 않아 소화되지 못했다. **시각을 보고 "
                    f"아직 유효한 것만** 사용자 메시지로 처리하고, 이미 지난 것이면 "
                    f"그 사실을 한 줄로 알려라:\n" + body + "\n")
        return out
    except Exception:
        return ""


# `s9 code` 가 세션을 한 턴 돌리려고 넣는 기동 줄의 마커 (REQ-20260827-025-62x6).
# bin/s9 의 CODE_BOOTSTRAP_MARK 와 같은 문자열이어야 한다 —
# tests/test_code_bootstrap.py 가 두 자리를 맞물려 검사한다.
BOOTSTRAP_MARK = "[section9 bootstrap]"


def classify(text):
    """휴리스틱 1차 분류.
    우선순위: nothing > meta지시 > request(명령형) > question > fragment > request"""
    # 첨부 줄은 분류의 재료가 아니다 (REQ-20260826-034) — 마지막 줄에서 질문
    # 표지를 찾는 규칙이 첨부 한 줄에 무력해진다.
    text = strip_attachment_refs(text)
    if len(text) <= 12 and ACK.match(text):
        return "nothing"
    # 메타 지시(기존 작업/시스템 명령)는 새 REQ가 아니다 → nothing(세션 로그만).
    # 짧으면서(≤60자) 메타 동사를 쓰거나, 짧으면서 기존 REQ/DOC id를 참조하는 지시.
    # (예: "032 켜줘", "백로그 진행해", "취소해줘", "REQ-044 이어서 해")
    t1 = text.strip()
    if len(t1) <= 60 and (META_VERB.search(t1) or
                          (REF_ID.search(t1) and len(t1) <= 40)):
        return "nothing"
    # 즉석 인터랙션 (REQ-028): 짧고 출력/대기/관찰 동사뿐이면 응답으로 완결 —
    # question 취급(카드 없음·응답은 정상). 지속 산출물 동사가 섞이면 request.
    if len(t1) <= 40 and INTERACTION.search(t1) and not PRODUCE.search(t1):
        return "question"
    if IMPERATIVE.search(text):
        return "request"  # "왜 이래? 고쳐줘" — 명령형이 있으면 질문 표지보다 우선
    last = text.splitlines()[-1].strip()
    # 짧은 감탄/이해 표현 ("아 ~되는거구나") — 명령형 없을 때만
    if len(text) <= 40 and ACK_TAIL.search(last):
        return "nothing"
    if QUESTION_TAIL.search(last) or QUESTION_HEAD.match(text):
        return "question"
    # 파편: 짧고(≤FRAGMENT_MAX) 명령형·질문 표지가 전혀 없는 단문("logout", "test", 오타 등).
    # REQ를 만들지 않고 정정 경로만 주입 — 실제 요청이면 LLM이 s9 new request로 등록한다.
    if len(t1) <= FRAGMENT_MAX:
        return "fragment"
    return "request"  # 애매하면 request — 잘못 만든 REQ는 s9 rm으로 제거 가능


def is_durable_question(text):
    """이 질문을 문서(QST)로 남기는가 — classify()와 별개의 축이다.

    분류는 '이 프롬프트가 무엇인가'를 말하고, 이 함수는 '남을 가치가 있는가'를
    말한다. 두 축을 한 값에 섞으면 분류 taxonomy가 흔들려 기존 경로가 함께
    깨진다. 제외: 즉석 인터랙션(출력·표시·대기 — 응답으로 완결된다)과
    짧은 확인 발화."""
    # 길이 판정도 첨부 줄을 빼고 센다 (REQ-20260826-034) — 경로 한 줄이
    # 짧은 확인 발화를 '남을 질문'으로 부풀린다.
    t = strip_attachment_refs(text).strip()
    if len(t) <= 40 and INTERACTION.search(t) and not PRODUCE.search(t):
        return False
    return len(t) >= QUESTION_DOC_MIN


def run(env, *argv, inp=None):
    return subprocess.run([*S9_ARGV, *argv], input=inp, capture_output=True,
                          encoding="utf-8", errors="replace", env=env, timeout=15)


def session_role(env):
    """이 세션 주체의 시스템 역할 — `s9 user current` → `s9 user role <name>`.
    실패·미등록이면 ""(강제하지 않는다 — 기존 흐름 그대로)."""
    try:
        cur = run(env, "user", "current")
        name = cur.stdout.strip().split()[0] if cur.returncode == 0 else ""
        if not name or name.startswith("("):
            return ""
        out = run(env, "user", "role", name)
        if out.returncode != 0:
            return ""
        m = re.search(r"role\s*=\s*(\w+)", out.stdout)
        return m.group(1) if m else ""
    except Exception:
        return ""


def prefs_context(env, who):
    """현재 요청 주체의 개인 선호(user config의 pref_* 키) → 주입 컨텍스트.
    말투·응답 형식·작업 방식 등 하네스 공통이 아닌 사용자별 설정 (REQ-20260824-006).
    없거나 조회 실패면 빈 문자열 — 기존 컨텍스트 불변."""
    name = (who or "").split()[0].strip()
    if not name or name.startswith("("):
        return ""
    out = run(env, "user", "config", name)
    if out.returncode != 0:
        return ""
    try:
        cfg = json.loads(out.stdout)
    except ValueError:
        return ""
    prefs = {k[5:]: str(v) for k, v in cfg.items()
             if k.startswith("pref_") and v}
    if not prefs:
        # 부재도 명시 지시로 (REQ-20260824-016): 침묵이면 LLM이 직전 대화의 말투
        # 관성을 따라가 '삭제가 안 먹는' 것처럼 보인다 — 기본 복귀를 지시한다.
        return (" ◈ 개인 설정: 없음 — 기본 말투·방식으로 응답하라 "
                "(직전 대화의 스타일 관성을 따르지 마라). ")
    body = " · ".join(f"{k}: {v}" for k, v in sorted(prefs.items()))
    return (f" ◈ 이 사용자의 개인 설정(응답 말투·작업 방식에 반영하라): {body}. ")


def workers_context(env):
    """지금 도는 무인 작업자를 리드 앞에 놓는다 (REQ-20260826-021).

    2026-08-26 21:42 사고: 리드가 web/index.html 을 커밋하면서 같은 파일을
    고치던 워커의 진행 중 편집을 함께 담았다. 결과는 문법적으로 멀쩡해 커밋도
    되고 서버도 뜨는 **반쪽 상태**였다 — 조용한 성공이 충돌보다 나쁘다.
    첫 고리는 단순했다: **리드는 그 워커의 존재를 몰랐다.**

    스폰 사실은 spawn.log 에 늘 있었다. 로그를 남기는 것과 보이게 하는 것은
    다른 일이고, 보이지 않는 것은 없는 것과 같다. 그래서 매 턴 주입한다.
    """
    w = run(env, "workers", "--quiet")
    if w.returncode != 0 or not w.stdout.strip():
        return ""
    return (f" ⚙ 지금 도는 무인 작업자:\n{w.stdout.strip()}\n"
            f"이 요청들의 파일을 리드가 함께 고치지 마라. 같은 파일을 만져야 "
            f"하면 커밋 전에 `git diff --cached` 로 **담기는 내용을 실제로 읽어라** "
            f"— `git add <경로>` 는 '내 변경'이 아니라 '그 파일의 지금 상태'를 "
            f"담는다. `git checkout`·`git stash`·`git reset` 은 쓰지 마라. ")


def stamp_tz(env=None, who=None):
    """표시 시간대 — $S9_TZ > 사용자 설정 timezone > 시스템 로컬 (REQ-20260828-024).

    전에는 UTC+9 를 상수로 들고 있었다. 설정에 `timezone` 이 이미 있고 대시보드는
    그것을 따르는데(`display_tz()`) 이 한 줄만 따로 놀았다 — 같은 물음에 답이
    둘이면 언젠가 갈린다. 못 읽으면 시스템 로컬로 물러선다: 시각 한 줄 때문에
    턴이 멈추면 안 된다.
    """
    name = (env or os.environ).get("S9_TZ") or ""
    if not name and who:
        try:
            out = run(env or dict(os.environ), "user", "config", who)
            if out.returncode == 0:
                name = (json.loads(out.stdout) or {}).get("timezone") or ""
        except Exception:
            name = ""
    if name:
        try:
            import zoneinfo
            return zoneinfo.ZoneInfo(name)
        except Exception:
            pass
    return None          # datetime.astimezone() 기본 = 시스템 로컬


def now_stamp(env=None, who=None):
    """지금 시각과 그 시간대 이름. 모델은 지금이 몇 시인지 모른다 — 매 턴 알려준다.

    **라벨도 함께 따라간다.** 시각만 바꾸고 "KST" 를 그대로 두면 틀린 시각을
    확신 있게 적는 꼴이라, 안 고친 것보다 나쁘다.
    """
    import datetime
    tz = stamp_tz(env, who)
    # tz 가 None 이면 `now(None)` 은 **naive** 라 %Z 가 빈 문자열이 된다 —
    # 라벨이 사라져 "시각만 있고 어느 시간대인지 모르는" 줄이 나간다.
    # astimezone() 으로 시스템 로컬을 붙여 준다.
    now = (datetime.datetime.now(tz) if tz
           else datetime.datetime.now().astimezone())
    return now.strftime("%Y-%m-%d %H:%M:%S"), (now.strftime("%Z") or "local")


def stamp_context(env=None, who=None):
    """응답 시각 헤딩 지시 (REQ-20260826-024). 규약은 PROTOCOL/에이전트 문서에
    있지만, **시각 자체는 주입하지 않으면 지어낼 수밖에 없다** — 그래서 매 턴
    실제 값을 함께 준다. 규칙과 재료를 한 자리에 두어야 지켜진다.

    다만 이 값은 **프롬프트가 도착한 때**다 (REQ-20260903-013). 모델이 도구를
    스무 번 부르고 답을 쓰면 그만큼 과거를 적게 되고, 사용자 눈에는 재지 않고
    지어낸 숫자로 보인다 — 실제로 같은 지적이 두 번 왔다. Stop 훅이 기록의
    도장은 바로잡지만(REQ-20260826-038) 화면에 이미 나간 글자는 못 고친다.
    그러니 값과 함께 **다시 재라는 지시와 재는 명령**을 준다.

    「실측」 같은 딱지는 붙이지 않는다 (REQ-20260903-014). 정확하면 표시가
    필요 없고, 표시는 그 값을 믿지 못할 때나 다는 것이다 — 딱지가 하는 일은
    의심을 덮는 것뿐이라 값이 틀어져도 계속 붙어 있는다. 라벨이 말해야 하는
    것은 「쟀다」가 아니라 **이 값이 무엇의 시각인가**다."""
    t, zone = now_stamp(env, who)
    t = f"{t} {zone}"
    # "해시 강조" = 커밋 해시가 받는 그 강조(인라인 코드) 라는 뜻이다.
    # 마크다운 제목(#)이 아니다 — 한 번 그렇게 읽어 `#` 이 화면에 그대로
    # 새어나왔다 (REQ-20260826-030 정정).
    return (f"◈ 이 턴이 도착한 시각 {t} — 이 응답은 반드시 "
            f"`[{t} - lead]` 꼴의 한 줄로 시작하라(백틱으로 감싼 인라인 코드 — "
            f"커밋 해시와 같은 강조다. 마크다운 제목 `#` 은 붙이지 마라). "
            f"**시각은 답을 쓰기 직전에 재라**: 도구를 한 번이라도 썼으면 "
            f"`{S9} now --as lead` 를 실행해 나온 줄을 그대로 머리에 놓아라 — "
            f"위 값은 프롬프트가 도착한 때라 그 사이 흐른 만큼 과거를 가리킨다. "
            f"도구를 하나도 쓰지 않는 즉답이면 위 값이 곧 그 시각이다. "
            f"어림짐작한 시각은 없느니만 못하다. "
            f"예외 없다(짧은 답·이어지는 답 포함). 이름은 리드가 직접 답할 때 "
            f"`lead`, 위임된 에이전트는 자기 역할명이다 — 누가 말하는지가 "
            f"보여야 위임 보고를 리드의 말과 구분할 수 있다. ")


_EMIT_ENV = None       # main 이 세션을 알게 되면 채워 넣는다


def turn_prefs():
    """이 턴에 실을 개인 설정 — **모든 경로가 지나는 자리에서** 만든다.

    분류마다 문자열을 따로 조립하던 때, `nothing`·`fragment` 와 시스템 통지
    턴에는 개인 설정이 아예 빠져 있었다(REQ-20260827-069). 하필 그 셋이 짧은
    대화 턴이라 **말투 설정이 가장 필요한 자리**였고, 사용자에게는 "저장했는데
    적용이 안 된다"로 보였다. 대시보드로 말하면 그 말은 시스템 통지로 도착한다 —
    즉 이 사용자의 평소 경로가 통째로 빠져 있었다.

    시각과 같은 성격이다: 규칙이 아니라 **재료**이고, 매 턴 함께 줘야 지켜진다.
    """
    # 캐시하지 않는다. 훅은 턴마다 새 프로세스라 아낄 것이 없고, 한 프로세스에서
    # 두 번 물으면 **먼저 읽은 값이 굳어** 방금 바꾼 설정이 안 먹는다 — 이 요청이
    # 고치려던 바로 그 증상을 캐시로 다시 만들 뻔했다(테스트가 잡았다).
    env = _EMIT_ENV or dict(os.environ)
    try:
        cur = run(env, "user", "current")
        who = cur.stdout.strip() if cur.returncode == 0 else ""
        return prefs_context(env, who) if who else ""
    except Exception:
        return ""


def _stamp_who():
    """시각 도장을 찍을 주체 — 실패하면 (None, None) 으로 시스템 로컬."""
    try:
        env = _EMIT_ENV or dict(os.environ)
        cur = run(env, "user", "current")
        who = cur.stdout.strip().split()[0] if cur.returncode == 0 else ""
        return env, (who or None)
    except Exception:
        return None, None


def emit(context):
    print(json.dumps({
        "suppressOutput": True,
        "hookSpecificOutput": {
            "hookEventName": "UserPromptSubmit",
            "additionalContext": (stamp_context(*_stamp_who())
                                  + turn_prefs() + context),
        },
    }, ensure_ascii=False))


def main():
    if os.environ.get("S9_AUDIT", "").lower() == "off":
        return
    data = json.load(sys.stdin)
    _detect_root(data)
    prompt = (data.get("prompt") or "").strip()
    # audit 대상이 아닌 턴(명령·시스템 통지)도 **응답은 한다** — 시각 헤딩 지시는
    # 그래서 여기서도 나간다. 규칙에 예외를 만들면 규칙이 곧 죽는다 (REQ-024).
    if not prompt or prompt.startswith("!") or is_command(prompt):
        emit("")
        return
    # 시스템 통지 턴(백그라운드 태스크 완료 등)은 사용자 요청이 아니다 — 카드 금지
    # (REQ-20260823-084: task-notification이 REQ로 오생성되던 결함)
    if prompt.startswith(("<task-notification>", "<system-reminder>",
                          "[SYSTEM NOTIFICATION")):
        emit("")
        return

    session = (data.get("session_id") or "unknown")[:8]
    env = dict(os.environ)
    env["S9_SESSION"] = session
    global _EMIT_ENV
    _EMIT_ENV = env
    first_line = prompt.splitlines()[0].strip()

    # attach 생존 신호 갱신 (REQ-20260824-041): SessionStart 시점의 attach_pid가
    # 낡으면(프로세스 교체 등) 유휴 5분 후 채팅 대상에서 빠져 Terminal 탭이
    # 'no live session'으로 오검출된다 — 매 프롬프트마다 재바인딩해 자가 치유.
    try:
        run(env, "bind", "attach_pid", str(_claude_pid()))
        run(env, "bind", "ended", "")
        tp = data.get("transcript_path") or ""
        if tp and os.path.exists(tp):
            run(env, "bind", "transcript_path", tp)  # 신생 세션 자가 치유
    except Exception:
        pass

    # auto-resume 스폰 턴 — 대상 REQ가 이미 존재한다. 새 카드를 만들면 안 되지만,
    # 세션 id와 클레임 지시는 반드시 주입해야 한다: 이게 없으면 스폰된 작업자가
    # 자기 sid를 몰라 클레임을 못 하고, 워처가 쿨다운마다 중복 스폰한다
    # (REQ-20260823-081 카드 방지 + REQ-20260824-004 클레임 결함).
    if os.environ.get("S9_AUTO_RESUME"):
        run(env, "log", f"auto-resume 재작업 턴: {first_line[:60]}")
        # 이 세션은 무인 워커다 — 사람과 대화하지 않는다 (REQ-20260826-031).
        # 워커는 `-p` 로 한 턴 돌고 끝나 수신함을 듣지 않고, SessionEnd 도
        # 남기지 않아 바인딩이 '아직 안 끝난 세션'으로 남는다. 그래서 채팅
        # 대상 고르기가 워커를 리드보다 앞세워 뽑았고, 사용자가 보낸 말이
        # 영원히 답하지 않을 창구로 갔다 — 화면은 그걸 idle 이라고 정직하게
        # 말했지만, 사용자가 물은 것은 "왜 하필 저 세션이냐"였다.
        run(env, "bind", "worker", "1")
        m = re.search(r"\bREQ-\d{8}-\d{3,}(?:-[0-9a-z]{4})?\b", prompt)
        target = m.group(0) if m else "<대상 REQ-id>"
        emit(
            f"[section9 audit] 자동 재작업 세션이다 — 이 세션의 식별자는 {session} 이다. "
            f"allowlist가 s9로 시작하는 명령만 허용하므로 환경변수 접두(S9_SESSION=...) 대신 "
            f"`--session {session}` 플래그를 써라. "
            f"**첫 행동으로 `s9 last {target} --add --session {session}` 을 실행해 "
            f"클레임하라** — 그래야 워처의 중복 스폰이 멈추고 대시보드 live 표시가 정합된다. "
            f"새 REQ 카드는 만들지 마라(대상 REQ가 이미 있다). 재작업 완료 시 "
            f"`s9 status {target} review --note '확인 포인트...'` 로 전이하라. "
            f"s9 = ~/section9/bin/s9")
        return

    # 기동 턴 (REQ-20260827-025): `s9 code` 가 넣은 줄이지 사람이 친 말이 아니다.
    # 카드도 서문도 만들지 않는다 — 세션 첫 화면을 훅 텍스트로 덮으면 사람이 읽을
    # 것이 사라지고, 없는 요청이 보드에 카드로 쌓인다. 바인딩 갱신(위 attach_pid)은
    # 이미 지났으므로 여기서 나가도 이 세션은 채팅 대상으로 제대로 잡힌다.
    if prompt.startswith(BOOTSTRAP_MARK):
        run(env, "log", "세션 기동 — 수신 대기 arm")
        run(env, "last", "--pause")   # 이 턴의 응답을 남의 REQ에 붙이지 않는다
        emit("")
        return

    # 답 캡처 포인터는 매 턴 초기화한다 — 질문 턴에서만 다시 세운다.
    # (놔두면 다음 턴의 응답이 지난 질문 문서에 붙어 오귀속된다.)
    run(env, "bind", "last_qst", "")

    cls = classify(prompt)
    # 유휴 중 쌓인 대시보드 채팅 — 분류와 무관하게 이번 턴에서 소화시킨다
    pend = pending_context(session, env)

    # 관찰 계정(viewer) 세션 (REQ-20260902-028): 자동 기록(REQ/QST/SES)을 만들지
    # 않고, "실제 요청이면 s9 new 로 직접 등록하라"는 정정 유도도 내지 않는다 —
    # 이 계정은 쓰지 못하므로 그 지시를 따르면 거부만 돌아온다. write_doc 가
    # 어차피 막지만, 막힐 명령을 부르고 결과를 버리는 것은 "조용히 안 만드는"
    # 것이 아니다. 시각 도장·개인 설정은 emit 이 늘 싣는다 — 여기도 예외 없다.
    if session_role(env) == "viewer":
        run(env, "last", "--pause")
        emit(pend +
            "[section9 audit] 이 세션의 주체는 관찰 계정(viewer)이다 — 요청·질문·"
            "세션 문서를 만들지 않았다. 이 계정은 문서를 만들거나 고치지 못한다"
            "(조회·검색·이력은 된다): `s9 new`·`status`·`note`·`assign` 을 부르지 "
            "말고, 등록이 필요한 일이면 프로젝트 구성원이나 admin 에게 넘겨라.")
        return

    if cls == "nothing":
        run(env, "log", f"note: {first_line[:40]}")
        run(env, "last", "--pause")  # 응답 캡처만 중지 — last_req는 유지(위임 캡처/스트림 활성 보존)
        # 수신함이 비어도 **반드시 내보낸다** (REQ-20260827-069). 예전엔 여기서
        # 조용히 빠져나가서 시각도 개인 설정도 안 실렸다 — 하필 잡담 턴이라
        # 말투 설정이 가장 필요한 자리였다. 규칙에 예외를 만들면 규칙이 곧 죽는다.
        emit(f"[section9 audit]{pend}" if pend else "")
        return

    if cls == "fragment":
        run(env, "log", f"note: {first_line[:40]}")
        run(env, "last", "--pause")
        emit(pend +
            f"[section9 audit] 이 프롬프트는 짧은 파편(Fragment)으로 분류되어 요청 문서를 "
            f"만들지 않았다 (세션 로그에만 기록). 실제 작업 요청이면 — "
            f"`S9_SESSION={session} s9 new request --title '20자 이내 명사구' "
            f"--summary '...' --size S|M|L --body '원문'` 으로 직접 등록하고 규약대로 "
            f"상태를 관리하라. s9 = ~/section9/bin/s9")
        return

    if cls == "question":
        run(env, "log", f"question: {first_line[:60]}")
        run(env, "last", "--pause")   # last_req 보존 + 응답 캡처만 중지
        # 남을 질문이면 문서로 (REQ-20260826-017): 답은 Stop 훅이 last_qst 를 보고
        # 자동으로 이 문서에 붙인다 — 사람에게 새 규율을 요구하지 않는 것이 핵심이다.
        # (그 규율 의존이 "답했는데 못 찾는" 사고를 만든 경로다.)
        qst = ""
        if is_durable_question(prompt):
            qbody = prompt
            qatts = attachment_paths(prompt, data.get("session_id") or "")
            if qatts:
                qbody += "\n\n[첨부]\n" + "\n".join(f"- {a}" for a in qatts)
            qtitle = first_line[:QUESTION_TITLE_MAX] + (
                "…" if len(first_line) > QUESTION_TITLE_MAX else "")
            qout = run(env, "new", "question", "--title", qtitle,
                       "--tag", "auto-audit", inp=qbody)
            if qout.returncode == 0 and qout.stdout.split():
                qst = qout.stdout.split()[0]
                run(env, "bind", "last_qst", qst)   # Stop 훅의 답 캡처 대상
                # 목록에도 쌓는다 (REQ-20260827-049) — 한 칸짜리 포인터는 답보다
                # 빨리 온 다음 질문에 덮여 앞 질문을 잃는다.
                run(env, "bind", "pending_qst", "--add", qst)
                run(env, "log", f"question {qst} 기록: {qtitle[:40]}")
        cur = run(env, "user", "current")
        who = cur.stdout.strip() if cur.returncode == 0 else "?"
        ro = run(env, "reopened", "--quiet")
        rewarn = ("" if ro.returncode != 0 or not ro.stdout.strip() else
                  f" ⚠ 대시보드에서 반려/재개된 요청 대기:\n{ro.stdout.strip()}\n답변 후 이어서 처리하라.")
        ut = run(env, "untitled", "--quiet")
        untitled = ("" if ut.returncode != 0 or not ut.stdout.strip() else
                f" ✎ 제목이 원문 그대로인 요청:\n{ut.stdout.strip()}\n"
                f"지금 `s9 set <id> --title '20자 이내 명사구' --summary ...` 로 "
                f"정리하라 — 착수 여부와 무관하게 접수 즉시 정리가 규약이다. ")
        wkwarn = workers_context(env)
        rv = run(env, "review", "--quiet")
        rvwarn = ("" if rv.returncode != 0 or not rv.stdout.strip() else
                  f" ⏳ 확인 대기(review):\n{rv.stdout.strip()}\n"
                  f"이 질문이 위 항목의 재작업 요청이면 먼저 `s9 status <id> in-progress` 전이 후 작업하라.")
        qmsg = (
            f"이 프롬프트는 Question 으로 분류되어 **{qst}** 로 기록되었다 "
            f"(요청 문서는 만들지 않았다). 이번 턴의 네 답변은 턴 종료 시 그 문서에 "
            f"`answer` 노트로 자동 기록된다 — 답을 채팅에만 남기지 마라. "
            f"이 질문이 특정 요청에서 나왔으면 `s9 link {qst} --relates <REQ>` 로 잇고, "
            f"**답이 앞으로의 작업을 구속하는 규칙이면** `s9 new knowledge` 로 승격한 뒤 "
            f"`s9 link <DOC> --derived-from {qst}` 로 출처를 남겨라 "
            f"(질문=사건, 지식=규칙 — 규칙 전문을 질문 문서에 복사하지 마라, "
            f"DOC-20260826-011). 남길 가치가 없는 질문이면 "
            f"`s9 rm {qst} --reason question` 으로 걷어라. "
            if qst else
            f"이 프롬프트는 Question 으로 분류되어 문서를 만들지 않았다 "
            f"(세션 로그에만 기록). 답이 나중에 다시 찾아질 만한 것이면 "
            f"`S9_SESSION={session} s9 new question --title '질문 원문' --body '원문'` "
            f"으로 남기고 답을 `s9 note <QST> --label answer` 로 붙여라. ")
        emit(pend +
            f"[section9 audit] {qmsg}현재 요청 주체: {who}.{untitled}{rewarn}{rvwarn}{wkwarn} "
            f"오분류라면 — 실제 작업 요청이면 — `S9_SESSION={session} s9 new request "
            f"--title '20자 이내 명사구' --summary '...' --size S|M|L --body '원문'` "
            f"으로 직접 등록하고 규약대로 상태를 관리하라. s9 = ~/section9/bin/s9")
        return

    # request
    title = first_line[:TITLE_MAX] + ("…" if len(first_line) > TITLE_MAX else "")
    # 첨부도 원문 (REQ-20260825-002): [Image #N] 참조를 캐시 실경로로 body에 보존
    body = prompt
    atts = attachment_paths(prompt, data.get("session_id") or "")
    if atts:
        body += "\n\n[첨부]\n" + "\n".join(f"- {p}" for p in atts)
    # 원문은 stdin으로 전달 (s9 new가 비-tty stdin을 body로 읽음 — /dev/stdin 불요, Windows 호환)
    out = run(env, "new", "request", "--title", title,
              "--tag", "auto-audit", "--origin", "human", inp=body)   # 사람 입구 (REQ-20260902-018)
    if out.returncode != 0:
        return  # audit 실패가 프롬프트를 막으면 안 됨
    doc_id = out.stdout.split()[0]
    run(env, "log", f"prompt {doc_id} 기록: {title}")
    run(env, "last", doc_id)  # Stop hook의 응답 캡처 대상
    cur = run(env, "user", "current")
    who = cur.stdout.strip() if cur.returncode == 0 else "?"

    # 대시보드에서 반려/재개된 요청 — 어떤 프롬프트가 오든 최우선 주입해 자동 재개
    ro = run(env, "reopened", "--quiet")
    reopened = ("" if ro.returncode != 0 or not ro.stdout.strip() else
                f" ⚠ 대시보드에서 반려/재개된 요청이 대기 중이다:\n{ro.stdout.strip()}\n"
                f"이번 턴에서 우선 이어서 작업하고 완료 시 전이하라 "
                f"(즉시 처리 불가면 사유를 note로 남기고 blocked 전이). ")
    # 클레임해 놓고 멈춘 것 (REQ-20260827-046). 대시보드는 회색 점으로 정직하게
    # 표시하지만 그건 **사람이 화면을 볼 때만** 보인다 — 리드는 화면을 안 본다.
    # 반려 목록과 같은 자리에 같은 방식으로 놓는다: 표식이 아니라 주입이라야
    # 실제 장치가 된다(REQ-20260825-062에서 배운 것).
    # 고칠 명령이 분명한 것만 좁게 (REQ-20260828-005). 넓은 목록은 훑고
    # 넘어가게 된다 — 실제로 그렇게 네 건을 몇 시간씩 방치했다.
    lo = run(env, "loose", "--quiet")
    loose = ("" if lo.returncode != 0 or not lo.stdout.strip() else
             f" ⚑ 한 줄이면 닫히는 것이 있다:\n{lo.stdout.strip()}\n"
             f"**다른 일을 시작하기 전에** 이 줄들을 실행하라. 상태가 거짓이면 "
             f"보드 전체가 거짓이 된다. ")
    st = run(env, "stalled", "--quiet")
    stalled = ("" if st.returncode != 0 or not st.stdout.strip() else
               f" ⛔ 착수해 놓고 진전이 멈춘 요청이 있다 — 내가 잡아 놓고 손을 뗀 "
               f"것이다. 보드에는 '진행 중'으로 보이지만 아무도 일하지 않는다:\n"
               f"{st.stdout.strip()}\n"
               f"**다른 일을 시작하기 전에** 이어서 하거나, 못 이어가면 그 사유를 "
               f"note 로 남기고 blocked/review 로 옮겨라. 상태가 거짓이면 보드 전체가 "
               f"거짓이 된다. ")
    # 돌고 있는 서버가 옛 코드인가 (REQ-20260827-059). 고쳐 커밋해도 서버 안에서
    # 도는 것(채팅 수신·질문 등록·API)은 재기동 전까지 옛 코드다. 대시보드 배너는
    # 그 사실을 띄우지만 **사람이 화면을 볼 때만** 보인다 — 리드는 화면을 안 본다.
    sv = run(env, "serve-stale")
    stale_serve = ("" if sv.returncode != 0 or not sv.stdout.strip() else
                   f" ♻ {sv.stdout.strip()} ")
    # 동기화가 5분 넘게 밀렸는가 (REQ-20260902-025) — 같은 멈춤에 1회만. 밀린
    # 커밋은 이 세션의 문서가 남에게 안 보인다는 뜻인데, 그 사실은 여태
    # state/sync.log 한 줄에만 있었다 — 리드는 로그를 안 본다.
    sy = run(env, "sync", "--status", "--quiet")
    sync_late = ("" if sy.returncode != 0 or not sy.stdout.strip() else
                 f" ◈ 동기화 지연: {sy.stdout.strip()} ")
    # 미확인 승인 메모 — 질문·후속 지시가 담겼을 수 있다: 리드가 이번 턴에 소화 (1회 주입)
    ap = run(env, "approvals", "--quiet")
    approvals = ("" if ap.returncode != 0 or not ap.stdout.strip() else
                 f" 🆗 방금 승인 처리된 요청의 메모:\n{ap.stdout.strip()}\n"
                 f"메모가 질문이면 이번 응답에서 답하고, 후속 작업을 지시·함의하면 "
                 f"`s9 new request --parent <그 REQ>` 로 등록해 즉시 착수하라 "
                 f"(검토 승인 = 구현 착수 신호). ")
    # blocked 대기 항목 — '패치 적용 대기'는 리드(권한 세션)가 즉시 처리해야 한다
    bl = run(env, "blocked", "--quiet")
    blocked = ("" if bl.returncode != 0 or not bl.stdout.strip() else
               f" ⛔ 대기(blocked) 요청:\n{bl.stdout.strip()}\n"
               f"사유가 '패치 적용 대기'면 이 세션(정상 권한)이 지금 문서의 patch 노트를 "
               f"적용·검증하고 in-progress→review로 전이해 블락을 풀어라. ")
    # review 대기 항목 — 이 프롬프트가 그에 대한 피드백/재작업일 수 있다
    ut = run(env, "untitled", "--quiet")
    untitled = ("" if ut.returncode != 0 or not ut.stdout.strip() else
                f" ✎ 제목이 원문 그대로인 요청:\n{ut.stdout.strip()}\n"
                f"지금 `s9 set <id> --title '20자 이내 명사구' --summary ...` 로 "
                f"정리하라 — 착수 여부와 무관하게 접수 즉시 정리가 규약이다. ")
    rv = run(env, "review", "--quiet")
    review = ("" if rv.returncode != 0 or not rv.stdout.strip() else
              f" ⏳ 확인 대기(review) 요청:\n{rv.stdout.strip()}\n"
              f"이 프롬프트가 위 항목에 대한 피드백이면: 승인 의미면 `s9 status <id> done`, "
              f"재작업 요청이면 **먼저 `s9 status <id> in-progress`로 전이한 뒤** 작업하라. "
              f"review 상태로 방치하거나 새 REQ로 우회해 상태를 흐리지 마라 (재작업은 원 REQ에서). ")

    wkwarn = workers_context(env)

    warn = ""
    if "os-account" in who:  # 바인딩/env 없이 OS 계정 fallback으로 잡힌 경우
        name = who.split()[0]
        registered = run(env, "user", "role", name).returncode == 0
        if registered:
            warn = (f" (주체는 OS 계정 fallback — 이 세션을 명시 바인딩하려면 "
                    f"`s9 user switch {name}`.)")
        else:
            warn = (" 주의: 현재 주체가 미등록 OS 계정 fallback이다 — `s9 user add` 후 "
                    "`s9 user switch` 로 등록 사용자를 지정하라.")
    attnote = (f"첨부 {len(atts)}건이 body에 기록되었다. " if atts else "")
    emit(pend +
        f"[section9 audit] 이 프롬프트는 {doc_id} 로 자동 기록되었다 (Request 분류). {attnote}"
        f"현재 요청 주체: {who}.{warn}{untitled}{approvals}{reopened}{loose}{stalled}{stale_serve}{sync_late}{blocked}{review}{wkwarn} "
        f"이 세션에서 s9 를 호출할 때는 반드시 `S9_SESSION={session}` 을 앞에 붙여라. 규약: "
        f"(1) 제목은 원문 복사가 아니라 20자 이내의 이해하기 쉬운 명사구로 교체하라 — "
        f"`s9 set {doc_id} --title '...' --summary '...' --size S|M|L "
        f"--goal '무엇이 충족되면 완료인지 판별 가능한 한 문장' [--project ...]`. "
        f"**goal 없는 요청은 done 전이가 거부된다** (REQ-20260824-030). "
        f"(2) 관계는 `s9 link {doc_id} --parent/--relates/--tag` 로 연결하라. "
        f"프롬프트에 서로 다른 작업 요청이 여러 개 섞여 있으면 {doc_id} 를 주 요청으로 두고 "
        f"나머지는 `s9 new request --parent {doc_id}` 로 각각 분리 등록해 개별 상태로 관리하라. "
        f"분리 등록한 파생 REQ 중 이번에 실제로 처리할 것은 open으로 방치하지 말고 즉시 `s9 status <id> in-progress` 로 착수하라 — 필요한 파생 작업의 진행에 별도 지시를 기다리지 마라. "
        f"(3) 착수 시 in-progress, 완료 시 done, 확인 대기면 review 로 `s9 status` 전이하고 --note 를 남겨라. "
        f"done의 --note에는 **goal 대비 충족 근거**를 반드시 담아라. "
        f"**검증된 것은 done, 방향만 review**: TDD·실브라우저 등 객관적 검증을 마친 구현은 review에 쌓지 말고 바로 done 하라(문제 시 사용자가 반려→자동재개). review는 사용자의 주관적 판정(취향·방향·불확실)이 필요한 것만. 사람을 승인 기계로 만들지 마라. "
        f"review로 보낼 때는 --note에 **무엇을·왜 봐야 하는지 확인 포인트**를 반드시 담아라(예: `s9 status <id> review --note '헤더 정렬 방식 A/B 중 선택 필요'`) — 그래야 사용자가 무엇을 판정할지 안다. "
        f"개발/구현 요청이면 코드 착수 전 TDD 시나리오(정상/경계/실패/회귀)를 `s9 note {doc_id} --label tdd` 로 문서에 먼저 작성하고, UI 변경이면 실브라우저로 검증하라(WSL은 `s9 shot <url>` 로 스크린샷 후 확인). "
        f"(4) 실제로는 단순 질문/응답이면 `s9 rm {doc_id} --reason question` 으로 제거하라. "
        f"(5) 주체 변경 요청 시 `s9 user switch <이름>` (미등록이면 s9 user add 먼저). "
        f"(6) 재사용할 지식은 `s9 new knowledge` 로 남겨라. "
        f"(7) 사용자가 말투·응답 형식·작업 방식 선호를 말하면 즉시 "
        f"`s9 user config <이름> pref_<주제> '<내용>'` 으로 저장하라 — 다음 턴부터 "
        f"모든 프롬프트에 개인 설정으로 자동 주입된다 (삭제 = 빈 값). s9 = ~/section9/bin/s9")


if __name__ == "__main__":
    try:
        main()
    except Exception:
        sys.exit(0)  # never block the user's prompt
