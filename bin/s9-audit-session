#!/usr/bin/env python3
"""section9 session audit hook (Claude Code SessionStart / SessionEnd).

usage: s9-audit-session start|end|compact-start|compact-end   (stdin: hook JSON)

세션 시작/종료 이벤트를 해당 세션의 SES 문서 History에 기록한다.
SES 문서는 s9 log가 세션당 하나를 lazy 생성하고 바인딩(ses_doc)에 연결한다.

원칙: 실패 시 조용히 exit 0 — 세션 흐름을 막지 않는다.
비활성화: 환경변수 S9_AUDIT=off
"""
import json
import os
import subprocess
import sys

S9 = os.path.join(os.path.dirname(os.path.abspath(__file__)), "s9")
STOP_HOOK = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                         "s9-audit-response")


def mirror(tp):
    """세션 시작·종료의 미러도 **매 턴 미러와 같은 함수**를 쓴다.

    종전엔 이 자리만 `shutil.copyfile` 로 전체를 다시 썼다. 결과가 둘이었다
    (REQ-20260827-077): ① 사용자가 대화 기록을 꺼도(REQ-20260827-042) 여기는
    스위치를 보지 않아 **세션마다 전체 사본이 생겼다** — 껐다고 믿는 상태에서
    남는 기록이 제일 나쁘다. ② "늘어난 만큼만 쓴다"(REQ-20260827-039)도 여기엔
    없어 8MB 세션이면 시작·종료에 각각 8MB 를 다시 썼다.

    구현을 베껴 오지 않고 **불러 쓴다** — 두 벌이 되면 한쪽만 고쳐지는 것이
    시간 문제고, 위 결함이 바로 그렇게 생겼다.
    반환: mirror_transcript 의 판단("full"|"append"|"skip"|"off"|"")."""
    try:
        import importlib.machinery
        import importlib.util
        spec = importlib.util.spec_from_loader(
            "s9_audit_response",
            importlib.machinery.SourceFileLoader("s9_audit_response",
                                                 STOP_HOOK))
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod.mirror_transcript(tp)
    except Exception:
        return ""       # 미러 실패가 세션 기록을 막지 않는다




# 훅은 독립 실행 파일이라 s9 의 프로세스 조회를 로컬 복제한다. 복제는
# 갈라지므로, 갈라지지 않는지를 시험이 못박는다 (tests/test_platform_live.py).
# 갈래가 여기 없으면 맥에서 조용히 틀린다: `/proc` 은 리눅스에만 있다
# (REQ-20260829-037).
def _proc_backend():
    forced = (os.environ.get("S9_PROC_BACKEND") or "").strip()
    if forced in ("proc", "ps", "win", "none"):
        return forced
    if os.path.isdir("/proc/self"):
        return "proc"
    return "win" if os.name == "nt" else "ps"


# 윈도우 갈래 — `/proc` 도 `ps` 도 없는 자리에서 프로세스 목록을 주는 것은
# PowerShell 의 CIM 조회다 (s9._win_table 의 로컬 복제). 훅은 프롬프트마다
# 도는 데다 조상 체인을 열 걸음 올라가므로, **이 프로세스 안에서 한 번만**
# 묻고 캐시한다 — 매번 물으면 열 번 프로세스를 띄운다.
_WIN_ROWS = {}          # {pid: (실행 파일 이름, 부모 pid, 명령줄)}
_WIN_READ = [False]
WIN_PS_SCRIPT = ("Get-CimInstance Win32_Process | ForEach-Object { "
                 "$c = $_.CommandLine; if (-not $c) { $c = $_.Name }; "
                 "[string]$_.ProcessId + ' ' + [string]$_.ParentProcessId "
                 "+ ' ' + $c }")


def _win_head(cmd):
    head = (cmd or "").strip()
    if not head:
        return ""
    if head.startswith('"'):
        head = head[1:].split('"', 1)[0]
    else:
        head = head.split(" ", 1)[0]
    return os.path.basename(head.replace("\\", "/"))


def _win_rows():
    """이름을 먼저 찾아보지 않고 **불러 본다**. `shutil` 을 들이지 않으려는
    것이기도 하고(이 훅은 자기 복사 구현을 되찾지 않기로 한 파일이다),
    있는지 묻는 것보다 되는지 보는 편이 짧기도 하다 — PATH 에 있어도 실행
    정책에 막히면 어차피 빈손이다."""
    if _WIN_READ[0]:
        return _WIN_ROWS
    _WIN_READ[0] = True
    out = ""
    for exe in ("powershell", "pwsh"):
        try:
            out = subprocess.run([exe, "-NoProfile", "-NonInteractive",
                                  "-Command", WIN_PS_SCRIPT],
                                 capture_output=True, text=True,
                                 timeout=25).stdout or ""
        except Exception:
            continue
        if out.strip():
            break
    for ln in out.splitlines():
        c = ln.strip().split(None, 2)
        if len(c) == 3 and c[0].isdigit() and c[1].isdigit():
            _WIN_ROWS[int(c[0])] = (_win_head(c[2]), int(c[1]), c[2].strip())
    return _WIN_ROWS


def _proc_info(pid):
    """(실행 파일 이름, 부모 pid) — 모르면 ("", 0)."""
    if _proc_backend() == "proc":
        try:
            with open(f"/proc/{pid}/comm") as f:
                comm = f.read().strip()
            with open(f"/proc/{pid}/status") as f:
                for ln in f:
                    if ln.startswith("PPid:"):
                        return comm, int(ln.split()[1])
            return comm, 0
        except (OSError, ValueError):
            return "", 0
    if _proc_backend() == "none":
        return "", 0
    if _proc_backend() == "win":
        r = _win_rows().get(int(pid))
        return (r[0], r[1]) if r else ("", 0)
    try:
        out = subprocess.run(["ps", "-o", "ppid=,comm=", "-p", str(pid)],
                             capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return "", 0
    c = out.strip().split(None, 1)
    if len(c) == 2 and c[0].isdigit():
        # BSD 의 comm 은 절대경로다 — 이름만 뗀다.
        return os.path.basename(c[1].strip()), int(c[0])
    return "", 0


# claude 를 실어 나르는 런타임들 — 맥에서 어떤 것으로 깔았는지 우리가 고를 수
# 없으므로 이름을 좁게 잡으면 그 기계에서만 조용히 어긋난다.
CLAUDE_COMMS = ("claude", "node", "bun", "deno")


def _exe_name(comm):
    """`node.exe` → `node` — s9.exe_name 의 로컬 복제. 이름을 그대로 견주면
    윈도우에서 조상 체인이 중간 셸에서 멈추고, 그 셸의 pid 가 `attach_pid`
    로 적힌다 (맥에서 났던 그 사고와 같은 모양)."""
    c = (comm or "").strip()
    return c[:-4] if c.lower().endswith(".exe") else c


def _pid_alive(pid):
    """그 pid 가 살아 있는가 — s9.pid_alive 의 로컬 복제.
    윈도우 파이썬의 os.kill 은 시그널 0 에도 죽이므로 posix 에서만 쓴다."""
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return False
    if pid <= 0:
        return False
    if _proc_backend() == "proc":
        return os.path.exists(f"/proc/{pid}")
    if _proc_backend() == "win":
        return int(pid) in _win_rows()
    if _proc_backend() == "none" or os.name != "posix":
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False


def _claude_pid():
    """이 훅을 실행한 claude 프로세스 pid — getppid는 소멸성 중간 셸일 수 있어
    (REQ-20260824-065: 신생 유휴 세션이 attach 죽음+활동 0으로 미검출)
    조상 체인을 걸어 올라가 comm이 claude/node인 첫 프로세스를 잡는다.

    이 값이 바인딩의 `attach_pid` 가 된다. 맥에서는 `/proc` 이 없어 첫 판독이
    곧바로 실패했고, **언제나 중간 셸의 pid 가 적혔다** — 그 셸은 곧 죽으니
    생존·계정·중단·재시작이 전부 그 하나 때문에 틀렸다 (REQ-20260829-037).
    """
    pid = os.getppid()
    for _ in range(10):
        if pid <= 1:
            break
        comm, ppid = _proc_info(pid)
        if _exe_name(comm) in CLAUDE_COMMS:
            return pid
        if not ppid:
            break
        pid = ppid
    return os.getppid()

def _detect_root(data):
    """세션 cwd가 s9 리포(인스턴스)면 그 루트를 S9_ROOT로 승격 — 한 머신에서
    업스트림 카피와 인스턴스를 병행할 때 기록이 세션 위치를 따라간다
    (REQ-20260824-053). 명시된 S9_ROOT가 항상 우선."""
    if os.environ.get("S9_ROOT"):
        return
    cwd = (data.get("cwd") or "").strip()
    if cwd and os.path.exists(os.path.join(cwd, "bin", "s9")) \
            and os.path.isdir(os.path.join(cwd, "vault")):
        os.environ["S9_ROOT"] = cwd


def _sweep_orphans(root):
    """세션 시작 시 고아 캡처·테스트 서버 회수 (REQ-20260825-099).

    회수는 serve 의 감시 틱이 1분마다 돌지만, **serve 가 죽어 있는 동안에는
    아무도 거두지 않는다** — 2026-08-25 사고 직전이 정확히 그 구간이었다.
    세션 시작은 그 공백을 메우는 자연스러운 체크포인트다. 비동기로 던지고
    결과를 기다리지 않는다(세션 시작을 늦추면 안 된다)."""
    tool = os.path.join(root, "bin", "s9-doctor")
    if not os.path.exists(tool):
        return
    try:
        subprocess.Popen([sys.executable, tool, "--sweep"],
                         stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except Exception:
        pass      # 회수 실패가 세션을 막으면 안 된다


def _serve_port_wanted(root):
    """훅이 서버를 세워도 되는 자리인가 — 세운다면 어느 포트인가
    (REQ-20260830-033). 반환: 세울 포트(int) 또는 0(세우지 않음).

    잣대는 bin/s9 serve_stamp_wanted 와 같다: "이 포트가 이 저장소의 규범
    포트인가"(REQ-20260830-005). 훅은 독립 실행 파일이라 판정을 최소로
    복제하고, 갈라지지 않음은 계약 시험이 못박는다
    (tests/test_serve_stale.py HookServeGuard.G5 — _proc_backend 선례).

    S9_PORT env 는 S9_ROOT 와 짝일 때만 이 저장소의 것이다. 짝 없이 새어든
    S9_PORT(시험·다른 워크스페이스 봉투의 잔재)로 본 저장소에 서버를 세우면
    규범 아닌 포트에 프로세스가 뜨고 그 서버는 자기 포트를 규범으로 알아
    지문까지 남긴다 — 005 가 막은 거짓 지문 계열의 남은 문. 그때는 0 을
    돌려주고 부르는 쪽은 조용히 건너뛴다(훅은 시끄러우면 안 된다).
    쓰레기 S9_PORT 는 s9_port 와 같은 규율로 무시하고 규범 포트로 간다."""
    try:
        with open(os.path.join(root, "state", "port")) as f:
            canon = int(f.read().strip())
    except (OSError, ValueError):
        canon = 9909
    try:
        port = int(os.environ.get("S9_PORT") or "")
    except ValueError:
        return canon
    if os.environ.get("S9_ROOT") or port == canon:
        return port
    return 0


def ensure_serve():
    """대시보드 **감시자** 보장 (REQ-20260824-020 → REQ-20260825-096).

    예전엔 여기서 포트를 재보고 죽어 있으면 서버를 직접 띄웠다. 그러면 세션이
    시작될 때만 복구되고, 세션 도중 죽으면 사람이 접속 거부를 겪을 때까지
    아무도 살리지 않았다(2026-08-25 22:19). 이제는 감시자를 세운다 —
    감시자가 서버를 띄우고, 죽으면 사유를 남기고 백오프를 두고 되살린다.
    `serve --supervise` 는 멱등이라 이미 감시 중이면 곧바로 물러난다. 이 훅이
    메우는 것은 감시자까지 함께 사라지는 경우(WSL 재시작)다."""
    root = os.environ.get("S9_ROOT") or os.path.dirname(
        os.path.dirname(os.path.realpath(__file__)))
    _sweep_orphans(root)
    port = _serve_port_wanted(root)
    if not port:
        return    # 남의 봉투 포트 — 규범 아닌 자리에는 세우지 않는다 (033)
    try:
        os.makedirs(os.path.join(root, "state"), exist_ok=True)
        lf = open(os.path.join(root, "state", "serve.log"), "a")
        subprocess.Popen([S9, "serve", "--supervise", "--port", str(port)],
                         stdin=subprocess.DEVNULL, stdout=lf, stderr=lf,
                         start_new_session=True)
    except Exception:
        pass  # 서버 기동 실패가 세션을 막으면 안 됨


def ensure_metrics():
    """상시 계기 보장 (REQ-20260902-054).

    바깥 스케줄러를 쓰지 않기로 한 저장소라(REQ-20260825-096), 계기도 제 발로
    선다. `s9 metrics start` 는 잠금 하나로 멱등이니 세션마다 불려도 둘째가
    뜨지 않는다. 이 훅이 메우는 자리는 **기계가 재시작돼 수집기까지 사라진
    경우**다 — 그 사이의 공백은 기록의 부팅 표식으로 드러난다."""
    root = os.environ.get("S9_ROOT") or os.path.dirname(
        os.path.dirname(os.path.realpath(__file__)))
    try:
        subprocess.Popen([S9, "metrics", "start"],
                         stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         cwd=root, start_new_session=True)
    except Exception:
        pass  # 계기 기동 실패가 세션을 막으면 안 된다


def main():
    if os.environ.get("S9_AUDIT", "").lower() == "off":
        return
    event = sys.argv[1] if len(sys.argv) > 1 else "event"
    data = json.load(sys.stdin)
    _detect_root(data)
    session = (data.get("session_id") or "unknown")[:8]
    env = dict(os.environ)
    env["S9_SESSION"] = session

    if event in ("compact-start", "compact-end"):
        # 압축 중에는 응답이 한동안 멎는다. 대시보드만 보는 사람에게 그 침묵은
        # **고장과 구분되지 않는다** — 이유를 말해 주지 않으면 고장으로 읽힌다
        # (REQ-20260827-065). 시각을 넣어 두는 것은 압축이 끝 훅 없이 죽었을 때
        # 표시가 영영 붙어 있지 않게 하기 위해서다.
        from datetime import datetime
        val = (datetime.now().astimezone().isoformat(timespec="seconds")
               if event == "compact-start" else "")
        for argv in (["bind", "compacting", val],
                     ["log", f"context {event}"
                      + (f" [{data.get('trigger', '')}]"
                         if data.get("trigger") else "")]):
            try:
                subprocess.run([S9, *argv], capture_output=True, text=True,
                               env=env, timeout=10)
            except Exception:
                pass
        return

    tp = data.get("transcript_path")
    if tp and os.path.exists(tp):
        # live tail + resume용: 원본 경로·cwd를 바인딩에 기록
        subprocess.run([S9, "bind", "transcript_path", tp],
                       capture_output=True, text=True, env=env, timeout=10)
        subprocess.run([S9, "bind", "cwd", data.get("cwd", "")],
                       capture_output=True, text=True, env=env, timeout=10)
        # 세션 시작/종료 시 스트림 미러링 — 파일명=원본 basename(전체SID.jsonl).
        # 끄기 스위치와 증분 쓰기는 mirror() 안쪽(=매 턴 미러와 같은 코드)이 본다.
        mirror(tp)

    detail = data.get("source") or data.get("reason") or ""
    cwd = data.get("cwd") or ""
    text = f"session {event}" + (f" [{detail}]" if detail else "")
    if cwd:
        text += f" cwd={cwd}"
    subprocess.run([S9, "log", text], capture_output=True, text=True,
                   env=env, timeout=15)

    if event == "end":
        # 종료 세션은 채팅 자동 대상에서 제외 (REQ-20260824-032)
        try:
            subprocess.run([S9, "bind", "ended", "1"],
                           capture_output=True, text=True, env=env, timeout=10)
        except Exception:
            pass

    dual_warn = ""
    chat_ctx = ""
    if event == "start":
        ensure_serve()  # 대시보드가 죽어 있으면 세션 시작이 되살린다 (REQ-020)
        ensure_metrics()  # 계기가 끊겨 있으면 여기서 다시 선다 (REQ-054)
        # 이 사람이 어느 머신에서 어느 OS 계정으로 일하는지 스스로 적는다
        # (REQ-20260827-066). 손으로 attach 할 때만 남기면 기록이 늘 뒤처진다.
        try:
            subprocess.run([S9, "user", "seen"], capture_output=True,
                           text=True, env=env, timeout=10)
        except Exception:
            pass
        # 프로젝트 에이전트 동기화 (REQ-20260824-038): projects/*/agents/*.md →
        # .claude/agents/<slug>--이름.md — 이 세션부터 네이티브 subagent로 로드된다
        try:
            subprocess.run([S9, "project", "agents", "sync"],
                           capture_output=True, text=True, env=env, timeout=15)
        except Exception:
            pass
        # 대시보드 채팅 수신함 (REQ-20260824-032): 세션별 inbox 파일을 만들어 두고
        # Monitor(tail) arming을 지시 — 대시보드가 append하면 세션이 즉시 깨어난다.
        # REQ-20260825-001: 세션 유휴(tail 미가동) 중 쌓인 미처리 줄은 여기서
        # 직접 컨텍스트로 주입하고, arm은 현재 EOF 오프셋부터(tail -c +N -f) —
        # tail 기본 -n 10의 우연한 replay에 기대던 유실 경로를 없앤다.
        try:
            root = os.environ.get("S9_ROOT") or os.path.dirname(
            os.path.dirname(os.path.realpath(__file__)))
            inbox = os.path.join(root, "state", "terminal",
                                 f"inbox-{session}.jsonl")
            # 미처리 줄 + 다른 세션에 갇힌 고아 줄을 한 번에 (REQ-20260826-023).
            # 커서(.seen) 전진 = 소비이므로 호출은 정확히 1회여야 한다.
            ib = subprocess.run([S9, "inbox", "--sid", session],
                                capture_output=True, text=True, env=env,
                                timeout=15)
            info = json.loads(ib.stdout or "{}")
            size = int(info.get("size") or 0)
            pending = list(info.get("pending") or [])
            orphans = list(info.get("orphans") or [])
            chat_ctx = (
                f"◈ 대시보드 채팅 수신함: {inbox}\n"
                f"Monitor 도구가 있으면 지금 `tail -c +{size + 1} -f {inbox}` 를 "
                f"persistent로 arm하라(없으면 이 지시는 무시). 이벤트로 도착하는 "
                f"JSON 줄 처리: kind=chat 은 대시보드에서 사용자가 보낸 "
                f"실메시지다 — 사용자 메시지로 간주해 즉시 응답하라(응답은 "
                f"평소대로 하면 대시보드 스트림 뷰에 보인다). 줄에 req 필드가 "
                f"있으면 그 프롬프트는 이미 해당 REQ로 기록돼 있다 — 새 REQ를 "
                f"만들지 말고 그 id로 상태를 관리하되, **제목이 원문 그대로면 "
                f"착수 시 반드시 `s9 set <id> --title '20자 이내 명사구' "
                f"--summary ...` 로 교체하라** (REQ-20260825-035: 원문 제목 "
                f"방치 금지). 줄에 review_refs 필드가 있으면 그 문서들이 판정 "
                f"대기(review) 중인데 이 메시지가 그에 대한 지적일 수 있다 — "
                f"**반려성 지적이면 답하기 전에 먼저 `s9 status <그 id> "
                f"in-progress --note '채팅 반려: <요지>'` 로 전이하고 재작업하라** "
                f"(REQ-20260825-041: 채팅 반려가 상태에 반영되지 않던 공백). "
                f"**줄에 agent 필드가 있으면 그 메시지는 너에게 온 것이 "
                f"아니라 그 서브에이전트에게 지목된 것이다 — 직접 답하지 말고 "
                f"SendMessage(to=<그 agentId>)로 중계하라. 중계 문구에는 "
                f"'지금 하던 작업을 마치고 반영하라'는 규율을 반드시 덧붙여 "
                f"진행 중인 작업이 흔들리지 않게 하고, 중계 직후 사용자에게 "
                f"'<타입>에게 전달했다' 한 줄로 알려라. 대상이 이미 종료됐거나 "
                f"찾을 수 없으면 그 사실을 알리고 리드가 대신 처리할지 물어라. "
                f"중계한 지시는 `s9 note <REQ> --label response` 로 문서에 "
                f"남겨 감사 공백을 만들지 마라** (REQ-20260825-095: 지목 전송). "
                f"관계는 3층으로 기록하라 — parent(주 계보 1개)·derived_from"
                f"(다른 요청의 요구를 흡수했을 때)·relates(동급, 양방향 자동). "
                f"다중 부모 금지(DOC-20260825-002). "
                f"**사용자 판단이 필요한 사안은 채팅으로 묻지 마라 — 문서를 "
                f"review로 전이해 확인 포인트로 올려야 사용자가 놓치지 않는다. "
                f"스스로 결정 가능한 것은 묻지 말고 결정하라** (REQ-20260825-051 "
                f"인접 지적: 채팅 질문은 지나가는 로그로 유실된다). "
                f"kind=interrupt 는 "
                f"사용자의 중단 요청(Esc)이다 — 진행 중 작업을 즉시 멈추고 "
                f"상태를 보고하라. **req 필드가 실린 interrupt 는 그 문서를 "
                f"지목한 중단이다 — 그 문서의 작업만 멈추고, 진행 상태를 "
                f"`s9 note <그 id> --label response` 로 보고한 뒤 "
                f"`s9 claim <그 id> --release --reason '사용자 중단'` 으로 "
                f"클레임을 해제하라(다른 작업은 계속한다). agent 필드가 함께 "
                f"있으면 그 위임 에이전트의 몫이다 — TaskStop 으로 그 작업을 "
                f"세우고 같은 보고·해제를 하라** (REQ-20260830-035: 모든 "
                f"진행이 세워진다). kind=event 는 전이 통지다 — 반려면 즉시 "
                f"재작업 착수, 승인 메모면 후속 처리. Monitor 타임아웃 알림이 "
                f"오면 그 시점 파일 크기 오프셋으로 다시 arm하라. "
                f"**이 arm·재arm은 세션 내부 정비다 — 조용히 수행하고 "
                f"사용자에게 보고하지 마라** (REQ-20260825-047: 모델 변경 "
                f"재시작 직후 '수신함 감시를 다시 연결했다' 류 정비 보고가 "
                f"사용자 화면에 노이즈로 노출됐다). 재시작 진행·완료 표시는 "
                f"대시보드가 담당한다. 정비 중 발견한 미처리 메시지가 있으면 "
                f"그 내용에만 응답하라.")
            if pending:
                shown = pending[-50:]
                chat_ctx += (
                    f"\n◈ 세션 유휴 중 도착한 미처리 수신 메시지 {len(pending)}건"
                    f"{f' (최근 {len(shown)}건 표시)' if len(shown) < len(pending) else ''}"
                    f" — 지금 사용자 메시지로 간주해 처리하라:\n"
                    + "\n".join(shown))
            if orphans:
                # 다른 세션 수신함에 갇혀 있던 사용자 메시지 (REQ-20260826-023).
                # 대시보드의 대상 선택이 옮겨가면 그 파일은 아무도 다시 보지
                # 않는다 — 실사고: "011 진행이 왜 멈췄지?" 가 그렇게 유실됐다.
                # **언제 어느 세션 것인지 함께 보여야 한다**: 리드가 지금 온
                # 말로 착각하면 이미 지난 맥락에 엉뚱하게 답한다.
                n = sum(len(g["lines"]) for g in orphans)
                body = []
                for g in orphans:
                    for l in g["lines"]:
                        body.append(f"  - [{l.get('ts', '?')} · 세션 "
                                    f"{g['sid']}] {l.get('text', '')}")
                chat_ctx += (
                    f"\n◈ 다른 세션 수신함에 갇혀 있던 미전달 메시지 {n}건 — "
                    f"대상 세션이 수신 대기를 돌리지 않아 소화되지 못했다. "
                    f"**시각을 보고 아직 유효한 것만** 사용자 메시지로 처리하고, "
                    f"이미 지난 것이면 그 사실을 한 줄로 알려라:\n"
                    + "\n".join(body))
        except Exception:
            pass
        # 동일 세션 이중 접속 감지 (REQ-20260824-031): 같은 sid에 살아있는 기존
        # attach가 있으면 바인딩 공유(캡처 오귀속·클레임 충돌·이력 fork) 위험 경고
        try:
            bd = subprocess.run([S9, "bind"], capture_output=True, text=True,
                                env=env, timeout=10)
            prev = (json.loads(bd.stdout or "{}") or {}).get("attach_pid")
            me_pid = _claude_pid()  # 조상 체인의 claude 프로세스
            if prev and int(prev) != me_pid and _pid_alive(prev):
                dual_warn = (
                    f"⚠ 이 세션({session})은 다른 터미널(pid {prev})에서 이미 활성이다. "
                    f"동일 세션 이중 접속은 응답 캡처 오귀속·클레임 충돌·대화 이력 충돌을 "
                    f"일으킬 수 있다 — 이 터미널에서는 작업하지 말고 종료한 뒤, 이어서 "
                    f"하려면 새 세션(`claude`)을 열어 digest로 승계하라. 사용자에게 이 "
                    f"사실을 첫 응답에서 알려라.")
            subprocess.run([S9, "bind", "attach_pid", str(me_pid)],
                           capture_output=True, text=True, env=env, timeout=10)
            # 정식 진입 마커(s9 code → S9_ENTRY=code)와 종료 플래그 해제 —
            # 채팅 자동 대상 선택 근거 (REQ-20260824-032)
            if os.environ.get("S9_ENTRY") == "code":
                subprocess.run([S9, "bind", "entry", "code"],
                               capture_output=True, text=True, env=env,
                               timeout=10)
            subprocess.run([S9, "bind", "ended", ""],
                           capture_output=True, text=True, env=env, timeout=10)
        except Exception:
            pass

    # 신규/clear 세션: digest(인덱스 재요약)를 컨텍스트로 주입 — 이어받기의 핵심.
    # resume은 기존 컨텍스트가 살아 있으므로 digest는 생략(토큰 절약)하되,
    # 이중 접속 경고(dual_warn)는 resume에도 주입한다 (REQ-20260824-031).
    ctx = ""
    if event == "start" and detail != "resume":
        dg = subprocess.run([S9, "digest"], capture_output=True, text=True,
                            env=env, timeout=15)
        if dg.returncode == 0 and dg.stdout.strip():
            ctx = dg.stdout.strip()
    if dual_warn:
        ctx = (dual_warn + "\n\n" + ctx).strip()
    if chat_ctx:
        ctx = (ctx + "\n\n" + chat_ctx).strip()
    if ctx:
        print(json.dumps({
            "suppressOutput": True,
            "hookSpecificOutput": {
                "hookEventName": "SessionStart",
                "additionalContext": ctx,
            },
        }, ensure_ascii=False))


if __name__ == "__main__":
    try:
        main()
    except Exception:
        sys.exit(0)
