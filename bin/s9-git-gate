#!/usr/bin/env python3
"""파괴적 git 명령 기계 검사 — PreToolUse(Bash) 훅 (REQ-20260901-010).

실사고 2026-09-01: 위임 에이전트의 `git stash push`→(pop 실패)→`git stash drop`
이 남의 미커밋 전이·노트 113건을 작업 트리에서 걷어 갔다 (REQ-20260901-004).
봉투의 금지 문구는 그 에이전트에게 닿지 않았고, 닿았어도 규율은 지켜지지
않을 때를 대비하지 못한다(REQ-20260826-021) — pre-commit 훅(s9-guard)은
커밋만 보고, 작업 트리를 되돌리는 명령은 아예 보지 못한다. 그래서 명령이
실행되기 **전**에 서는 기계 검사가 이 자리다.

판정: stdin 의 PreToolUse JSON 에서 Bash command 를 읽어, **이 저장소를
향한** 작업 트리 파괴 명령이나 커밋 검사 우회면 exit 2 + stderr 사유로 거부한다.
- 막는 것 ① 작업 트리 되돌림: stash(list/show 제외) · checkout 의 경로
  되돌림(`--`·`.`·`-f`) · reset --hard/--merge · restore(작업 트리) ·
  clean -f/-d/-x
- 막는 것 ② 커밋 검사 우회 (REQ-20260916-005): `git commit --no-verify`(`-n`) ·
  `git -c core.hooksPath=…`. 둘 다 pre-commit(s9-guard)·commit-msg 를
  통째로 끈다 — 비밀 유출·보호 경로·role 승격·동시 작업·파일 크기 검사가
  한 줄로 함께 꺼진다.
- 지나가는 것: 읽기(status/log/diff/show)·보통의 commit·push·stash list 등,
  다른 저장소를 향한 명령, `S9_GIT_OK=1` 을 명령 앞에 붙인 의식적 우회 한 줄.
- 판정 불가(JSON 아님 등)는 통과다 — 검사 고장이 모든 Bash 를 막으면
  그날로 사람이 검사를 꺼 버린다.

글과 명령을 가른다 (REQ-20260902-003). 처음엔 명령줄 문자열 전체에 정규식을
댔는데, 그러면 `s9 note "... 그 명령 금지 ..."` 처럼 **글 안에 적힌 이름**까지
실행으로 읽는다 — 실제로 위임 에이전트의 판정 노트가 두 번 막혀 산출물이
사라졌고, 리드가 그 결함을 요청으로 등록하려다 같은 자리에서 또 막혔다.
막아야 할 것을 막는 검사는 옳지만, 그 검사가 글을 막으면 사람은 검사를 우회하는
버릇을 들인다 — 그것이 검사가 꺼지는 길이다.

가르는 자 한 줄: **그 글자를 누가 받느냐.** 셸·인터프리터(bash·sh·eval·
python·node…)가 받으면 그것은 명령이니 그대로 재고, 그 밖의 명령이 받으면
그것은 자료(글)이니 재지 않는다. 그래서 `bash -c "git stash"` 는 여전히
막히고(따옴표가 방패가 되면 검사는 한 줄로 무력해진다), `s9 note` 의
heredoc 본문은 지나간다. 파싱이 안 되면(따옴표 안 닫힘 등) 옛 판정으로
되돌아간다 — 모르는 것을 통과시키지 않는다.
"""
import json
import os
import re
import sys


# 윈도우에서 출력을 UTF-8 로 고정한다 (REQ-20260903-005). 이 도구들의 출력은
# 거의 다 한국어인데, 파이프로 받으면 파이썬이 콘솔 코드페이지(한국어 윈도우는
# cp949)로 인코딩한다 — 실측에서 그 출력을 UTF-8 로 읽은 쪽이 통째로 깨졌다
# (`UnicodeDecodeError: 0xc0 in position 3`). 파일에 남는 기록도 같은 이유로
# 판마다 다른 바이트가 된다. 판을 가르는 자리는 이름을 붙여 한 곳에 둔다:
# 여기가 그 자리이고, 도구마다 같은 글자로 서 있는지는 시험이 못박는다.
if os.name == "nt":
    for _std in (sys.stdout, sys.stderr):
        try:
            _std.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, ValueError, OSError):
            pass

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# 거부 사유 — 갈래마다 「왜 막았나 · 대신 무엇을 하나 · 정말 필요하면」 셋.
WHY_WORKTREE = (
    "이 저장소의 작업 트리를 되돌리는 명령은 남의 미커밋 작업을 지운다"
    " (실사고: 2026-09-01 전이·노트 113건 유실, REQ-20260901-004)."
    " 옛 버전은 `git show <rev>:<경로>` 로 읽고, 정말 필요하면 사람의 확인을"
    " 받아 명령 앞에 `S9_GIT_OK=1 ` 을 붙여라.")

WHY_BYPASS = (
    "커밋 검사(pre-commit=s9-guard·commit-msg)를 통째로 끄는 명령이다 —"
    " 비밀 유출·보호 경로·role 승격·동시 작업·파일 크기 검사가 한 줄로 함께"
    " 꺼진다 (REQ-20260916-005). 검사가 막았으면 우회가 아니라 막힌 자리를"
    " 고쳐서 담아라. 고칠 수 없으면 `s9 status <REQ> blocked --note '<사유>'`"
    " 로 드러내고, 정말 필요하면 사람의 확인을 받아 명령 앞에"
    " `S9_GIT_OK=1 ` 을 붙여라.")

BLOCK = [
    # (정규식, 사람이 읽을 이름, 사유). 명령 문자열 전체에 대해 재므로 체인
    # (`a && git stash`)·서브셸도 걸린다. stash 는 list/show 만 살린다.
    # stash 하위명령으로 판정한다 — 인자 `stash@{0}` 의 둘째 stash 나 뒤쪽
    # 어딘가의 show 낱말에 속지 않게, stash 바로 다음 낱말만 본다.
    (r"\bgit\b[^|;&]*\bstash\b(?![@\w])(?!\s+(list|show)\b)", "git stash",
     WHY_WORKTREE),
    (r"\bgit\b[^|;&]*\breset\b[^|;&]*(--hard|--merge)", "git reset --hard",
     WHY_WORKTREE),
    (r"\bgit\b[^|;&]*\bcheckout\b[^|;&]*(\s--(\s|$)|\s-f\b|\s--force\b|\s\.(\s|$))",
     "git checkout(작업 트리 되돌림)", WHY_WORKTREE),
    (r"\bgit\b[^|;&]*\brestore\b(?![^|;&]*--staged(?![^|;&]*--worktree))",
     "git restore(작업 트리)", WHY_WORKTREE),
    (r"\bgit\b[^|;&]*\bclean\b[^|;&]*\s-[a-zA-Z]*[fdx]", "git clean",
     WHY_WORKTREE),
    # 커밋 검사 우회 (REQ-20260916-005). worktree 작업자의 프롬프트 템플릿에는
    # `Bash(git commit:*)` 가 들어 있고 그 무늬는 뒤에 오는 무엇이든 받는다 —
    # 옵션 하나로 s9-guard 전체가 지나가는데, 그 자리에 서 있는 검사가 없었다.
    # `-n` 은 짧은 옵션이라 묶일 수 있다(`-an`). 값을 받지 않는 commit 짧은
    # 옵션만으로 이뤄진 묶음에서 n 을 찾는다 — `-mnope`(메시지 "nope")처럼
    # 값이 붙는 `-m` 묶음을 잘못 잡지 않으려는 좁힘이다.
    (r"\bgit\b[^|;&]*\bcommit\b[^|;&]*"
     r"(\s--no-verify\b|\s-[aeinopqsuv]*n[aeinopqsuv]*(\s|$))",
     "git commit --no-verify", WHY_BYPASS),
    (r"\bgit\b[^|;&]*\bcore\.hooksPath\b", "git -c core.hooksPath",
     WHY_BYPASS),
]


# 셸·인터프리터 — 이 이름들이 받는 글자는 **실행된다**. 따옴표·heredoc 안이라도
# 그대로 잰다. 그 밖의 명령이 받는 글자는 자료(글)라 재지 않는다.
#
# 이름 끝을 `$` 로 못박는다 (REQ-20260916-004-62x6): 앵커가 없던 첫 갈래는
# `shred`·`shutdown` 까지 인터프리터로 봤다 — 막는 쪽으로 틀리는 것이라
# 위험하진 않았지만, 두 갈래가 서로 다른 규칙으로 서 있으면 다음 사람이
# 어느 쪽을 믿을지 모른다.
INTERP = re.compile(
    r"^(?:.*/)?(?:(?:ba|z|k|da)?sh|eval|python[\d.]*|perl|ruby|node"
    r"|xargs|env|sudo|doas|time|timeout|stdbuf|setsid|nice|flock|nohup)$")

# 「제 인자를 다시 실행하는」 명령 — 이름은 인터프리터가 아니지만 받은 글자를
# 그대로 실행한다 (REQ-20260916-004-62x6).
#
# 실제 구멍 2026-09-16: `bin/s9 secret run -- sh -c "git stash"` 는 토막의
# 명령 이름이 `bin/s9` 로 판정돼 따옴표 본문이 **글**로 지워졌는데, 그
# 하위명령은 그 sh 를 실제로 실행한다 — 2026-09-01 사고와 같은 결과가
# 검사를 지나갔다. 가르는 자 한 줄(「그 글자를 누가 받느냐」)은 그대로이고,
# 받는 자를 첫 낱말 하나가 아니라 **토막의 머리**에서 읽는 것이 고침이다.
ARG_EXEC = re.compile(r"(?:^|/)s9(?:\.py)?\s+secret\s+run\b")

# 셸이 다음 명령을 시작하는 자리 — 이 뒤의 첫 낱말이 그 토막의 명령 이름이다.
_BREAK = re.compile(r"(?:\|\||&&|[;|&\n(){}`]|\$\()")


def _segment_before(cmd, at):
    """`at` 위치가 속한 토막 — 앞으로 훑어 가장 가까운 구분자 뒤부터."""
    starts = [m.end() for m in _BREAK.finditer(cmd, 0, at)]
    return cmd[(starts[-1] if starts else 0):at]


def _cmd_word_before(cmd, at):
    """`at` 위치가 속한 토막의 명령 이름 — 없으면 빈 문자열.

    `FOO=1 git ...` 처럼 앞에 붙는 환경 대입은 건너뛴다."""
    for w in _segment_before(cmd, at).split():
        if "=" in w.split("/")[0] and not w.startswith("-"):
            continue        # 환경 대입
        return w
    return ""


def receives_commands(cmd, at):
    """`at` 위치의 글자를 받는 자가 그것을 **실행하는가**.

    둘 중 하나면 실행이다: 토막의 명령 이름이 인터프리터이거나(`sh -c "…"`),
    토막의 머리가 제 인자를 다시 실행하는 명령이거나(`s9 secret run -- …`)."""
    seg = _segment_before(cmd, at)
    return bool(INTERP.match(_cmd_word_before(cmd, at)) or ARG_EXEC.search(seg))


def _blank(text):
    """길이를 지키며 지운다 — 뒤 위치가 밀리면 소유자 판정이 어긋난다."""
    return re.sub(r"[^\n]", " ", text)


def data_stripped(cmd):
    """명령에서 **글**을 지운 사본. 지울 수 없으면 원문 그대로.

    지우는 것 둘: ① 인터프리터가 아닌 명령에 딸린 heredoc 본문
    (`s9 note ... <<EOF ... EOF`), ② 같은 조건의 따옴표 안 인자."""
    out, keep = cmd, []
    # ① heredoc — `<<`·`<<-` 뒤 구분자, 다음 줄부터 그 구분자 줄까지
    for m in list(re.finditer(r"<<-?\s*([\"\']?)([A-Za-z_][\w]*)\1", cmd)):
        nl = cmd.find("\n", m.end())
        if nl < 0:
            continue
        end = re.search(r"^\s*%s\s*$" % re.escape(m.group(2)),
                        cmd[nl + 1:], re.M)
        stop = nl + 1 + (end.start() if end else len(cmd))
        if receives_commands(cmd, m.start()):
            # 인터프리터가 받는다 — 본문이 곧 명령이니 그대로 재고, ② 가
            # 다시 지우지 못하게 **살릴 구간**으로 못박는다 (그 안의 따옴표는
            # 명령의 일부다: `python3 <<PY … run('git stash') … PY`).
            keep.append((nl + 1, stop))
            continue
        out = out[:nl + 1] + _blank(out[nl + 1:stop]) + out[stop:]
    # ② 따옴표 안 — 짝이 맞을 때만. 안 맞으면 원문으로 되돌린다.
    res, i, n = [], 0, len(out)
    while i < n:
        c = out[i]
        if any(a <= i < b for a, b in keep):
            res.append(c)
            i += 1
            continue
        if c not in "\"'":
            res.append(c)
            i += 1
            continue
        j = i + 1
        while j < n and out[j] != c:
            j += 2 if (c == '"' and out[j] == "\\") else 1
        if j >= n:
            return cmd      # 짝이 안 맞는다 — 판정 불가, 옛 판정으로
        body = out[i + 1:j]
        res.append(c)
        # 받는 자는 **지금까지 지운 사본**에서 읽는다 — 앞선 따옴표 안의 글이
        # (`s9 note "… s9 secret run …"`) 다음 따옴표의 소유자로 읽히지 않게.
        # 길이를 지키며 지우므로 위치는 그대로다.
        res.append(body if receives_commands("".join(res), i)
                   else _blank(body))
        res.append(c)
        i = j + 1
    return "".join(res)


def targets_this_repo(cmd, cwd):
    """명령이 이 저장소의 작업 트리를 향하는가 — cwd 가 저장소 안이거나,
    `-C <경로>`/절대 경로 인자가 저장소를 가리킬 때."""
    try:
        if os.path.realpath(cwd or os.getcwd()).startswith(
                os.path.realpath(ROOT)):
            return True
    except OSError:
        pass
    for m in re.finditer(r"-C\s+(\S+)", cmd):
        try:
            if os.path.realpath(os.path.expanduser(
                    m.group(1))).startswith(os.path.realpath(ROOT)):
                return True
        except OSError:
            continue
    return ROOT in cmd


def main():
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return 0
    if payload.get("tool_name") != "Bash":
        return 0
    cmd = str((payload.get("tool_input") or {}).get("command") or "")
    if not cmd or "git" not in cmd:
        return 0
    # 의식적 우회 — 사람이 그 명령 앞에 직접 붙이는 한 줄. 환경 상속이 아니라
    # 명령 문자열에 있어야 한다: 워커 봉투가 통째로 물려주는 것을 막는다.
    #
    # 사람이 없는 자리에서는 그 한 줄이 우회가 되지 못한다
    # (REQ-20260916-004-62x6): 훅은 사람의 Bash 와 모델의 Bash 를 구별하지
    # 못하고, 백그라운드 작업자 세션(S9_AUTO_RESUME)에는 확인해 줄 사람이 없다 —
    # 「사람의 확인을 받아 붙인다」는 전제가 그 자리에서만 거짓이다.
    if re.search(r"\bS9_GIT_OK=1\b", cmd) \
            and not os.environ.get("S9_AUTO_RESUME"):
        return 0
    if not targets_this_repo(cmd, payload.get("cwd", "")):
        return 0
    # 재는 것은 **실행되는 글자**다 — 글은 지우고 잰다 (REQ-20260902-003).
    scan = data_stripped(cmd)
    for pat, name, why in BLOCK:
        if re.search(pat, scan):
            # 사유는 **BLOCK 표의 것을 그대로** 쓴다 (REQ-20260916-005 와
            # -004 가 이 자리에서 부딪혔다): 004 는 작업 트리 되돌림의 사유를
            # 여기 글자로 박아 두었는데, 005 가 더한 두 항목(commit
            # --no-verify · core.hooksPath)은 사유가 다르다 — 박아 둔 글자를
            # 쓰면 검사 우회를 막으면서 「작업 트리를 되돌린다」고 말하게 된다.
            # 004 가 더한 것은 사유가 아니라 **꼬리 한 줄**이라 그대로 살린다.
            sys.stderr.write(
                f"[s9-git-gate] {name} 거부 — {why}"
                + (" — 다만 이 세션은 사람이 없는 자리(백그라운드 작업자)라"
                   " `S9_GIT_OK=1` 이 듣지 않는다: 그대로 두고 blocked 로"
                   " 올려라.\n"
                   if os.environ.get("S9_AUTO_RESUME") else "\n"))
            return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
