#!/usr/bin/env python3
"""section9 installer / updater.

section9 리포가 갱신되면(clone, pull) 이 스크립트 하나로 로컬 환경이 최신화된다:
  1. 디렉토리 골격 (s9 init 과 동일)
  2. git hooks 설치 — post-merge/post-checkout(index rebuild + self 재실행),
     pre-commit(s9-guard: 역할 기반 harness 보호)
  3. ~/.claude/settings.json 에 claude/hooks.json 의 hook 반영
     (command 에 '/section9/bin/' 이 포함된 항목만 section9 소유로 간주하여
      교체/추가 — 사용자의 다른 훅/설정은 건드리지 않는다)

post-merge git hook이 자동 실행하므로 pull 후 별도 조치 불필요.
usage: s9-install [--quiet] [--no-claude]
"""
import json
import os
import stat
import shutil
import subprocess
import sys


# 윈도우에서 출력을 UTF-8 로 고정한다 (REQ-20260903-005). 이 도구들의 출력은
# 거의 다 한국어인데, 파이프로 받으면 파이썬이 콘솔 코드페이지(한국어 윈도우는
# cp949)로 인코딩한다 — 실측에서 그 출력을 UTF-8 로 읽은 쪽이 통째로 깨졌다
# (`UnicodeDecodeError: 0xc0 in position 3`). 파일에 남는 기록도 같은 이유로
# 판마다 다른 바이트가 된다. 판을 가르는 자리는 이름을 붙여 한 곳에 둔다:
# 여기가 그 자리이고, 도구마다 같은 글자로 서 있는지는 시험이 못박는다.
if os.name == "nt":
    for _std in (sys.stdout, sys.stderr):
        try:
            _std.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, ValueError, OSError):
            pass


def main_worktree_root(root):
    """링크된 git 워크트리에서 실행돼도 **메인 저장소**를 돌려준다.

    전역 `~/.claude/settings.json` 은 워크트리보다 오래 산다 (REQ-20260828-014).
    워크트리 경로를 심으면 그 디렉토리가 지워진 순간 훅 전부가 조용한 no-op 이
    된다 — 실사고: 재시작 뒤 세션 바인딩이 안 써져 대시보드가 "라이브 세션 없음"
    으로 굳었고, 프롬프트 audit 도 함께 죽어 있었다. 청소(owned_hook)만으로는
    같은 사고가 또 난다. 심는 자리에서 막는다.

    git 이 없거나 저장소가 아니면 받은 경로 그대로 — 판정이 없던 때와 같다.
    """
    try:
        r = subprocess.run(["git", "-C", root, "rev-parse", "--git-common-dir"],
                           capture_output=True,
                               encoding="utf-8", errors="replace", timeout=5)
    except (OSError, subprocess.SubprocessError):
        return root
    common = (r.stdout or "").strip()
    if r.returncode != 0 or not common:
        return root
    if not os.path.isabs(common):
        common = os.path.join(root, common)
    main = os.path.dirname(os.path.abspath(common))
    return main if os.path.isdir(os.path.join(main, "bin")) else root


ROOT = os.environ.get("S9_ROOT") or main_worktree_root(os.path.dirname(
    os.path.dirname(os.path.abspath(__file__))))
QUIET = "--quiet" in sys.argv
MARK = "/section9/bin/"  # section9 소유 hook 식별자(이 설치본)


def owned_hook(cmd):
    """이 명령이 section9 이 심은 훅인가 — **경로가 아니라 스크립트 이름으로** 본다.

    경로로만 보면 다른 위치에서 설치된 훅을 못 지운다. 실제로 임시 워크트리
    (/tmp/.../scratchpad/wt/bin/)에서 실행된 설치가 남긴 훅 5개가, 그 디렉토리가
    지워진 뒤에도 settings.json 에 계속 남아 있었다 — 죽은 경로를 부르는
    no-op 이라 조용했고, 재설치를 해도 경로가 안 맞아 정리되지 않았다."""
    return MARK in cmd or "s9-audit" in cmd


def say(msg):
    if not QUIET:
        print(msg)


def install_dirs():
    import subprocess
    subprocess.run([sys.executable, os.path.join(ROOT, "bin", "s9"), "init"],
                   capture_output=True, env={**os.environ, "S9_ROOT": ROOT})
    say(f"dirs OK: {ROOT}")


def claude_home():
    """Claude Code 설정 디렉토리 (REQ-20260827-032).

    `CLAUDE_CONFIG_DIR` 이 있으면 그것이다 — 계정 프로필로 뜬 세션은 설정이
    통째로 거기 있다. 예전에는 `~/.claude` 를 하드코딩해서 프로필에는 훅도
    스킬도 에이전트도 안 들어갔고, 그 실패가 화면에 안 보였다.
    bin/s9 의 같은 이름 함수와 뜻이 같아야 한다.
    """
    return (os.environ.get("CLAUDE_CONFIG_DIR") or "").strip() \
        or os.path.expanduser("~/.claude")


def git_hooks_dir(cwd):
    """훅 자리는 경로를 짓지 말고 git 에게 묻는다.

    워크트리의 `.git` 은 디렉토리가 아니라 **파일**이라 `<repo>/.git/hooks` 를
    지어내면 없는 자리를 가리킨다 — 그러면 워크트리에서 설치를 돌렸을 때
    "저장소 아님"으로 오판하고 훅을 **말없이 안 심는다**. 무인 작업자는
    워크트리에서 돌므로, 그 자리에 훅이 없으면 커밋 게이트도 커밋 기록도 없다.

    같은 판정이 `bin/s9-doctor` 의 같은 이름 함수에 이미 있었다 — 시험은
    고쳤는데 설치자는 안 고친 반쪽이었다 (REQ-20260829-035 가 워크트리에
    갇혀 있던 것에서 건졌다)."""
    try:
        r = subprocess.run(["git", "rev-parse", "--git-path", "hooks"],
                           cwd=cwd, capture_output=True,
                               encoding="utf-8", errors="replace", timeout=10)
    except Exception:
        return ""
    if r.returncode != 0 or not r.stdout.strip():
        return ""
    p = r.stdout.strip()
    return p if os.path.isabs(p) else os.path.abspath(os.path.join(cwd, p))


def install_git_hooks():
    hooks_dir = git_hooks_dir(ROOT)
    if not hooks_dir:
        say("git repo 아님 — git hooks 생략")
        return
    os.makedirs(hooks_dir, exist_ok=True)
    # Git for Windows 포함 어디서든: python3 → python 순으로 탐색 (셔뱅 의존 제거)
    py = ('if command -v python3 >/dev/null 2>&1; then PY=python3; else PY=python; fi\n')
    # 코드는 갈리고 데이터는 하나다 (REQ-20260828-011). 훅은 **제 자리의**
    # 스크립트를 부르되(워크트리에서는 그 사본이 맞다) `S9_ROOT` 는 언제나
    # 본 저장소로 못박는다. 본 저장소는 `--git-common-dir` 의 부모다.
    #
    # 실사고 2026-08-28 15:07: 워커가 워크트리에서 커밋하자 post-commit 이
    # 남기는 "커밋 기록" 노트가 **워크트리 사본의 vault/** 에 쓰였다. 본
    # 저장소 문서에는 흔적이 없었고, 대시보드는 그 일이 없었던 것처럼 보였다.
    # `--show-toplevel` 은 워크트리에서 워크트리를 가리킨다.
    #
    # 그리고 GIT_DIR 은 문 앞에서 벗긴다 (REQ-20260829-005). git 은 훅에
    # GIT_DIR 을 넘기고, 워크트리 커밋에서는 그 값이
    # `<repo>/.git/worktrees/<이름>` 이다. 이 환경을 물려받은 자식이 `git init`
    # 을 부르면 `-C <다른 경로>` 를 이기고 그 자리를 다시 init 하며 **공용
    # .git/config 에 core.bare=true** 를 박는다 — 그 순간 본 체크아웃에서
    # status·add·commit 이 전부 거부된다. 실제로 2026-08-29 에 serve 의 워크트리
    # 자동 보존 커밋이 매분 이 경로를 밟아 main 을 못 쓰게 만들었다.
    #
    # GIT_INDEX_FILE 은 남긴다 — pre-commit 가드가 '지금 담기는 것'을 보려면
    # 그 값이 필요하다(부분 커밋에서는 임시 인덱스를 가리킨다). 파괴적인 것은
    # GIT_DIR 쪽이다. 두 rev-parse 는 벗기기 전에 끝난다.
    where = ('TOP="$(git rev-parse --show-toplevel)"\n'
             'MAIN="$(cd "$(dirname "$(git rev-parse --git-common-dir)")" '
             '&& pwd)"\n'
             'unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_PREFIX\n')
    sync = ('#!/bin/sh\n' + py + where +
            'S9_ROOT="$MAIN" "$PY" "$TOP/bin/s9" index rebuild '
            '>/dev/null 2>&1 || true\n'
            'S9_ROOT="$MAIN" "$PY" "$TOP/bin/s9-install" --quiet || true\n')
    guard = ('#!/bin/sh\n' + py + where +
             'S9_ROOT="$MAIN" exec "$PY" "$TOP/bin/s9-guard"\n')
    # 커밋이 스스로 문서에 남는다 (REQ-20260828-005) — 구현이 끝나는 지점은
    # 커밋인데 그것을 문서에 옮기는 일이 손에 맡겨져 있어 몇 시간씩 밀렸다.
    cnote = ('#!/bin/sh\n' + py + where +
             'S9_ROOT="$MAIN" "$PY" "$TOP/bin/s9" commit-note '
             '>/dev/null 2>&1 || true\n'
             # 전체 스위트는 commit 뒤 배경에서 (REQ-20260905-010)
             'S9_ROOT="$MAIN" "$PY" "$TOP/bin/s9-guard" --after-commit || true\n')
    for name, body in [("post-merge", sync), ("post-checkout", sync),
                       ("pre-commit", guard), ("post-commit", cnote)]:
        p = os.path.join(hooks_dir, name)
        with open(p, "w", encoding="utf-8") as f:
            f.write(body)
        os.chmod(p, os.stat(p).st_mode | stat.S_IEXEC | stat.S_IXGRP)
    say("git hooks OK: post-merge, post-checkout, pre-commit(guard), post-commit(기록)")
    # 문서 병합 드라이버 (REQ-20260902-024) — .gitattributes 의 merge=s9doc 가
    # 이 이름을 가리킨다. 훅과 같은 설치 경로·같은 한계(미설치 머신은 종전대로 충돌).
    drv = f"{os.path.join(ROOT, 'bin', 's9')} merge-doc %O %A %B"
    subprocess.run(["git", "config", "merge.s9doc.driver", drv], cwd=ROOT,
                   capture_output=True)
    subprocess.run(["git", "config", "merge.s9doc.name", "section9 document merge"],
                   cwd=ROOT, capture_output=True)
    say("merge driver OK: merge.s9doc → s9 merge-doc")


def install_claude_hooks():
    src = os.path.join(ROOT, "harness", "claude", "hooks.json")
    if not os.path.exists(src):
        return
    with open(src, encoding="utf-8") as f:
        canonical = json.load(f)["hooks"]
    # {ROOT} 치환
    canonical = json.loads(json.dumps(canonical).replace("{ROOT}", ROOT))
    if os.name == "nt":
        # 순수 Windows: bash 문법(2>/dev/null || true) 제거 + 그 판의 진입점 실행.
        # 스크립트 자체가 fail-safe(항상 exit 0)라 리다이렉트 없이도 안전.
        #
        # 부르는 것은 `.cmd` 래퍼다 (REQ-20260903-005). 종전에는 `python "<script>"`
        # 를 적었는데 두 가지가 틀렸다: ① 확장자 없는 스크립트는 `python` 이
        # 있어야만 도는데 PATH 의 `python` 은 마이크로소프트 스토어의 **별칭
        # 스텁**일 수 있고(아무것도 안 하고 9009 로 끝난다), ② 그 경로로 부르면
        # 출력이 콘솔 코드페이지로 나가 한국어가 깨진다. 래퍼가 그 둘을 이미
        # 푼다 — 인터프리터를 이름으로 고르고 UTF-8 을 강제한다. 훅마다 같은
        # 판정을 되풀이하지 않는 자리이기도 하다.
        for entries in canonical.values():
            for e in entries:
                for h in e.get("hooks", []):
                    cmd = h.get("command", "")
                    cmd = cmd.replace(" 2>/dev/null || true", "").strip()
                    parts = cmd.split(" ", 1)
                    script = parts[0].replace("/", "\\")
                    args = (" " + parts[1]) if len(parts) > 1 else ""
                    wrapper = script + ".cmd"
                    if os.path.exists(wrapper):
                        h["command"] = f'"{wrapper}"{args}'
                    else:
                        # 래퍼가 없는 도구는 인터프리터를 지금 이 자리에서
                        # 확정해 적는다 — 이름으로 미루면 스텁을 집는다.
                        h["command"] = f'"{sys.executable}" "{script}"{args}'

    settings_path = os.path.join(claude_home(), "settings.json")
    try:
        with open(settings_path, encoding="utf-8") as f:
            settings = json.load(f)
    except (OSError, ValueError):
        settings = {}
    hooks = settings.setdefault("hooks", {})

    changed = False
    for event, entries in canonical.items():
        cur = hooks.get(event, [])
        # section9 소유 항목 제거 후 canonical 로 재삽입 (다른 훅은 보존)
        kept = [e for e in cur
                if not any(owned_hook(h.get("command", ""))
                           for h in e.get("hooks", []))]
        new = kept + entries
        if new != cur:
            hooks[event] = new
            changed = True

    # remoteControlAtStartup: 세션 시작 시 remote-control(모바일 앱 제어) 자동 활성화.
    # 조용히 켜지 않는다 — 최초로 켤 때 고지한다(사용자 settings.json 변경이므로).
    if "--no-remote-control" not in sys.argv and not settings.get("remoteControlAtStartup"):
        settings["remoteControlAtStartup"] = True
        changed = True
        say("⚑ remoteControlAtStartup=true 로 설정 (세션 시작 시 원격제어 자동 활성 — "
            "모바일 앱/claude.ai에서 이 세션 제어 가능). 원치 않으면 s9-install --no-remote-control 또는 "
            "settings.json에서 해당 키 삭제.")

    if changed:
        os.makedirs(os.path.dirname(settings_path), exist_ok=True)
        with open(settings_path, "w", encoding="utf-8") as f:
            json.dump(settings, f, ensure_ascii=False, indent=2)
            f.write("\n")
        say(f"claude hooks 갱신됨: {settings_path} (세션 재시작 또는 /hooks 리로드 필요할 수 있음)")
    else:
        say("claude hooks 최신 상태")


def current_user():
    u = os.environ.get("S9_USER")
    if u and os.path.isdir(os.path.join(ROOT, "users", u)):
        return u
    import getpass
    g = getpass.getuser()
    return g if os.path.isdir(os.path.join(ROOT, "users", g)) else ""


COLLISION_PREFIX = "s9-"
PLACED = []      # 이번 설치가 ~/.claude 에 놓은 것 — [{kind, name, path, how}]
COLLIDED = []    # 이름이 겹쳐 s9- 로 비켜 선 것 — [{kind, name, theirs, ours}]


def placed_manifest_path(home=None):
    """설치가 놓은 것의 목록 — uninstall(REQ-20260905-027)이 이것만 걷는다."""
    return os.path.join(home or claude_home(), ".section9-install.json")


def _read_placed(home=None):
    try:
        with open(placed_manifest_path(home), encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {"placed": [], "collided": []}


def _write_placed(home=None):
    data = {"placed": PLACED, "collided": COLLIDED, "root": ROOT}
    with open(placed_manifest_path(home), "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=1)


def _rename_frontmatter_name(text, new_name):
    """에이전트·스킬 md 의 frontmatter `name:` 을 새 이름으로 — 없으면 그대로.
    Claude Code 는 파일 이름이 아니라 이 필드로 에이전트를 세운다."""
    import re as _re
    m = _re.search(r"^---\s*\n(.*?)\n---", text, _re.S)
    if not m:
        return text
    fm = _re.sub(r"(?m)^name:\s*.+$", f"name: {new_name}", m.group(1), count=1)
    return text[:m.start(1)] + fm + text[m.end(1):]


def _copy_renamed(src, dst, new_name):
    """겹친 이름의 우리 항목을 s9-<이름> 으로 복사 — 파일이면 name 을 바꿔 쓰고,
    디렉토리(스킬)면 SKILL.md 의 name 을 바꾼다. 복사본은 마커로 소유를 표시한다."""
    if os.path.isdir(src):
        shutil.copytree(src, dst)
        sk = os.path.join(dst, "SKILL.md")
        if os.path.isfile(sk):
            with open(sk, encoding="utf-8") as f:
                t = f.read()
            with open(sk, "w", encoding="utf-8") as f:
                f.write(_rename_frontmatter_name(t, new_name))
        open(os.path.join(dst, ".section9-copy"), "w", encoding="utf-8").close()
    else:
        with open(src, encoding="utf-8") as f:
            t = f.read()
        with open(dst, "w", encoding="utf-8") as f:
            f.write(_rename_frontmatter_name(t, new_name))


def _ours(path, prev_placed):
    """이 경로가 section9 이 놓은 것인가 — 링크면 가리키는 곳으로, 복사면 마커·이전 목록으로."""
    if os.path.islink(path):
        return os.path.realpath(path).startswith(os.path.realpath(ROOT))
    if os.path.isdir(path) and os.path.exists(os.path.join(path, ".section9-copy")):
        return True
    return any(e.get("path") == path for e in prev_placed)


def link_into(src_dir, dst_dir, label, kind=None):
    """src_dir 항목들을 dst_dir 에 symlink. section9 안을 가리키는 기존
    링크만 갱신/제거 대상 — 사용자의 다른 스킬/에이전트는 건드리지 않는다.

    이름이 겹치면(REQ-20260905-026) 덮어쓰지도 조용히 빠지지도 않는다 — 사용자의 것은
    그대로 두고 우리 것을 `s9-<이름>` 으로 비켜 세운 뒤(frontmatter name 도 함께),
    완료 화면에 겹친 이름을 말한다. 전역 접두(s9-*)를 쓰지 않는 이유: 역할 이름
    (designer·architect …)은 규약·위임 지시문·다른 하네스가 같은 글자로 부르는 이름이라
    겹칠 때만 비켜 서는 것이 하네스-무관(0'조)에 맞다."""
    if not os.path.isdir(src_dir):
        return
    kind = kind or ("agent" if "agent" in label else "skill")
    os.makedirs(dst_dir, exist_ok=True)
    prev = _read_placed(os.path.dirname(dst_dir)).get("placed", [])
    for name in sorted(os.listdir(src_dir)):
        if name.startswith(".") or name == "README.md":
            continue
        src = os.path.join(src_dir, name)
        dst = os.path.join(dst_dir, name)
        if os.path.lexists(dst) and _ours(dst, prev):
            if os.path.islink(dst) or os.path.isfile(dst):
                os.remove(dst)
            else:
                shutil.rmtree(dst)  # 우리가 복사한 항목 → 갱신
        elif os.path.lexists(dst):
            # 남의 것 — 그대로 두고 우리 것은 s9- 로 비켜 선다
            stem, ext = os.path.splitext(name) if os.path.isfile(src) else (name, "")
            alt_name = COLLISION_PREFIX + stem
            alt = os.path.join(dst_dir, alt_name + ext)
            if os.path.lexists(alt):
                if _ours(alt, prev):
                    (os.remove if (os.path.islink(alt) or os.path.isfile(alt)) else shutil.rmtree)(alt)
                else:
                    say(f"  skip (겹침, {alt_name} 도 남의 것): {dst}")
                    COLLIDED.append({"kind": kind, "name": stem, "theirs": dst, "ours": ""})
                    continue
            _copy_renamed(src, alt, alt_name)
            PLACED.append({"kind": kind, "name": alt_name, "path": alt, "how": "copy"})
            COLLIDED.append({"kind": kind, "name": stem, "theirs": dst, "ours": alt})
            say(f"  겹침: {name} 은 이미 당신의 것이 있다 — 그대로 두고 우리 것은 {alt_name} 으로")
            continue
        # 제 이름이 비었다 — 전에 비켜 세운 우리 사본(s9-<이름>)이 남아 있으면 걷는다.
        # 안 걷으면 designer 와 s9-designer 가 둘 다 서서 위임이 갈린다.
        stem, ext = os.path.splitext(name) if os.path.isfile(src) else (name, "")
        stale = os.path.join(dst_dir, COLLISION_PREFIX + stem + ext)
        if os.path.lexists(stale) and _ours(stale, prev):
            (os.remove if (os.path.islink(stale) or os.path.isfile(stale)) else shutil.rmtree)(stale)
        try:
            os.symlink(src, dst)
            PLACED.append({"kind": kind, "name": name, "path": dst, "how": "link"})
            say(f"  {label}: {name} -> ~/.claude/{os.path.basename(dst_dir)}/")
        except OSError:
            # Windows 비관리자 등 symlink 불가 → 복사 fallback (마커로 소유 표시)
            if os.path.isdir(src):
                shutil.copytree(src, dst)
                open(os.path.join(dst, ".section9-copy"), "w", encoding="utf-8").close()
            else:
                shutil.copy2(src, dst)
            PLACED.append({"kind": kind, "name": name, "path": dst, "how": "copy"})
            say(f"  {label}: {name} (copy fallback) -> {dst}")


def validate_agents(agents_dir):
    """에이전트 파일 frontmatter 유효성 검사 (Claude Code가 로드하는 조건).
    name(소문자/숫자/하이픈)·description 필수. 반환: (정상 수, [결함 메시지])."""
    ok, bad = 0, []
    if not os.path.isdir(agents_dir):
        return ok, bad
    for fn in sorted(os.listdir(agents_dir)):
        if not fn.endswith(".md") or fn == "README.md":
            continue
        path = os.path.join(agents_dir, fn)
        try:
            with open(path, encoding="utf-8") as f:
                text = f.read()
        except OSError:
            continue
        # section9 소유(우리가 링크한 것)만 검사
        if not os.path.realpath(path).startswith(os.path.realpath(ROOT)):
            continue
        import re as _re
        m = _re.search(r"^---\s*\n(.*?)\n---", text, _re.S)
        if not m:
            bad.append(f"{fn}: frontmatter(--- ---) 없음")
            continue
        fm = m.group(1)
        name = _re.search(r"(?m)^name:\s*(.+)$", fm)
        desc = _re.search(r"(?m)^description:\s*(.+)$", fm)
        if not name:
            bad.append(f"{fn}: name 필드 없음")
        elif not _re.fullmatch(r"[a-z0-9-]+", name.group(1).strip()):
            bad.append(f"{fn}: name '{name.group(1).strip()}' — 소문자/숫자/하이픈만 허용")
        if not desc:
            bad.append(f"{fn}: description 필드 없음")
        if name and desc and _re.fullmatch(r"[a-z0-9-]+", name.group(1).strip()):
            ok += 1
    return ok, bad


def install_skills_agents():
    home = claude_home()
    link_into(os.path.join(ROOT, "harness", "claude", "skills"),
              os.path.join(home, "skills"), "skill(공용)")
    link_into(os.path.join(ROOT, "harness", "claude", "agents"),
              os.path.join(home, "agents"), "agent(공용)")
    u = current_user()
    if u:
        link_into(os.path.join(ROOT, "users", u, "skills"),
                  os.path.join(home, "skills"), f"skill({u})")
        link_into(os.path.join(ROOT, "users", u, "agents"),
                  os.path.join(home, "agents"), f"agent({u})")
    # 설치 검증 — Claude Code가 로드할 수 있는 형식인지 확인
    ok, bad = validate_agents(os.path.join(home, "agents"))
    for b in bad:
        say(f"  ⚠ 에이전트 결함: {b}")
    _write_placed(home)
    if COLLIDED:
        names = ", ".join(f"{c['name']}({c['kind']})" for c in COLLIDED)
        say(f"⚑ 이름이 겹친 항목 {len(COLLIDED)}개 — 당신 것을 그대로 두고 우리 것은 "
            f"{COLLISION_PREFIX}이름 으로 세웠다: {names}. 규약이 부르는 역할(designer 등)이 "
            f"당신 것으로 가면 동작이 다를 수 있다 — 당신 것을 치우면 다음 설치에서 제 이름으로 선다.")
    # ⚑ 핵심: 에이전트/스킬은 '세션 시작 시점'에만 로드된다(Claude Code 동작).
    #   세션 도중 설치했다면 이 세션에선 스폰 불가 → 재시작해야 활성화.
    say(f"agents/skills 설치·검증 OK ({ok}개 에이전트 유효). "
        f"⚑ 역할 에이전트는 Claude Code 세션 '시작 시'에만 로드된다 — "
        f"방금 설치했다면 이 세션에선 스폰 불가, **Claude Code를 재시작**해야 "
        f"designer 등 역할 에이전트가 활성화된다. (현재 로드 목록은 /context 로 확인)")


BEGIN_MARK = "<!-- section9:begin -->"
END_MARK = "<!-- section9:end -->"


def managed_block(path, label):
    """instructions 파일(GEMINI.md/AGENTS.md 등)에 PROTOCOL을 managed block으로
    주입. 마커 밖 사용자 내용은 보존, 블록만 교체 (idempotent)."""
    proto_path = os.path.join(ROOT, "harness", "common", "PROTOCOL.md")
    if not os.path.exists(proto_path):
        return
    with open(proto_path, encoding="utf-8") as f:
        proto = f.read().strip()
    block = f"{BEGIN_MARK}\n{proto}\n{END_MARK}"
    try:
        with open(path, encoding="utf-8") as f:
            cur = f.read()
    except OSError:
        cur = ""
    if BEGIN_MARK in cur and END_MARK in cur:
        pre = cur.split(BEGIN_MARK)[0]
        post = cur.split(END_MARK, 1)[1]
        new = pre + block + post
    else:
        new = (cur.rstrip("\n") + "\n\n" if cur.strip() else "") + block + "\n"
    if new != cur:
        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            f.write(new)
        say(f"{label}: protocol block 갱신 → {path}")
    else:
        say(f"{label}: 최신 상태 ({path})")


def install_other_harnesses():
    # 이 저장소 자신의 CLAUDE.md 부터 (REQ-20260903-013). Claude Code 세션이
    # 실제로 읽는 것은 PROTOCOL.md 가 아니라 이 파일이다 — 마커는 처음부터
    # 박혀 있었는데 갱신하는 자리가 없어서, 규약을 고쳐도 `--agents-md` 를
    # 손으로 부르기 전까지 세션에는 옛 글이 갔다. 원천을 고쳤는데 생성물이
    # 안 따라오면 고친 것이 아니다.
    managed_block(os.path.join(ROOT, "CLAUDE.md"), "claude")
    # 존재하는 하네스만 감지해 적용 (프로토콜 모드 — harness/README.md 매트릭스 참조)
    targets = [
        ("gemini", os.path.expanduser("~/.gemini"),
         os.path.expanduser("~/.gemini/GEMINI.md")),
        ("codex", os.path.expanduser("~/.codex"),
         os.path.expanduser("~/.codex/AGENTS.md")),
    ]
    for name, probe, dst in targets:
        if os.path.isdir(probe):
            managed_block(dst, name)
        else:
            say(f"{name}: 미설치 감지 ({probe} 없음) — 생략")


# bin/s9-doctor 의 LOGIN_MARKS 와 같은 표 — 이 도구는 doctor 를 import 하지 않는다.
# 두 벌이 갈리는지는 tests/test_login_check.py 가 본다 (REQ-20260905-014).
LOGIN_MARKS = {
    "claude": {"exe": "claude", "mark": ".credentials.json", "home_env": "CLAUDE_CONFIG_DIR",
               "home": "~/.claude", "how": "터미널에서 `claude` 를 한 번 띄워 /login 으로 로그인"},
    "codex": {"exe": "codex", "mark": "auth.json", "home_env": "CODEX_HOME",
              "home": "~/.codex", "how": "`codex login`"},
    "gemini": {"exe": "gemini", "mark": "oauth_creds.json", "home_env": "",
               "home": "~/.gemini", "how": "터미널에서 `gemini` 를 한 번 띄워 로그인"},
}


def login_state(marks=None, which=None):
    marks = marks or LOGIN_MARKS
    which = which or shutil.which
    out = {}
    for name, m in marks.items():
        exe = bool(which(m["exe"]))
        home = (os.environ.get(m["home_env"]) if m.get("home_env") else "") or m["home"]
        mark = os.path.exists(os.path.join(os.path.expanduser(home), m["mark"]))
        out[name] = {"installed": exe, "logged_in": exe and mark, "how": m["how"]}
    return out


def _load_env_module():
    import importlib.util
    spec = importlib.util.spec_from_file_location(
        "s9_env", os.path.join(ROOT, "bin", "s9_env.py"))
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


def env_backup_mode():
    argv = sys.argv[1:]
    if "--backup" in argv:
        i = argv.index("--backup")
        if i + 1 < len(argv) and argv[i + 1] in ("silent", "ask", "off"):
            return argv[i + 1]
    return "silent"


def env_backup_before_install():
    """설치 표식을 세우고, 모드에 따라 기존 환경을 백업한다. 실패해도 설치는 계속 —
    다만 백업 없이 병합하지 않도록 `--backup off` 가 아니면 실패를 크게 말한다."""
    try:
        env = _load_env_module()
    except Exception as e:
        say(f"⚠ 백업 모듈을 못 읽었다({e}) — 백업 없이 계속한다")
        return None
    try:
        if env.mark_installed(ROOT):
            say("설치 표식 state/installed_at — 이 시각 이전의 옛 대화는 section9 이 집지 않는다")
    except OSError:
        pass
    mode = env_backup_mode()
    if mode == "off":
        say("백업 없이 진행한다 (--backup off)")
        return None
    if mode == "ask" and sys.stdin.isatty():
        try:
            a = input("설치 전에 예전 Claude 설정(settings.json·CLAUDE.md·메모리)을 복사해 둘까요? [Y/n] ")
        except EOFError:
            a = "y"
        if a.strip().lower() in ("n", "no"):
            say("백업을 건너뛴다(사용자 선택)")
            return None
    try:
        r = env.backup(reason="install")
        if not r.get("dir"):
            say("백업할 예전 설정이 없다 — 새 환경이다")
        return r
    except Exception as e:
        say(f"⚠ 백업 실패({e}) — 설치는 계속하되, 이 줄을 남긴다. 되돌릴 것이 없다는 뜻이다")
        return None


def login_guide(state=None):
    """설치가 끝났는데 로그인이 없으면 여기서 말한다 — 첫 `s9 code` 가 로그인 화면에서
    막히는 것이 실사고다(새 머신 설치, 2026-09-05). 설치를 막지는 않는다."""
    st = login_state() if state is None else state
    installed = [k for k, v in st.items() if v["installed"]]
    logged = [k for k in installed if st[k]["logged_in"]]
    if not installed:
        say("에이전트 CLI 가 없다 — 기본은 Claude Code: 설치 뒤 `claude` 를 한 번 띄워 로그인하라")
        return "none"
    if not logged:
        for k in installed:
            say(f"{k} 는 설치됐지만 로그인이 없다 — {st[k]['how']}. 그다음 `s9 code`")
        return "not-logged-in"
    say("로그인 확인: " + " · ".join(logged))
    return "ok"


def main():
    # --agents-md <path>: 임의 instructions 파일에 protocol 주입 (copilot/프로젝트용)
    if "--agents-md" in sys.argv:
        i = sys.argv.index("--agents-md")
        if i + 1 >= len(sys.argv):
            print("usage: s9-install --agents-md <path>", file=sys.stderr)
            sys.exit(1)
        managed_block(os.path.abspath(sys.argv[i + 1]), "custom")
        return
    install_dirs()
    install_git_hooks()
    # 기존 환경 백업 (REQ-20260905-025) — settings.json 을 병합하기 **전에**. 모드 셋을
    # 다 둔다(사용자 요구: 하나만 채택하지 말고 다 제공): 기본 `--backup silent`(조용히),
    # `--backup ask`(tty 면 묻고 아니면 조용히), `--backup off`. 무엇을 백업하고 어디에
    # 두는지는 bin/s9_env.py 한 곳이 안다. 자격증명은 목록에 없다.
    env_bk = env_backup_before_install()
    if "--no-claude" not in sys.argv:
        install_claude_hooks()
        install_skills_agents()
    install_other_harnesses()
    start_dashboard()
    say("section9 install 완료")
    if env_bk and env_bk.get("dir"):
        say(f"예전 설정 {len(env_bk['entries'])}개를 {env_bk['dir']} 에 그대로 복사해 두었습니다. "
            f"원본은 건드리지 않았습니다. 설치 전으로 돌아가려면: s9 env restore {os.path.basename(env_bk['dir'])}")
    login_guide()


def start_dashboard():
    """설치 직후 대시보드 자동 기동 (REQ-20260824-020) — 이미 떠 있으면 무시(멱등).
    이후에는 Claude 세션 시작 훅(s9-audit-session)이 죽은 서버를 되살린다."""
    import socket
    import subprocess
    port = int(os.environ.get("S9_PORT") or 0)
    if not port:
        try:
            with open(os.path.join(ROOT, "state", "port"), encoding="utf-8") as f:
                port = int(f.read().strip())
        except (OSError, ValueError):
            port = 9909
    try:
        socket.create_connection(("127.0.0.1", port), 0.5).close()
        say(f"대시보드 이미 실행 중: http://127.0.0.1:{port}/")
        return
    except OSError:
        pass
    try:
        s9 = os.path.join(os.path.dirname(os.path.abspath(__file__)), "s9")
        root = os.environ.get("S9_ROOT") or os.path.dirname(
            os.path.dirname(os.path.realpath(__file__)))
        os.makedirs(os.path.join(root, "state"), exist_ok=True)
        lf = open(os.path.join(root, "state", "serve.log"), "a", encoding="utf-8")
        # 감시자를 세운다 (REQ-20260825-096) — 감시자가 서버를 띄우고,
        # 죽으면 사유를 남기고 되살린다. 이미 감시 중이면 곧바로 물러난다.
        # 인터프리터를 앞에 세운다 (REQ-20260903-005) — 윈도우에는 shebang 이
        # 없어 확장자 없는 스크립트를 그대로 넘기면 안 뜬다. 세션에서 떼는
        # 것도 판마다 이름이 다르므로 **있는 것만** 얹는다.
        kw = {"stdin": subprocess.DEVNULL, "stdout": lf, "stderr": lf}
        flags = 0
        for nm in ("DETACHED_PROCESS", "CREATE_NEW_PROCESS_GROUP"):
            flags |= getattr(subprocess, nm, 0)
        if flags:
            kw["creationflags"] = flags
        else:
            kw["start_new_session"] = True
        subprocess.Popen([sys.executable, s9, "serve", "--supervise",
                          "--port", str(port)], **kw)
        say(f"대시보드 기동: http://127.0.0.1:{port}/ (감시 포함)")
    except Exception as e:
        say(f"대시보드 자동 기동 실패({e}) — 수동: ~/section9/bin/s9 serve")


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        # 조용한 실패를 성공으로 돌려주지 않는다 (REQ-20260903-005). 예전에는
        # `--quiet` 이면 0 으로 끝냈고, 그래서 네이티브 윈도우에서 설치가
        # **한 줄 오류만 남기고 rc=0** 으로 끝났다 — 부르는 쪽에서는 깔린 것과
        # 구분이 안 된다. 이 스크립트를 부르는 git 훅은 이미 `|| true` 로
        # 감싸 있으니, 정직하게 실패를 알려도 훅이 멈추지 않는다.
        print(f"s9-install: {e}", file=sys.stderr)
        sys.exit(1)
