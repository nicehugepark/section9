#!/usr/bin/env python3
"""section9 harness guard (git pre-commit hook).

보호 경로(harness)가 커밋에 포함되면 현재 사용자의 role을 확인해
admin이 아니면 커밋을 거부한다.

인가(authorization)만 있고 인증(authentication)은 없다 — S9_USER 위조로
우회 가능하며, 이는 의도된 설계다(실수 방지 + 규율 + 감사가 목표).
우회 불가능한 최종 검사는 GitHub branch protection + CODEOWNERS (docs/09).
"""
import json
import os
import re
import subprocess
import sys
import time


# 윈도우에서 출력을 UTF-8 로 고정한다 (REQ-20260903-005). 이 도구들의 출력은
# 거의 다 한국어인데, 파이프로 받으면 파이썬이 콘솔 코드페이지(한국어 윈도우는
# cp949)로 인코딩한다 — 실측에서 그 출력을 UTF-8 로 읽은 쪽이 통째로 깨졌다
# (`UnicodeDecodeError: 0xc0 in position 3`). 파일에 남는 기록도 같은 이유로
# 판마다 다른 바이트가 된다. 판을 가르는 자리는 이름을 붙여 한 곳에 둔다:
# 여기가 그 자리이고, 도구마다 같은 글자로 서 있는지는 시험이 못박는다.
if os.name == "nt":
    for _std in (sys.stdout, sys.stderr):
        try:
            _std.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, ValueError, OSError):
            pass

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "bin"))

PROTECTED = ("bin/", "web/", "harness/", ".github/", ".gitignore", ".gitattributes")
# **실행 권위를 갖는 텍스트**도 코드다 (REQ-20260902-032, white-hacker 검토 시나리오
# 4·5). `projects/<slug>/agents/*.md` 는 워커 프롬프트 서두에 그대로 주입되고
# `.claude/agents` 로 미러돼 네이티브 서브에이전트 정의가 된다. `users/<u>/skills|agents`
# 는 `~/.claude` 에 symlink 된다. 데이터 경로에 산다는 이유로 무보호였다 —
# 공유 리포에서는 push 권한자가 남의 세션 에이전트 정의를 바꿔 쓸 수 있었다.
PROTECTED_RE = (
    re.compile(r"^projects/[^/]+/agents/"),
    re.compile(r"^users/[^/]+/(skills|agents)/"),
)


def protected_hits(staged):
    """보호 경로에 걸리는 스테이지 파일 — 접두 목록과 패턴 목록을 한 자리에서."""
    out = []
    for f in staged:
        q = f.replace("\\", "/")
        if q.startswith(PROTECTED) or any(r.search(q) for r in PROTECTED_RE):
            out.append(f)
    return out


def role_change_hits(staged, diff_text):
    """profile.md 의 `role:` 줄을 바꾸는 커밋 (REQ-20260902-032).

    프로필은 훅이 늘 고쳐 쓰는 데이터 파일이라 통째로 보호할 수 없다 — 그러면
    모든 사람의 모든 커밋이 막힌다. 그래서 **바뀐 줄**을 본다: 스테이지 diff 에
    `+role:` 또는 `-role:` 이 있으면 그것은 역할 변경이고, admin 만 할 수 있다
    (`s9 user role` 의 CLI 검사와 같은 규칙 — REQ-20260902-029)."""
    files = [f for f in staged
             if re.search(r"(^|/)users/[^/]+/profile\.md$", f.replace("\\", "/"))]
    if not files or not diff_text:
        return []
    hits, cur = [], ""
    for line in diff_text.splitlines():
        if line.startswith("+++ b/"):
            cur = line[6:]
            continue
        if cur in files and re.match(r"^[+-]role:", line):
            if cur not in hits:
                hits.append(cur)
    return hits

# 동시 작업 보호 (REQ-20260826-021). 2026-08-26 하루에 같은 뿌리의 사고가 넷 났다.
# 21:42 에는 리드가 `git add web/index.html` 로 커밋하면서 같은 파일을 고치던
# 워커의 진행 중 편집을 함께 담았다 — 결과는 문법적으로 멀쩡해 커밋도 되고
# 서버도 뜨는 **반쪽 상태**였고, 같은 커밋에 들어 있던 테스트조차 통과 못 했다.
# 돌리기만 했으면 잡혔다.
#
# 그래서 검사 둘: ① 무인 워커가 도는데 방금 만져진 파일을 담으려 하면 막는다
# ② 커밋에 테스트 파일이 있으면 그것만이라도 돌린다(전체 스위트는 2분이라 매
# 커밋에 물릴 수 없다 — 그 무게가 규율을 죽인다).
# 창의 폭은 **에이전트가 일하는 모습**에 맞춘다 (REQ-20260827-012).
# 처음엔 90초였다 — "방금 저장한 파일"을 잡으려는 값이다. 그런데 에이전트는
# 덩어리로 일한다: 몇 분 생각하고 한 번 쓰고, 또 몇 분 생각한다. **쓰는 순간은
# 드물고 잡고 있는 시간은 길다.** 실측(08:29): designer 가 4초 전까지 활동
# 중이었는데 그가 잡은 파일의 마지막 저장은 209초 전이라 검사가 조용히
# 통과시켰다.
#
# 21:42 사고를 다시 보면 더 분명하다 — 워커의 마지막 저장과 리드의 `git add`
# 사이가 90초 안이었던 것은 **운**이었고, 몇 분만 어긋났어도 이 검사는 그
# 사고를 못 막는다.
FRESH_SEC = 900                     # 15분: 에이전트가 파일을 잡고 있는 폭
OVERRIDE = "S9_ALLOW_CONCURRENT"    # 사람이 확인했으면 이걸로 지나간다


def current_user():
    u = os.environ.get("S9_USER")
    if u:
        return u
    import getpass
    acct = getpass.getuser()
    # 운영체제 계정을 그대로 쓰기 전에 os_accounts 별칭을 본다
    # (REQ-20260829-010). 계정 이름과 하네스의 사용자 이름이 다르면 그 사람은
    # 여기서 늘 '미등록'이고, admin 이어도 막힌다 — 그러면 권한 있는 사람이
    # `S9_USER=<admin> git commit` 을 손에 익히게 되고, 그 습관은 검사가
    # 정말 막아야 할 때도 그대로 나온다. bin/s9 의 resolve_user() 는 이미 이
    # 매칭을 한다(REQ-20260827-060 이 CLI 와 화면 사이에서 겪은 것과 같은
    # 갈림이다 — 이번엔 CLI 와 검사가 갈렸다).
    return _user_by_os_account(acct) or acct


def _user_by_os_account(acct):
    """os_accounts 에 이 운영체제 계정을 적어 둔 등록 사용자.

    매칭이지 승격이 아니다 — 모르는 계정은 그대로 두고, 역할은 role_of() 가
    따로 본다. 프로필이 깨져 있어도 커밋을 터뜨리지 않는다."""
    users = os.path.join(ROOT, "users")
    try:
        names = sorted(os.listdir(users))
    except OSError:
        return ""
    for name in names:
        profile = os.path.join(users, name, "profile.md")
        try:
            with open(profile, encoding="utf-8") as f:
                for line in f:
                    if not line.startswith("os_accounts:"):
                        continue
                    raw = line.split(":", 1)[1].strip()
                    try:
                        val = json.loads(raw)
                    except ValueError:
                        break
                    if isinstance(val, str):
                        val = [val]
                    if isinstance(val, list) and acct in val:
                        return name
                    break
        except OSError:
            continue
    return ""


def role_of(user):
    profile = os.path.join(ROOT, "users", user, "profile.md")
    try:
        with open(profile, encoding="utf-8") as f:
            for line in f:
                if line.startswith("role:"):
                    return line.split(":", 1)[1].strip()
        return "member"  # 등록됐지만 role 미지정
    except OSError:
        return ""  # 미등록


def _parent_pid(pid):
    """그 프로세스의 부모 pid — 못 읽으면 0."""
    try:
        with open("/proc/%d/status" % pid, encoding="utf-8") as f:
            for line in f:
                if line.startswith("PPid:"):
                    return int(line.split(":", 1)[1].strip() or 0)
    except (OSError, ValueError):
        pass
    try:
        r = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)],
                           capture_output=True, encoding="utf-8",
                           errors="replace", timeout=5)
        return int((r.stdout or "").strip() or 0)
    except (OSError, ValueError, subprocess.SubprocessError):
        return 0


def self_and_ancestors():
    """나 자신과 나를 띄운 조상들의 pid.

    커밋을 거는 프로세스는 훅의 조상이다 — 작업자가 제 손으로 commit 하면
    그 작업자의 pid 가 이 집합에 든다. 부모를 못 읽는 환경이면 거기서 멈춘다:
    못 읽었다고 검사를 넓게 풀지 않는다(내 pid 하나만 빠진다).
    """
    pids, pid = set(), os.getpid()
    for _ in range(64):
        if pid <= 0 or pid in pids:
            break
        pids.add(pid)
        pid = _parent_pid(pid)
    return pids


_WORKER_PID = re.compile(r"pid\s+(\d+)")


def live_workers():
    """지금 도는 **다른** 작업 주체 — s9 에게 묻는다(판정을 두 벌로 두지 않는다).

    무인 워커뿐 아니라 서브에이전트도 포함된다 (REQ-20260827-002). 판정을
    여기 옮겨 오지 않고 `s9 workers` 에게 계속 묻는 덕에, 주체의 종류가
    늘어도 이 훅은 고칠 것이 없었다 — 실제로 서브에이전트를 더할 때
    이 함수는 한 줄도 안 바뀌었다.

    **커밋하는 당사자는 「다른 작업자」가 아니다** (REQ-20260915-021). 무인
    작업자가 제가 고친 파일을 담아 commit 하면 목록에 선 그 작업자가 바로
    커밋을 거는 프로세스였고, 검사는 자기 자신을 세어 막았다. 빠져나가는 길
    (`S9_ALLOW_CONCURRENT=<표> git commit`)은 환경변수 접두라 무인 세션의
    allowlist 에 안 맞아 승인 대기로 떨어진다 — 승인할 사람이 없는 자리에서
    이 검사는 구조적으로 통과할 수 없었다. 그래서 목록의 pid 가 이 프로세스의
    조상이면 뺀다. 검사의 힘은 그대로다 — 남은 여전히 남이다.

    pid 가 없는 줄(서브에이전트)은 빼지 않는다: 리드 세션의 서브에이전트는
    같은 작업 트리를 만지는 진짜 다른 주체다.
    """
    try:
        out = subprocess.run([sys.executable, os.path.join(ROOT, "bin", "s9"), "workers",
                              "--quiet"], capture_output=True,
                                  encoding="utf-8", errors="replace",
                             cwd=ROOT, timeout=15)
        lines = [l for l in out.stdout.splitlines() if l.strip()]
    except Exception:
        return []
    mine = self_and_ancestors()
    kept = []
    for l in lines:
        m = _WORKER_PID.search(l)
        if m and int(m.group(1)) in mine:
            continue
        kept.append(l)
    return kept


def staged_fingerprint(names):
    """담긴 **내용**의 지문 (REQ-20260909-101).

    목록만으로는 부족하다는 것이 2026-09-09 18:15 에 드러났다. 리드가
    `git apply --cached` 로 bin/s9.py 의 제 hunk 둘만 담고 표를 받아 두었는데,
    첫 커밋이 다른 검사에 막혀 4분이 흐르는 사이 같은 작업 트리의 다른 작업자가
    그 파일을 통째로 담았다. 파일 **목록**은 그대로여서 표도 그대로였고, 두
    번째 커밋이 남의 hunk 아홉을 제 메시지로 실어 갔다.

    표가 증언해야 하는 것은 「이 파일들을 봤다」가 아니라 **「지금 담겨 있는 이
    내용을 봤다」**이다. 그래서 담긴 diff 를 지문으로 접어 넣는다 — 내용이
    한 글자라도 달라지면 표가 죽고, 사람은 다시 읽어야 한다.

    **「담긴 것이 없다」와 「못 읽었다」는 같은 값이다** — 저장소가 아닌 자리
    (시험의 임시 뿌리)에서도 빈 diff 와 같은 지문이 나온다. 둘을 갈라 두면
    조회와 검사가 서로 다른 자리에서 돌 때 표가 어긋나고, 사람은 제 표를 쓰고도
    막힌다. 가르는 것이 사람에게 주는 정보도 없다.
    """
    import hashlib
    if not names:
        return ""
    blob = b""
    try:
        r = subprocess.run(["git", "diff", "--cached", "--", *names],
                           capture_output=True, cwd=ROOT, timeout=30)
        if r.returncode == 0:
            blob = r.stdout or b""
    except (OSError, subprocess.SubprocessError):
        blob = b""
    return hashlib.sha1(blob).hexdigest()[:8]


def concurrent_token(fresh):
    """담긴 파일 **집합과 그 내용**에서 나오는 짧은 표. 순서는 값을 바꾸지 않는다.

    이 표는 「담기는 것을 봤다」의 증거다 (REQ-20260907-062 · REQ-20260909-101).
    첫 시도에서 가드가 목록과 함께 알려 주므로, 표를 손에 넣는 유일한 길이
    목록을 보는 것이다. 목록이 바뀌어도, 목록은 그대로인데 **담긴 내용**이
    바뀌어도 표는 죽는다 — 그 사이 남이 또 담았으면 다시 봐야 한다.
    """
    import hashlib
    names = sorted(f for f, _ in fresh)
    key = "\n".join(names) + "\n#" + staged_fingerprint(names)
    return hashlib.sha1(key.encode("utf-8")).hexdigest()[:6]


def fresh_staged(staged):
    """담긴 것 중 최근 FRESH_SEC 안에 바뀐 파일을 (경로, 나이초) 로 돌려준다.

    커밋 검사(`concurrent_gate`)와 조회(`concurrent_report`)가 같은 값을 봐야
    한다 — 둘이 따로 세면 조회가 준 표로 커밋이 막힌다 (REQ-20260907-070).
    """
    import time
    now = time.time()
    out = []
    for f in staged:
        try:
            age = now - os.path.getmtime(os.path.join(ROOT, f))
        except OSError:
            continue
        if age < FRESH_SEC:
            out.append((f, int(age)))
    return out


DATA_PREFIXES = ("vault/", "users/", "projects/")
DATA_FILES = (".s9-sync",)


def is_data_path(rel):
    """동기화가 담는 데이터인가 — 코드가 아니라 (REQ-20260908-049).

    목록은 `SYNC_DATA_PATHS`(bin/s9.py) 와 같은 뜻이다. 여기서 다시 적는
    까닭은 guard 가 s9.py 를 import 하지 않기 때문이다 — 훅은 본체가 못 뜰
    때도 돌아야 한다. 두 곳이 갈리면 시험(test_concurrent_gate)이 잡는다.
    """
    p = (rel or "").replace("\\", "/")
    while p.startswith("./"):
        p = p[2:]
    return p in DATA_FILES or p.startswith(DATA_PREFIXES)


# 파일 하나의 크기 상한 (REQ-20260908-045). architect 실측 2026-09-08:
# 저장소 나이 15일에 .git 296MB, 에셋 9.3MB/일, 가장 큰 파일 5.03MB. 기울기보다
# 먼저 오는 것은 **벽**이다 — GitHub 는 파일 하나가 100MB 를 넘으면 push 를
# 거부하고, 1080p60 화면 녹화는 80초면 거기 닿는다. 그리고 한 번 이력에 들어간
# 파일은 이력 재작성 말고는 뺄 길이 없다(이 저장소는 streams/ 158MB 로 그 값을
# 이미 한 번 치렀다). 그러니 벽을 **커밋 시점의 보이는 거절**로 앞당긴다.
#
# 자리가 s9-git-gate 가 아니라 여기인 까닭: 그 검사는 사람이 친 Bash 명령을 보고,
# 동기화(sync)의 커밋은 s9 가 subprocess 로 직접 부르므로 그 검사에 걸리지 않는다.
# 담긴 파일을 아는 자리는 pre-commit 인 여기뿐이다.
SIZE_WARN = 10 * 1024 * 1024
SIZE_STOP = 25 * 1024 * 1024
SIZE_OK_ENV = "S9_BIG_FILE"       # 사유와 함께 지나가는 한 줄


def _human_mb(n):
    return f"{n / (1024 * 1024):.1f}MB"


def big_staged(staged):
    """담긴 것 중 큰 파일 — [(경로, 바이트)], 큰 것부터."""
    out = []
    for rel in staged or []:
        try:
            n = os.path.getsize(os.path.join(ROOT, rel))
        except OSError:
            continue
        if n >= SIZE_WARN:
            out.append((rel, n))
    return sorted(out, key=lambda x: -x[1])


def file_size_gate(staged, out=None):
    """10MB 는 알리고, 25MB 는 막는다 (REQ-20260908-045).

    막는 쪽에도 지나가는 길을 둔다 — 정말 큰 원본을 담아야 하는 날이 있고,
    길이 없는 검사는 검사를 끄는 버릇을 만든다. 대신 **사유를 적게** 한다:
    `S9_BIG_FILE=<REQ-id> git commit …`. 동시 작업 검사(REQ-20260907-062)와
    같은 규율이다 — 빠져나가려면 무엇을 지나가는지 봐야 한다.
    """
    w = out or sys.stderr
    big = big_staged(staged)
    if not big:
        return
    stop = [(f, n) for f, n in big if n >= SIZE_STOP]
    why = (os.environ.get(SIZE_OK_ENV) or "").strip()
    if not stop:
        w.write("s9-guard: 큰 파일이 담겼습니다 — "
                + " · ".join(f"{f} {_human_mb(n)}" for f, n in big[:3])
                + "\n  파일 하나가 100MB 를 넘으면 GitHub 이 push 를 거부하고, "
                  "이력에 들어간 뒤에는 이력 재작성 말고 뺄 길이 없습니다.\n")
        return
    if why:
        w.write(f"s9-guard: {_human_mb(stop[0][1])} 짜리 파일을 사유와 함께 "
                f"담습니다 ({SIZE_OK_ENV}={why})\n")
        return
    w.write(f"s9-guard: 파일 하나가 {_human_mb(SIZE_STOP)} 를 넘습니다 — "
            f"담지 않습니다.\n")
    for f, n in stop:
        w.write(f"  - {f}  {_human_mb(n)}\n")
    w.write("이력에 한 번 들어가면 이력 재작성 말고는 뺄 길이 없고, 그것은 이 "
            "저장소의 모든 클론을 끊습니다.\n")
    w.write("줄여서 담거나(캡처는 `s9 shot` 이 스스로 줄입니다), 저장소 밖에 두고 "
            "경로만 적으세요. 정말 담아야 하면 사유와 함께 지나갑니다:\n")
    w.write(f"  {SIZE_OK_ENV}=<REQ-id> git commit ...\n")
    sys.exit(1)


def concurrent_gate(staged):
    """워커가 도는 중에 '방금 만져진' 파일을 담으려 하면 막는다.

    **빠져나가려면 목록을 봐야 한다** (REQ-20260907-062). 예전엔 여기서
    `if os.environ.get(OVERRIDE): return` 으로 **목록을 세기도 전에** 돌아갔다 —
    `=1` 은 「읽었다」는 주장일 뿐이고 읽었는지는 아무도 안 봤다. 2026-09-07
    18:26 에 리드가 검사가 없던 그 자리로 남의 진행 중 변경 셋을 제 커밋에 쓸어 담았다.
    사람이 규율을 안 지킨 것이 아니라 **지키지 않아도 지나갈 수 있었다.**
    """
    workers = live_workers()
    if not workers:
        return
    # **문서만 담는 커밋은 이 검사의 몫이 아니다** (REQ-20260908-049).
    # 이 검사가 막으려는 것은 남의 커밋하지 않은 **코드**를 내 커밋이 쓸어
    # 담는 것이다(REQ-20260907-062). 문서는 하나가 파일 하나이고, 동기화가
    # 제가 쓴 것만 담으며, 겹치면 의미 병합기가 푼다. 그런데 이 검사가 그
    # 커밋까지 막아, 서브에이전트가 도는 동안 **문서가 밖으로 못 나갔다** —
    # 2026-09-08 하루의 대부분이 그랬고 다른 머신이 그만큼 뒤처졌다.
    # 코드가 한 파일이라도 섞이면 종전대로 막는다.
    if staged and all(is_data_path(f) for f in staged):
        return
    fresh = fresh_staged(staged)
    if not fresh:
        return
    tok = concurrent_token(fresh)
    if os.environ.get(OVERRIDE) == tok:
        # 지나간 사실을 남긴다 — commit-msg 가 이것을 읽어 trailer 로 붙인다.
        # 옛 사고의 아픈 곳이 「그 커밋 메시지가 그 파일들을 설명하지 않는다」였다.
        try:
            os.makedirs(os.path.join(ROOT, "state"), exist_ok=True)
            with open(os.path.join(ROOT, "state", "concurrent-swept.txt"),
                      "w", encoding="utf-8") as f:
                f.write("\n".join(sorted(x for x, _ in fresh)) + "\n")
        except OSError:
            pass
        return
    print("s9-guard: 다른 작업자가 붙어 있는 중에, 그 사이 바뀐 파일을 "
          "담으려 합니다.", file=sys.stderr)
    print("  지금 실행 중인 작업자:", file=sys.stderr)
    for w in workers[:5]:
        print(f"    {w}", file=sys.stderr)
    print("  최근에 바뀐 스테이지 파일:", file=sys.stderr)
    for f, age in fresh[:10]:
        m, sec = age // 60, age
        when = f"{m}분 전" if m else f"{sec}초 전"
        print(f"    - {f}  ({when} 바뀜)", file=sys.stderr)
    print("`git add <경로>` 는 '내 변경'이 아니라 '그 파일의 지금 상태'를 담습니다 —",
          file=sys.stderr)
    print("남이 쓰는 중이면 남의 미완성이 이 커밋의 일부가 됩니다(2026-08-26 21:42 실제 사고).",
          file=sys.stderr)
    print("`git diff --cached` 로 담기는 내용을 실제로 읽고, 네 것만 맞으면",
          file=sys.stderr)
    if os.environ.get(OVERRIDE):
        print(f"  ({OVERRIDE} 가 붙어 있지만 이 목록의 표가 아닙니다 — "
              f"목록이 그 사이 바뀌었거나, 보지 않고 지나가려는 것입니다)",
              file=sys.stderr)
    print(f"`{OVERRIDE}={tok} git commit ...` 으로 진행하세요 — 위 목록을 "
          f"읽었다는 표입니다. 목록이 바뀌면 표도 바뀝니다.", file=sys.stderr)
    # 커밋을 걸어야만 답이 나오면 사람은 probe 커밋으로 두드린다 (REQ-20260907-070).
    print("(커밋을 걸지 않고 미리 보려면: `bin/s9-guard --concurrent`)",
          file=sys.stderr)
    sys.exit(1)


def concurrent_report(staged, out=None):
    """커밋을 걸지 않고 동시 작업 검사가 무엇을 볼지 그대로 보여 준다.

    `concurrent_gate` 는 커밋할 때만 답한다. 그래서 2026-09-07 에 리드가 그
    검사가 막는지 보려고 `git commit -m probe` 를 두 번 걸었고, 막지 않은
    회차의 probe 는 그대로 커밋으로 남았다 (REQ-20260907-070). 커밋을 걸어야만
    답이 나오는 검사는 사람을 진짜 커밋으로 밀어낸다.

    여기서도 표(token)는 **목록과 함께만** 나온다 — 목록 없이 표만 주면
    이 검사가 받는 증거가 다시 주장으로 돌아간다 (DOC-20260907-004).
    무엇도 막지 않고 항상 0 을 돌려준다 — 이것은 검사가 아니라 조회다.
    """
    w = out if out is not None else sys.stdout
    workers = live_workers()
    if not workers:
        print("동시 작업 검사: 지금 붙어 있는 작업자가 없습니다 — 막지 않습니다.", file=w)
        return 0
    print("지금 실행 중인 작업자:", file=w)
    for x in workers[:5]:
        print(f"  {x}", file=w)
    fresh = fresh_staged(staged)
    if not fresh:
        print("담긴 파일 중 그 사이 바뀐 것은 없습니다 — 막지 않습니다.", file=w)
        return 0
    print("담긴 파일 중 최근에 바뀐 것:", file=w)
    for f, age in fresh[:10]:
        m = age // 60
        print(f"  - {f}  ({m}분 전 바뀜)" if m else f"  - {f}  ({age}초 전 바뀜)", file=w)
    print("이대로 커밋하면 막힙니다. `git diff --cached` 로 담기는 내용을 읽고,", file=w)
    print("네 것만 맞으면 아래 표로 지나가세요 — 목록이든 담긴 내용이든", file=w)
    print("한 글자만 달라져도 표는 죽습니다:", file=w)
    print(f"  {OVERRIDE}={concurrent_token(fresh)} git commit ...", file=w)
    return 0


def staged_now():
    """지금 담겨 있는 파일 목록 (`git diff --cached --name-only`)."""
    out = subprocess.run(["git", "diff", "--cached", "--name-only"],
                         capture_output=True, encoding="utf-8",
                         errors="replace", cwd=ROOT)
    return [l for l in out.stdout.splitlines() if l.strip()]


def deleted_now():
    """지금 담겨 있는 **삭제** 목록 (`--diff-filter=D`). 돌릴 시험이 없는 자리다."""
    out = subprocess.run(
        ["git", "diff", "--cached", "--diff-filter=D", "--name-only"],
        capture_output=True, encoding="utf-8", errors="replace", cwd=ROOT)
    return [l for l in out.stdout.splitlines() if l.strip()]


# git 이 훅에게 물려주는 환경변수. 훅이 부르는 자식은 이걸 물려받으면 안 된다.
GIT_ENV_VARS = ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE",
                "GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES",
                "GIT_COMMON_DIR", "GIT_PREFIX", "GIT_INDEX_VERSION",
                "GIT_QUARANTINE_PATH")


def clean_git_env(env=None):
    """훅이 물려받은 git 환경을 벗겨서 준다 (REQ-20260829-005).

    git 은 훅에 GIT_DIR 을 넘긴다. worktree에서 커밋하면 그 값은
    `<repo>/.git/worktrees/<이름>` 이다. 이 환경을 물려받은 자식이 `git init` 을
    부르면 — `-C <다른 경로>` 를 붙였든 말든 — GIT_DIR 이 이기므로 그 자리를
    다시 init 하고, 작업 트리가 없다고 판단해 **공용 .git/config 에
    core.bare=true 를 박는다**. 그 순간 본 체크아웃에서 status·add·commit 이
    전부 'must be run in a work tree' 로 거부된다.

    2026-08-29 에 실제로 이 경로로 매분 뒤집혔다: serve 의 worktree 자동 보존
    커밋 → 이 훅 → 스테이지 테스트 → 임시 리포에 `git init`. 파일은 멀쩡해서
    커밋하려는 순간에야 드러난다.
    """
    e = dict(os.environ if env is None else env)
    for k in GIT_ENV_VARS:
        e.pop(k, None)
    # commit 때 쓴 손잡이는 자식에게 물려주지 않는다 — 검사가 돌리는 시험이 S9_FIX_RED 를
    # 물려받으면 실패 시 커밋 차단을 재는 시험(test_wide_gate W3b)이 그 값 때문에 통과로
    # 읽힌다(실제 발생 2026-09-06 12:38, REQ-20260906-064 의 commit 에서).
    for k in ("S9_FIX_RED", "S9_ALLOW_CONCURRENT", "S9_GIT_OK"):
        e.pop(k, None)
    return e


def staged_source_error(path, text):
    """담긴 본의 파이썬 소스를 컴파일해 오류를 한 줄로 돌려준다 — 없으면 None."""
    try:
        compile(text, path, "exec")
    except SyntaxError as e:
        return f"{path}:{e.lineno}: {e.msg}"
    return None


def _is_python_source(path, text):
    if path.endswith(".py"):
        return True
    return path.startswith("bin/") and text.startswith("#!") and "python" in text.split("\n", 1)[0]


def staged_compile_gate(staged):
    """담긴 파이썬 소스가 컴파일되는지 본다 (REQ-20260907-004).

    보는 것은 작업 트리가 아니라 **index 의 본**이다 — hunk 를 갈라 담은 commit
    (fc3011a, 2026-09-07 10:34)이 작업 트리는 멀쩡한 채 HEAD 의 s9.py 만 깨뜨렸고,
    시험은 작업 트리를 보니 전부 통과했다. 그 commit 을 rebase 가 재생할 때마다
    훅이 깨진 본을 컴파일해 sync 가 78분 동안 매번 섰다(DOC-20260907-001)."""
    bad = []
    for f in staged:
        if not (f.endswith(".py") or f.startswith("bin/")) or f.endswith(".cmd"):
            continue
        r = subprocess.run(["git", "show", f":{f}"], capture_output=True, cwd=ROOT)
        if r.returncode != 0:
            continue                     # 지워진 파일은 볼 본이 없다
        text = r.stdout.decode("utf-8", "replace")
        if not _is_python_source(f, text):
            continue
        err = staged_source_error(f, text)
        if err:
            bad.append(err)
    if bad:
        print("s9-guard: 담기는 파이썬 소스가 컴파일되지 않습니다 — 작업 트리가 아니라 "
              "index 의 본을 봤습니다:", file=sys.stderr)
        for b in bad[:10]:
            print(f"  - {b}", file=sys.stderr)
        print("hunk 를 갈라 담았다면 파일을 통째로 다시 담으세요 (DOC-20260907-001).",
              file=sys.stderr)
        sys.exit(1)


# 관련 시험 선택 (REQ-20260909-059). 나흘 전체 테스트 실패 34건 중 14건은 계약을
# 바꾼 커밋이 그 계약을 재는 시험을 안 담은 것이었다(quality-assurance 실측,
# REQ-20260909-053) — 8ce0dcc5 가 s9 next 의 문구 한 줄을 바꿨는데 그 문구를 재는
# test_boot_pickup 은 담기지 않았고, 검사는 담긴 시험∪스모크만 보니 볼 길이 없었다.
# 그래서 담긴 diff 의 -/+ 줄에서 **바뀐 식별자와 따옴표 문자열**을 뽑아 그것을
# 참조하는 시험을 찾고, 담긴 소스 파일의 이름을 글자로 담은 시험(대장·조각 목록
# 류)도 고른다. 상한 15파일·90초 — 넘으면 짧은 것부터 담고 나머지는 이름만 말한다
# (전체는 commit 뒤 배경에서 돈다, 아래 ③).
RELATED_CAP = 15
RELATED_BUDGET_SEC = 90.0
RELATED_MIN_STR = 6
RELATED_MIN_IDENT = 4
RELATED_COMMON = 25           # 이보다 많은 시험 파일에 있는 조각은 계약이 아니라 상용구다
RELATED_UNKNOWN_SEC = 3.0     # 잰 시간이 없는 시험의 무게 — 중앙값(0.36초)보다 무겁게
RELATED_STRONG_STR = 12       # 띄어쓰기도 한글도 없는 한 낱말은 이 길이부터만 (option·--quiet 는 상용구)
# 시험의 관례 이름 — 어느 시험에나 있어 계약을 가리키지 않는다
RELATED_STOP_IDENTS = frozenset(("HERE", "ROOT", "REPO", "main", "setUp", "setUpClass",
                                 "tearDown", "tearDownClass", "self", "None", "True", "False"))
_DEF_RE = re.compile(
    r"^\s*(?:async\s+)?(?:def|class|function)\s+([A-Za-z_]\w*)"          # py · js (메서드 포함)
    r"|^(?:export\s+)?(?:const|let|var)\s+([A-Za-z_]\w*)\s*="            # js 모듈 상수 (들여쓰기 없음)
    r"|^([A-Z][A-Z0-9_]{2,})\s*=")                                        # 대문자 상수 (들여쓰기 없음)
_STR_RE = re.compile(r"\"((?:[^\"\\\n]|\\.)*)\"|'((?:[^'\\\n]|\\.)*)'")
_PLACEHOLDER_RE = re.compile(r"\{[^{}]*\}|%[sdrf]|%\([^)]*\)[sdrf]|\$\{[^}]*\}")
_STR_SPLIT_RE = re.compile(r"[:：—·()\[\]|,]")
_TEST_FILE_RE = re.compile(r"^tests/test_[^/]+\.py$")


def _string_fragments(raw):
    """따옴표 안 글자에서 **시험이 assert 할 만한 조각**을 낸다.

    자리표시(`{p['id']}`·`%s`·`${x}`)를 경계로 가르고, 그 조각을 다시 문장 부호
    (`:`·`—`·`(`…)로 갈라 6자 이상만 남긴다 — 띄어쓰기도 한글도 없는 한 낱말
    (`option`·`--quiet`)은 12자부터. f-string 의 글자 부분이 이렇게 살아남는다 — 8ce0dcc5 의 `f"  이어받기: s9 last {p['id']} --add"` 에서
    시험이 재는 것은 `s9 last` 였다."""
    out = []
    for piece in _PLACEHOLDER_RE.split(raw):
        for frag in [piece] + _STR_SPLIT_RE.split(piece):
            frag = frag.strip()
            if len(frag) < RELATED_MIN_STR or frag in out:
                continue
            weak = (" " not in frag and frag.isascii() and len(frag) < RELATED_STRONG_STR)
            if not weak:
                out.append(frag)
    return out


def diff_evidence(diff_text, skip=lambda path: False):
    """담긴 diff 의 -/+ 줄에서 (식별자 목록, 문자열 조각 목록) — 순수 함수.

    `skip(path)` 가 참인 파일의 hunk 는 읽지 않는다 — 담긴 시험 파일의 diff 는
    증거가 아니다(그 시험은 어차피 돌고, 그 안의 `HERE`·`setUp` 같은 이름은
    모든 시험에 있다). hunk 머리(`@@ … @@ def cmd_next(args):`)의 둘러싼 함수
    이름도 식별자로 센다 — 본문만 바뀐 함수를 재는 시험이 그것으로 잡힌다."""
    idents, strings, skipping = [], [], False

    def add_ident(name):
        if (len(name) >= RELATED_MIN_IDENT and name not in idents
                and name not in RELATED_STOP_IDENTS):
            idents.append(name)

    for line in (diff_text or "").splitlines():
        if line.startswith("+++ "):
            path = line[4:].strip()
            path = path[2:] if path.startswith("b/") else path
            skipping = bool(skip(path))
            continue
        if skipping or not line or line.startswith("--- "):
            continue
        if line.startswith("@@"):
            ctx = line.split("@@", 2)[-1].strip() if line.count("@@") >= 2 else ""
            m = _DEF_RE.match(ctx)
            if m:
                add_ident(next(g for g in m.groups() if g))
            continue
        if line[0] not in "+-":
            continue
        body = line[1:]
        m = _DEF_RE.match(body)
        if m:
            add_ident(next(g for g in m.groups() if g))
        for m in _STR_RE.finditer(body):
            raw = m.group(1) if m.group(1) is not None else m.group(2)
            for frag in _string_fragments(raw):
                if frag not in strings:
                    strings.append(frag)
    return idents, strings


def _related_times(times):
    if times is not None:
        return times
    d = _read_json(os.path.join(ROOT, "state", "test-times.json")) or {}
    return {k: float(v) for k, v in d.items() if isinstance(v, (int, float))}


def select_related_tests(staged, diff_text, tests_dir=None, times=None,
                         cap=RELATED_CAP, budget=RELATED_BUDGET_SEC,
                         common=RELATED_COMMON):
    """담긴 변경이 닿는 시험 파일을 고른다 — 순수 함수 (REQ-20260909-059).

    반환: {"picked": [(파일, 이유)], "dropped": [(파일, 초)], "idents": [...],
           "strings": [...], "names": [...], "common": [...], "seconds": 초}
    고르는 규칙 셋 — ① diff 의 -/+ 줄(과 hunk 머리)에서 바뀐 def/class/const
    이름을 **단어 경계**로 담은 시험, ② 그 줄의 따옴표 문자열 조각(6자 이상)을
    **그대로** 담은 시험, ③ 담긴 소스 파일의 이름(`card.js`)을 글자로 담은
    시험(tests/ 의 보조 모듈은 그 모듈 이름 `async_notify` 를 단어로). 넓은 파일
    (WIDE: bin/s9.py 등)의 이름은 ③에서 뺀다 — 그 이름은 어디에나 있다.
    담긴 시험 파일의 diff 는 증거로 읽지 않고 그 파일은 후보에서도 뺀다.
    `common` 파일보다 많은 시험에 있는 조각은 계약이 아니라 상용구라 버린다.
    상한 `cap` 파일·`budget` 초(state/test-times.json 의 파일별 실측 합)를 넘으면
    짧은 것부터 담고 나머지는 dropped 로 돌려 준다."""
    tests_dir = tests_dir or os.path.join(ROOT, "tests")
    staged = [f.replace("\\", "/") for f in staged]
    staged_tests = {os.path.basename(f) for f in staged if _TEST_FILE_RE.match(f)}
    idents, strings = diff_evidence(
        diff_text, skip=lambda p: _TEST_FILE_RE.match(p.replace("\\", "/")) is not None)
    names = [os.path.basename(f) for f in staged
             if f.startswith(("bin/", "web/", "harness/")) and f not in WIDE
             and not f.endswith((".md", ".txt"))]
    for f in staged:            # tests/ 의 보조 모듈 — 시험은 그 이름을 import 한다
        if (f.startswith("tests/") and f.endswith(".py") and f not in WIDE
                and not _TEST_FILE_RE.match(f)):
            n = os.path.basename(f)[:-3]
            if len(n) >= RELATED_MIN_IDENT and n not in idents:
                idents.append(n)
    probes = ([(f"식별자 {i}", re.compile(r"(?<!\w)" + re.escape(i) + r"(?!\w)").search)
               for i in idents]
              + [(f"문자열 「{s}」", (lambda s: lambda src: s in src)(s)) for s in strings]
              + [(f"파일 이름 {n}", (lambda n: lambda src: n in src)(n)) for n in names])
    try:
        files = sorted(fn for fn in os.listdir(tests_dir)
                       if fn.startswith("test_") and fn.endswith(".py"))
    except OSError:
        files = []
    hits = {}                   # 증거 → 그 증거를 담은 시험 파일들
    for fn in files:
        if fn in staged_tests:
            continue
        try:
            with open(os.path.join(tests_dir, fn), encoding="utf-8", errors="replace") as f:
                src = f.read()
        except OSError:
            continue
        for label, test in probes:
            if test(src):
                hits.setdefault(label, []).append(fn)
    too_common = [label for label, fns in hits.items() if len(fns) > common]
    why_of = {}
    for label, _ in probes:     # probes 순서 = 식별자 → 문자열 → 파일 이름
        if label in too_common:
            continue
        for fn in hits.get(label, ()):
            why_of.setdefault(fn, []).append(label)
    times = _related_times(times)
    secs = lambda fn: times.get(fn, RELATED_UNKNOWN_SEC)
    found = sorted(((fn, " / ".join(w[:3]) + (" …" if len(w) > 3 else ""))
                    for fn, w in why_of.items()),
                   key=lambda p: (secs(p[0]), p[0]))
    picked, dropped, total = [], [], 0.0
    for fn, why in found:
        if len(picked) < cap and total + secs(fn) <= budget:
            picked.append((fn, why))
            total += secs(fn)
        else:
            dropped.append((fn, secs(fn)))
    picked.sort(key=lambda p: p[0])
    return {"picked": picked, "dropped": dropped, "idents": idents,
            "strings": strings, "names": names, "common": too_common,
            "seconds": total}


def related_tests(staged, diff_text, **kw):
    """`select_related_tests` 의 이름만 — 검사가 러너에 넘길 목록."""
    return [fn for fn, _ in select_related_tests(staged, diff_text, **kw)["picked"]]


def staged_diff_text(staged=None):
    """담긴 변경의 diff (`git diff --cached -U0`). 못 읽으면 빈 글자."""
    try:
        return subprocess.run(["git", "diff", "--cached", "-U0", "--",
                               *(staged or [])],
                              capture_output=True, encoding="utf-8", errors="replace",
                              cwd=ROOT, timeout=60, env=clean_git_env()).stdout or ""
    except Exception:
        return ""


# 검사 출력이 가리키는 저장소 경로 — `web/app/notice.js:189:` 의 앞부분. 첫 칸이
# 저장소의 최상위 디렉토리인 것만 센다: 러너는 실패한 시험을 파일 이름만으로
# 찍으므로(`실패한 샤드: test_button_word.py`) 그것이 경로로 섞이지 않는다.
_GATE_PATH_RE = re.compile(
    r"(?<![\w./-])((?:bin|web|tests|harness|vault|projects|index|docs|state)"
    r"/[\w.\-/]*[\w])")


def gate_failure_paths(text):
    """검사 실패 출력이 가리키는 저장소 경로의 집합."""
    return {m.group(1) for m in _GATE_PATH_RE.finditer(text or "")}


def others_draft_paths(staged):
    """담기지 않았는데 작업 트리에서는 달라진 파일 (REQ-20260915-003-62x6).

    한 working tree 에서 여럿이 일하면 옆 사람의 커밋하지 않은 편집이 디스크에
    같이 있다. 검사가 돌리는 시험 중 다섯(test_button_word·test_no_metaphors·
    test_screen_lexicon·test_stdlib_only·test_dialog_safe)은 저장소의 파일을 모두
    디스크에서 읽으므로, 경로를 한정한 `s9 commit`(임시 index)조차 남의 초안에
    막힌다 — 실측 2026-09-15: bin/·tests/ 만 담은 commit 이 web/ 초안의 낱말 때문에
    거부됐다.

    `git status --porcelain` 의 **작업 트리 칸**(둘째 글자)이 붙은 것과 untracked
    가 그 초안이다. 담긴 경로는 뺀다 — 담은 파일의 실패는 내 실패다."""
    try:
        r = subprocess.run(["git", "status", "--porcelain", "-z",
                            "--untracked-files=all"],
                           capture_output=True, encoding="utf-8", errors="replace",
                           cwd=ROOT, timeout=60, env=clean_git_env())
    except Exception:
        return set()
    if r.returncode != 0:
        return set()
    recs = [x for x in r.stdout.split("\0") if x]
    out = set()
    i = 0
    while i < len(recs):
        rec = recs[i]
        i += 1
        if len(rec) < 4:
            continue
        x, y, path = rec[0], rec[1], rec[3:]
        if x in ("R", "C"):
            i += 1                      # 옮긴 이름은 다음 레코드에 온다 — 건너뛴다
        if y not in (" ", "."):
            out.add(path)
    return out - set(staged or ())


def draft_only_failure(staged, text, err=None):
    """실패가 **담기지 않은 남의 초안만** 가리키는가 — 그러면 경고로 낮춘다.

    낮추는 자리는 좁다: 실패 출력에서 저장소 경로를 하나라도 읽어야 하고, 읽은
    경로가 **전부** 담기지 않은 작업 트리 파일이어야 한다. 경로를 못 읽었거나
    하나라도 담긴 파일을 가리키면 종전대로 막는다."""
    err = err or sys.stderr
    hits = gate_failure_paths(text)
    if not hits:
        return False
    drafts = others_draft_paths(staged)
    if not drafts or not hits <= drafts:
        return False
    print("s9-guard: 커밋 검사가 실패했지만 실패한 자리가 모두 **담기지 않은 파일**입니다 "
          "— 경고로 낮추고 커밋을 진행합니다 (REQ-20260915-003-62x6).", file=err)
    for p in sorted(hits):
        print(f"  - {p} — 작업 트리에만 있는 변경(다른 작업자가 고치는 중일 수 있습니다)",
              file=err)
    print("  담기는 내용에는 이 실패가 없습니다. 그 파일을 담을 때 같은 검사를 다시 받습니다.",
          file=err)
    return True


def staged_tests_gate(staged, diff_text=None, deleted=()):
    """커밋 검사 = 담긴 시험 ∪ 관련 시험 ∪ 스모크 (REQ-20260830-029, 필수 계층 배선).

    21:42 커밋은 같은 커밋에 들어 있던 테스트조차 통과 못 했다. 전체 스위트는
    분 단위라 매 커밋에 물리면 규율이 먼저 죽는다 — 그래서 담긴 시험에
    **핵심 계약 12파일 + 검사형 시험 5파일(--smoke, tests/__main__.py SMOKE)** 만
    합친다: 병렬(--jobs 4)로 30~40초에 유계다(REQ-20260909-056).
    여기에 담긴 diff 가 닿는 **관련 시험**(select_related_tests, 상한 15파일·90초)을
    더한다(REQ-20260909-059) — `diff_text` 를 받았을 때만 고르고, 왜 골랐는지
    파일마다 한 줄씩 stderr 에 말한다.
    --changed 를 여기 쓰지 않는 이유: bin/s9 는 미커밋 변경이 잦아 매번 전체
    폴백(4분대)으로 밀린다 — 전체 확인은 review/done 전 수동 실행의 몫이다.
    담긴 시험은 정확한 파일명으로 넘긴다(러너가 정확명은 넓히지 않는다) —
    조각으로 넘기면 이웃 파일까지 끌려와 검사가 뚱뚱해진다.
    실패가 **담기지 않은 파일만** 가리키면 경고로 낮춘다 (draft_only_failure,
    REQ-20260915-003-62x6) — 한 working tree 에서 여럿이 일할 때 남의 초안이
    내 commit 을 막지 않게.
    """
    # 지운 시험은 러너에 넘기지 않는다 (REQ-20260910-012). 담긴 목록에는 삭제도
    # 들어 있어서, 시험 파일 하나를 지우거나 이름을 바꾸면 러너가 없는 패턴을
    # 찾다 「고르지 못한 패턴」으로 실패하고 커밋이 통째로 막혔다 — 지운 시험은
    # 돌릴 것이 없다는 뜻이지 실패가 아니다 (실측 2026-09-10: 옛 계약 시험을
    # 새 계약으로 다시 쓰는 커밋이 이 자리에서 막혔다).
    # 무엇이 지워졌는지는 **부르는 쪽이 준다** — 이 함수는 파일시스템을 보지
    # 않는다. 인자로 받은 목록을 「지금 없는 파일」로 다시 판정하면, 목록을
    # 손으로 넘기는 자리(시험·다른 검사)가 통째로 빈손이 된다.
    gone = set(deleted or ())
    names = [os.path.basename(f)
             for f in staged
             if f.startswith("tests/test_") and f.endswith(".py")
             and f not in gone]
    if not names and not any(f.startswith(("bin/", "web/", "tests/"))
                             for f in staged):
        return   # 코드가 안 담겼으면(문서·상태 커밋) 검사 생략 — 종전과 같다
    related = []
    if diff_text is not None:
        sel = select_related_tests(staged, diff_text)
        related = [fn for fn, _ in sel["picked"] if fn not in names]
        if related:
            print(f"s9-guard: 관련 시험 {len(related)}개를 함께 돕니다 "
                  f"(약 {sel['seconds']:.0f}초, REQ-20260909-059):", file=sys.stderr)
            for fn, why in sel["picked"]:
                if fn in related:
                    print(f"  {fn} ← {why}", file=sys.stderr)
        if sel["dropped"]:
            print(f"  상한({RELATED_CAP}파일·{RELATED_BUDGET_SEC:.0f}초) 밖 — 전체가 뒤에서: "
                  + " ".join(fn for fn, _ in sel["dropped"]), file=sys.stderr)
    r = subprocess.run(["python3", "tests/", "--smoke", "--jobs", "4", *names, *related],
                       capture_output=True,
                       encoding="utf-8", errors="replace", cwd=ROOT, timeout=600,
                       env=clean_git_env())
    if r.returncode == 0:
        return
    if draft_only_failure(staged, (r.stdout or "") + (r.stderr or "")):
        return
    print("s9-guard: 커밋 검사(담긴 테스트 ∪ 관련 테스트 ∪ 스모크 테스트)가 실패합니다 — 커밋을 멈춥니다.",
          file=sys.stderr)
    print(f"  대상: 스모크 테스트(tests/__main__.py SMOKE) ∪ {' '.join(names) or '(담긴 테스트 없음)'}"
          + (f" ∪ 관련 {' '.join(related)}" if related else ""),
          file=sys.stderr)
    _show_gate_failure(r)
    sys.exit(1)


def _show_gate_failure(r):
    """실패한 자리를 보여 준다 — 마지막 몇 줄이 아니라 (REQ-20260904-003).

    예전엔 출력의 **마지막 25줄**만 찍었다. 순차라면 그 자리가 실패 요약이지만,
    검사는 `--jobs 4` 로 돈다 — 실패한 샤드의 출력이 먼저 나오고 통과한
    샤드가 뒤에 온다. 그래서 「실패합니다」라고 말한 뒤 **통과 결과를 보여
    줬다.** 2026-09-04 에 그 화면을 세 번 보고도 원인을 못 읽었다.

    막기만 하고 이유를 안 보여 주는 검사는 사람이 `--no-verify` 를 배우게 한다.
    그러니 ① 실패한 줄과 그 앞뒤를 골라 보이고, ② 전문은 파일로 남겨 그
    경로를 말한다. 고르기가 빗나가도 전문이 있으면 사람은 길을 잃지 않는다.
    """
    import re as _re
    all_out = (r.stdout or "") + (r.stderr or "")
    lines = all_out.splitlines()
    try:
        os.makedirs(os.path.join(ROOT, "state"), exist_ok=True)
        full = os.path.join(ROOT, "state", "last-gate.log")
        with open(full, "w", encoding="utf-8") as f:
            f.write(all_out)
    except OSError:
        full = ""
    hot = _re.compile(r"^(FAIL|ERROR):|^FAILED|실패한 샤드|Traceback")
    marks = [i for i, ln in enumerate(lines) if hot.search(ln)]
    if marks:
        shown, last = 0, -1
        for i in marks:
            if shown >= 60:
                print("  … (남은 실패는 전문에서)", file=sys.stderr)
                break
            lo = max(last + 1, i - 1)
            for j in range(lo, min(len(lines), i + 12)):
                print(f"  {lines[j]}", file=sys.stderr)
                shown += 1
            last = min(len(lines), i + 12) - 1
    else:
        # 표식이 없으면 샤드가 **죽은** 것이다 — 끊긴 자리가 곧 단서다.
        print("  실패 표식이 없다 — 샤드가 도중에 종료됐을 수 있다. 끊긴 자리:",
              file=sys.stderr)
        for ln in lines[-15:]:
            print(f"  {ln}", file=sys.stderr)
    if full:
        print(f"  전문: {full}", file=sys.stderr)


# 어디에 닿을지 셀 수 없는 파일 (REQ-20260903-012). 원본은 tests/__main__.py 의
# `COMMON` 이고 여기는 그 사본이다 — 훅은 시험 러너를 import 하지 않는다(그
# import 하나가 포트풀·임시자리까지 끌고 온다). 두 목록이 갈리는지는
# tests/test_wide_gate.py 가 값으로 대 본다.
WIDE = ("bin/s9", "bin/s9.py", "tests/__main__.py", "tests/portpool.py",
        "tests/tmproot.py", "tests/jobfile.py", "tests/precious.py")


def wide_change_verdict(staged):
    """(넓은 파일 목록, 지금 이 tree가 전체 통과인가) — **묻기만** 한다.

    시험을 한 건도 돌리지 않는다. 검사가 시험을 돌리기 **전에** 떠 둬야
    그 실행의 부산물이 판정을 뒤집지 못한다 (REQ-20260904-003).
    고장 나면 통과로 답한다 — 검사가 고장 나 모든 커밋을 막으면 그날로 뽑힌다.
    """
    wide = [f for f in staged if f.replace("\\", "/") in WIDE]
    if not wide:
        return ([], True)
    try:
        r = subprocess.run([sys.executable or "python3",
                            os.path.join(ROOT, "tests"), "--is-green"],
                           capture_output=True, encoding="utf-8",
                           errors="replace", cwd=ROOT, timeout=120,
                           env=clean_git_env())
    except Exception:
        return (wide, True)
    return (wide, r.returncode == 0)


# 전체 스위트는 **commit 뒤 배경에서** 돈다 (REQ-20260905-010, quality-assurance 판정).
# 넓게 닿는 파일의 커밋마다 전체(4~5분, 간헐 날엔 8~13분)를 commit 전에 물리면
# 하루 174분을 기다리고(2026-09-05 실측: 라벨 한 줄이 한 시간), 뒤에 돌리면
# 5분이다 — 12~35배. 그래서 검사는 셋으로 갈린다:
#   ① 이 tree 의 전체 통과 기록이 있으면 비용 0 으로 지나간다(종전).
#   ② **실패 시 커밋 차단** — 마지막 전체 실행이 실패했고 그것이 마지막 통과보다 새로우면
#      code 커밋을 세운다. 실패한 파일의 시험을 담은 커밋(고치러 온 것)과
#      `S9_FIX_RED=<REQ>` 는 지나간다.
#   ③ 그 밖에는 스모크∪담긴 시험(staged_tests_gate)만 보고 지나가며, commit 뒤
#      post-commit 훅이 `s9-guard --after-commit` 으로 전체를 detached 로 띄운다.
#      실패하면 러너가 state/tests-last-red.json 을 남겨 다음 커밋이 ②에 걸린다.
LAST_RED = os.path.join(ROOT, "state", "tests-last-red.json")
ASYNC_DIR = os.path.join(ROOT, "state", "tests-async")


def _read_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def full_green_age():
    """마지막 전체 통과의 나이(초). 모르면 None."""
    try:
        r = subprocess.run([sys.executable or "python3",
                            os.path.join(ROOT, "tests"), "--full-green-age"],
                           capture_output=True, encoding="utf-8", errors="replace",
                           cwd=ROOT, timeout=60, env=clean_git_env())
        out = r.stdout.strip()
        return None if (r.returncode != 0 or out == "none") else float(out)
    except Exception:
        return None


RED_NO_NAME = "(원격 머신)"     # 러너가 실패 파일을 못 걷었을 때 적던 자리표시


def _red_unnamed(red):
    """그 실패 기록이 **파일 이름을 하나도 담고 있지 않은가.**"""
    files = [str(f).strip() for f in (red.get("files") or [])]
    files = [f for f in files if f]
    if not files:
        return True
    # 파일 이름처럼 보이는 것이 하나도 없다 — `(원격 머신)` 같은 자리표시뿐이다
    return not any(f.endswith(".py") for f in files)


def red_ratchet(staged, red=None, green_age=None, now=None, fix_env=None):
    """(막나, 실패한 파일들) — 마지막 실패가 마지막 통과보다 새로우면 막는다.

    예외 둘: 실패한 파일의 시험이 담겨 있다(고치러 온 커밋) · `S9_FIX_RED` 가
    설정돼 있다(사유는 커밋 메시지에). 기록이 없거나 못 읽으면 막지 않는다.
    """
    red = _read_json(LAST_RED) if red is None else red
    if not red or not red.get("at"):
        return (False, [])
    # **이름 없는 실패는 막지 않는다** (REQ-20260908-058, 실제 사고 2026-09-08).
    # 그날 기록의 `files` 가 `["(원격 머신)"]` 이었다 — 실패한 파일 이름이 아니다.
    # 그러면 「그 파일을 고쳐 담으라」를 따를 수 없고, 원격 러너는 미커밋 변경이
    # 있는 동안 통과 기록을 남기지 않으므로 손으로 전체를 돌려도 기록이 안
    # 지워진다. 커밋해야 지워지는데 커밋은 그 기록이 막는다. 남는 길이
    # `S9_FIX_RED` 뿐이라 리드가 하루에 세 번 썼다 — **매번 쓰는 비상구는 검사가
    # 아니다.** 그래서 이름을 못 적은 기록은 경고로 낮춘다. 기록은 남고
    # (다음 전체 실행이 덮는다) 사람은 로그를 보면 된다.
    if _red_unnamed(red):
        return (False, [])
    now = time.time() if now is None else now
    green_age = full_green_age() if green_age is None else green_age
    green_at = None if green_age is None else now - green_age
    if green_at is not None and green_at >= float(red["at"]):
        return (False, [])                  # 실패 뒤에 통과가 있었다
    files = [str(f) for f in (red.get("files") or [])]
    if red_fixed_since(red, files=files):
        return (False, files)               # 고치러 온 commit 이 이미 이력에 있다 (REQ-20260915-008)
    fix_env = os.environ.get("S9_FIX_RED", "") if fix_env is None else fix_env
    if fix_env.strip():
        return (False, files)
    if files and any(os.path.basename(s.replace("\\", "/")) in files for s in staged):
        return (False, files)
    return (True, files)


def head_touches_wide(sha="HEAD"):
    """그 커밋(기본 HEAD)이 넓은 파일에 닿는가. post-commit 은 **자기 sha** 를 넘긴다 —
    훅이 도는 사이 sync(remote) 가 문서 커밋을 얹어 HEAD 가 바뀌면(실측 2026-09-06,
    code 커밋 셋에 배경 실행이 한 번도 안 떴다) HEAD 는 이미 남의 커밋이다."""
    try:
        r = subprocess.run(["git", "diff-tree", "--no-commit-id", "--name-only", "-r", sha or "HEAD"],
                           capture_output=True, encoding="utf-8", errors="replace",
                           cwd=ROOT, timeout=30, env=clean_git_env())
        return [f for f in r.stdout.split() if f in WIDE]
    except Exception:
        return []


def _commit_names(sha="HEAD"):
    """그 커밋이 닿은 경로들 — 못 읽으면 빈 목록."""
    try:
        r = subprocess.run(["git", "diff-tree", "--no-commit-id", "--name-only", "-r", sha or "HEAD"],
                           capture_output=True, encoding="utf-8", errors="replace",
                           cwd=ROOT, timeout=30, env=clean_git_env())
        return r.stdout.split()
    except Exception:
        return []


def head_fixes_red(sha="HEAD", red=None):
    """그 커밋이 마지막 실패 기록(state/tests-last-red.json)의 파일을 담았는가 — 고치러 온
    commit 은 넓은 파일이 없어도 전체를 띄운다 (REQ-20260915-008-62x6).

    실제 사고 2026-09-15: 실패한 시험 둘만 고쳐 담은 commit(3a332c6bf)은 tests/ 만 닿아
    head_touches_wide 가 비었고 전체가 뜨지 않았다 — 실패 기록은 통과 기록보다 새로운 채
    남아 다음 code 커밋을 막았고, 남는 길이 `S9_FIX_RED` 뿐이었다(매번 쓰는 비상구는
    검사가 아니다, REQ-20260908-058). 이름 없는 표식은 판정하지 않는다."""
    red = _read_json(LAST_RED) if red is None else red
    if not red or _red_unnamed(red):
        return []
    files = set(str(f) for f in (red.get("files") or []))
    return [f for f in _commit_names(sha)
            if os.path.basename(f.replace("\\", "/")) in files]


def red_fixed_since(red, files=None):
    """실패 기록의 파일이 **전부** 그 실패 뒤에 commit 됐는가 (REQ-20260915-008-62x6).

    고치러 온 commit 이 이미 이력에 있으면 그 commit 이 전체를 띄웠고 결과는 곧 온다 —
    그동안 다음 commit 을 막지 않는다. 다시 실패하면 러너가 더 새로운 표식을 남기므로
    이 판정은 저절로 닫힌다. 원격 러너가 미커밋 변경 때문에 통과 기록을 못 남기는 동안
    (remote_run: 「통과 기록은 남기지 않는다」) 표식만 남아 막던 자리다."""
    if not red or _red_unnamed(red):
        return False
    files = set(str(f) for f in (files if files is not None else red.get("files") or []))
    files = {f for f in files if f}
    if not files:
        return False
    try:
        at = float(red.get("at") or 0)
    except (TypeError, ValueError):
        return False
    # --since 는 초 단위라 같은 초의 앞선 commit 도 든다 — commit 시각(%ct)이 실패 시각보다
    # 뒤인 것만 센다(실패와 같은 초에 이미 있던 commit 은 고친 것이 아니다).
    since = time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(at - 1))
    try:
        r = subprocess.run(["git", "log", f"--since={since}", "--name-only", "--format=%x01%ct", "HEAD"],
                           capture_output=True, encoding="utf-8", errors="replace",
                           cwd=ROOT, timeout=30, env=clean_git_env())
    except Exception:
        return False
    names, after = set(), False
    for ln in r.stdout.splitlines():
        if ln.startswith("\x01"):
            try:
                after = float(ln[1:].strip()) > at
            except ValueError:
                after = False
            continue
        if after and ln.strip():
            names.add(os.path.basename(ln.strip().replace("\\", "/")))
    return files <= names


def _pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def full_run_in_flight(jobs_dir=None):
    """지금 살아 있는 전체 실행(kind=full, pid 생존)의 pid — 없으면 0."""
    jobs_dir = jobs_dir or os.path.join(ROOT, "state", "jobs")
    try:
        names = os.listdir(jobs_dir)
    except OSError:
        return 0
    for n in names:
        if not (n.startswith("tests-") and n.endswith(".json")):
            continue
        d = _read_json(os.path.join(jobs_dir, n)) or {}
        pid = int(d.get("pid") or 0)
        if d.get("kind") == "full" and pid and _pid_alive(pid):
            return pid
    return 0


def after_commit(sha=None):
    """post-commit: 넓은 파일이 담긴 커밋이면 전체 스위트를 배경에서 띄운다. sha 는 훅이
    잡아 넘긴 그 커밋 — HEAD 는 그 사이 바뀌었을 수 있다(REQ-20260906-020).

    기다리지 않는다 — 단일비행(hold_run_lock)·같은 지문 재사용(green_seen)은
    러너가 이미 안다. 로그는 state/tests-async/<sha7>.log.
    """
    # 표식은 post-commit 훅의 첫 줄이 지운다 — 여기서도 지운다: 템플릿을 새로 놓기
    # 전의 훅(rm 줄이 없는 것)으로 커밋해도 잔재가 5분 동안 sync 를 세우지 않도록.
    commit_mark_clear()
    sha = sha or "HEAD"
    if not head_touches_wide(sha) and not head_fixes_red(sha):
        return 0
    try:
        r = subprocess.run([sys.executable or "python3", os.path.join(ROOT, "tests"),
                            "--is-green"], capture_output=True, cwd=ROOT, timeout=120,
                           env=clean_git_env())
        if r.returncode == 0:
            return 0                        # 이 tree 는 이미 통과다
    except Exception:
        pass
    # 전체 실행은 한 번에 하나 (REQ-20260905-022). 연속 commit 마다 하나씩 띄우면
    # 뒤의 것이 잠금 뒤에 줄을 서고 CPU 는 겹친다(실측 2026-09-05 20:13). 살아
    # 있는 전체 실행이 있으면 그 결과가 라쳇을 판정한다 — 새 것은 띄우지 않는다.
    live = full_run_in_flight()
    if live:
        print(f"s9-guard: 전체 테스트가 이미 실행 중이다(pid {live}) — 새로 띄우지 않는다. "
              f"그 결과가 실패면 고쳐질 때까지 다음 code 커밋이 막힌다.", file=sys.stderr)
        return 0
    try:
        sha = subprocess.run(["git", "rev-parse", "--short", sha], capture_output=True,
                             encoding="utf-8", cwd=ROOT, timeout=10,
                             env=clean_git_env()).stdout.strip() or "head"
        os.makedirs(ASYNC_DIR, exist_ok=True)
        log = open(os.path.join(ASYNC_DIR, f"{sha}.log"), "ab")
        env = clean_git_env()
        env.pop("S9_TESTS_NESTED", None)
        # 커밋 때 쓴 손잡이(S9_FIX_RED·S9_ALLOW_CONCURRENT)는 배경 실행에 물려주지
        # 않는다 — 물려주면 라쳇 시험이 스스로를 못 재고(실측: test_wide_gate w3b 실패),
        # 그 실행이 남긴 판정도 손잡이가 낀 것이 된다.
        for k in ("S9_FIX_RED", "S9_ALLOW_CONCURRENT", "S9_GIT_OK"):
            env.pop(k, None)
        # 결과가 스스로 도착한다 (REQ-20260906-029): 이 표식이 있을 때만 러너가 끝에
        # 수신함·REQ 노트·실패 요청을 쓴다. 손으로 돌린 실행은 이 표식이 없어 조용하다.
        # sha 도 함께 — HEAD 는 그 사이 문서 커밋으로 바뀌었을 수 있다.
        env["S9_TESTS_ASYNC"] = "1"
        env["S9_TESTS_ASYNC_SHA"] = sha
        # 원격이 기억돼 있으면(state/test-remote, REQ-20260905-012) 러너가 알아서
        # 원격으로 보낸다 — 48코어면 1분 안이고 중계 계열 간헐도 없다.
        remote = os.path.exists(os.path.join(ROOT, "state", "test-remote"))
        subprocess.Popen([sys.executable or "python3", os.path.join(ROOT, "tests"),
                          "--jobs", "16" if remote else "8"],
                         stdout=log, stderr=subprocess.STDOUT,
                         stdin=subprocess.DEVNULL, cwd=ROOT, env=env,
                         start_new_session=True)
        print(f"s9-guard: 전체 테스트를 백그라운드에서 시작했다{' (원격 머신)' if remote else ''} — "
              f"state/tests-async/{sha}.log (실패하면 고쳐질 때까지 다음 code 커밋이 막힌다)", file=sys.stderr)
    except Exception as e:
        print(f"s9-guard: 백그라운드 전체 테스트를 시작하지 못했다 ({e}) — `python3 tests/` 를 손으로",
              file=sys.stderr)
    return 0


def wide_change_gate(staged, verdict=None):
    """넓게 닿는 파일이 담기면 **전체 green 기록**을 묻는다 (REQ-20260903-012).

    실사고: `bin/s9` 한 줄(REQ-20260902-017 `_local_binding_glob`)이 커밋에
    담기지 않은 시험 18건을 깨뜨렸다. 위의 `staged_tests_gate` 는 담긴 시험과
    스모크 12파일만 보는데 그 열둘과 깨진 여덟 파일은 하나도 겹치지 않았다 —
    검사는 통과를 보고 통과시켰고 커밋은 실패한 채로 들어갔다.

    그렇다고 매 커밋에 전체를 물리지 않는다(분 단위라 규율이 먼저 죽는다).
    **돌리지 않고 묻는다**: 지금 이 tree 지문으로 전체가 통과였던 기록이
    있나(`python3 tests/ --is-green`, REQ-20260903-010 의 선택별 green 기록).
    있으면 비용 0으로 지나가고, 없을 때만 막으며 돌릴 명령을 그대로 보인다.

    검사가 고장 나면(파이썬 없음·시간 초과 등) 통과시킨다 — 검사가 고장 나
    모든 커밋을 막으면 그날로 사람이 검사를 꺼 버린다.
    """
    wide, green = verdict if verdict is not None else wide_change_verdict(staged)
    if not wide or green:
        return
    blocked, files = red_ratchet(staged)
    if blocked:
        print("s9-guard: 마지막 전체 테스트가 실패했고 그 뒤 통과 기록이 없습니다 — "
              "실패가 고쳐질 때까지 code 커밋을 막습니다.", file=sys.stderr)
        for f in files[:10]:
            print(f"  - 실패한 파일: {f}", file=sys.stderr)
        print("  그 파일을 고쳐 담거나(자동 통과), 그 파일만 실행해 통과하면 "
              "`python3 tests/` 로 전체 통과 기록을 다시 남기세요. 이 커밋이 그 "
              "고침이 아니면 `S9_FIX_RED=<REQ-id> git commit …` 으로 사유와 함께 "
              "지나갑니다.", file=sys.stderr)
        sys.exit(1)
    print("s9-guard: 넓게 닿는 파일이 담겼습니다 — 스모크 테스트와 담긴 테스트만 검사하고 "
          "지나가고, 전체 테스트는 commit 뒤 백그라운드에서 실행됩니다(state/tests-async/).",
          file=sys.stderr)


def secret_gate(staged):
    """비밀값이 커밋으로 새는 것을 막는다 (REQ-20260827-035).

    경로만 보면 부족하다 — **값만 다른 파일에 붙여 넣는 것이 실제 유출 경로다.**
    그래서 스테이지된 내용도 본다. 판정은 bin/s9 의 `secret_leak` 한 곳에 있다:
    가드와 CLI 가 각자 알면 한쪽만 고쳐진다.

    이 가드는 사고를 막는다. 작정하고 우회하는 것은 못 막고, 그 사실을 문서에
    그대로 적어 두었다.
    """
    try:
        import importlib.machinery
        import importlib.util
        sp = importlib.util.spec_from_loader(
            "_s9_secret", importlib.machinery.SourceFileLoader(
                "_s9_secret", os.path.join(ROOT, "bin", "s9")))
        m = importlib.util.module_from_spec(sp)
        sp.loader.exec_module(m)
        blob = subprocess.run(["git", "diff", "--cached"], capture_output=True,
                              encoding="utf-8", errors="replace", cwd=ROOT).stdout
        hits = m.secret_leak(staged, blob, root=ROOT)
        # 권한이 실린 설정 미러도 같은 자리에서 막는다 (REQ-20260827-045) —
        # 경계를 막아도 손으로 붙여 넣으면 그대로 들어온다.
        hits += m.config_leak(staged, blob)
    except Exception:
        return          # 가드 고장이 커밋을 막으면 안 된다 — 본 검사는 아래다
    if not hits:
        return
    print("s9-guard: 리포에 담지 않기로 한 것이 커밋에 섞여 있습니다 — 막았습니다.",
          file=sys.stderr)
    for h in hits[:10]:
        print(f"  - {h}", file=sys.stderr)
    print("비밀은 `s9 secret set <키>` 로 users/<이름>/secrets 에 두고, 명령에서는",
          file=sys.stderr)
    print("`s9 secret run -- <명령>` 의 {{secret:키}} 로 쓰세요 (값은 출력에서 가려집니다).",
          file=sys.stderr)
    sys.exit(1)


def commit_mark_path():
    return os.path.join(ROOT, "state", "commit-in-progress")


def commit_mark_set():
    """「지금 commit 이 진행 중」표식 (REQ-20260906-030). git 은 pre-commit 이 도는
    동안 HEAD 를 읽어 둔 채 기다리는데, 그 사이 sync 가 문서 커밋을 얹으면 이 커밋이
    `cannot lock ref 'HEAD'` 로 실패한다. sync_run 은 이 표식을 보면 그 회차를 미룬다.
    post-commit 훅이 지우고, 거부·예외로 post-commit 이 없는 경우는 main 이 지운다;
    둘 다 못 지운 잔재는 5분이 지나면 sync 가 무시한다."""
    try:
        os.makedirs(os.path.dirname(commit_mark_path()), exist_ok=True)
        with open(commit_mark_path(), "w", encoding="utf-8") as f:
            f.write(f"pid {os.getpid()} {time.strftime('%Y-%m-%dT%H:%M:%S')}\n")
    except OSError:
        pass


def commit_mark_clear():
    try:
        os.remove(commit_mark_path())
    except OSError:
        pass


def commit_msg_terms(path):
    """commit 메시지의 용어 검사 (REQ-20260906-064) — 경고만, 막지 않는다. 리드의 commit
    메시지가 「실패한 것 셋」을 색의 비유로 적었고, 그 말이 로그로 남아 다음 사람이
    읽는다."""
    try:
        with open(path, encoding="utf-8") as f:
            msg = "".join(ln for ln in f if not ln.startswith("#"))
    except OSError:
        return 0
    try:
        subprocess.run([sys.executable or "python3", os.path.join(ROOT, "bin", "s9"),
                        "terms", "check", "--where", "commit 메시지"], input=msg,
                       encoding="utf-8", errors="replace", timeout=20,
                       env=clean_git_env())
    except Exception:
        pass
    return 0


RED_CAUSE_LINE = "원인:"


def red_cause_warning(msg, red, green_age=None, now=None):
    """실패 기록이 남아 있는 채로 commit 하는데 메시지에 「원인:」 줄이 없으면 경고 문장,
    아니면 '' (REQ-20260909-060). 막지 않는다.

    실패 요청 문서는 30분 안에 못 고칠 때만 서므로, 그 전에 고치는 커밋이 원인 한 줄을
    남길 자리는 commit 메시지뿐이다 — 나흘 34건의 원인 분류(REQ-20260909-053)가
    그 한 줄로 가능했다. 판정은 red_ratchet 과 같은 재료(기록 시각 vs 마지막 통과)로
    하되 S9_FIX_RED·담긴 시험 예외는 보지 않는다 — 어느 길로 지나가든 원인은 적는다."""
    if not red or not red.get("at") or _red_unnamed(red):
        return ""
    now = time.time() if now is None else now
    green_at = None if green_age is None else now - green_age
    if green_at is not None and green_at >= float(red["at"]):
        return ""
    for ln in (msg or "").splitlines():
        t = ln.strip()
        if t.startswith("#"):
            continue
        if t.startswith(RED_CAUSE_LINE) and t[len(RED_CAUSE_LINE):].strip():
            return ""
    files = ", ".join(str(f) for f in (red.get("files") or []))
    return (f"s9-guard: 전체 테스트 실패 기록이 있는 채로 commit 합니다({files}) — "
            f"메시지에 「{RED_CAUSE_LINE} <실패의 원인 한 줄>」 을 적어 주세요. "
            "막지 않습니다 (REQ-20260909-060).")


def commit_msg_red_cause(path):
    """commit-msg 훅 — red_cause_warning 을 stderr 로. 경고만, 종료 코드 0."""
    red = _read_json(LAST_RED)
    if not red:
        return 0
    try:
        with open(path, encoding="utf-8") as f:
            msg = f.read()
    except OSError:
        return 0
    warn = red_cause_warning(msg, red, green_age=full_green_age())
    if warn:
        print(warn, file=sys.stderr)
    return 0


def commit_msg_swept(path):
    """작업자가 붙은 채 지나간 커밋에는 **쓸려 담긴 파일이 적힌다**
    (REQ-20260907-062).

    2026-09-07 18:26 의 아픈 곳이 이것이었다: 리드의 커밋에 남의 진행 중 변경
    셋이 들어갔는데 **커밋 메시지가 그 셋을 설명하지 않았다.** 다음 사람은
    「Stream 행 제목」 커밋에서 실브라우저 시험이 바뀐 까닭을 찾지 못한다.
    막지는 않는다 — 지나간 것을 **보이게** 만드는 일이다.
    """
    mark = os.path.join(ROOT, "state", "concurrent-swept.txt")
    try:
        with open(mark, encoding="utf-8") as f:
            files = [ln.strip() for ln in f if ln.strip()]
    except OSError:
        return
    try:
        os.remove(mark)
    except OSError:
        pass
    if not files:
        return
    try:
        with open(path, encoding="utf-8") as f:
            msg = f.read()
        tail = ("\n다른 작업자가 붙은 채 담긴 파일 (S9_ALLOW_CONCURRENT):\n"
                + "".join(f"  {x}\n" for x in files))
        if tail.strip() in msg:
            return
        with open(path, "a", encoding="utf-8") as f:
            f.write(tail)
    except OSError:
        pass


REQ_ID_RE = re.compile(r"REQ-\d{8}-\d{3}(?:-[0-9a-z]{4})?")
# 문서에는 남의 요청 id 가 당연히 있다 — vault·docs 와 .md 는 대조하지 않는다.
HUNK_ID_SKIP_PREFIX = ("vault/", "docs/")


def _req_base(rid):
    """접미(-62x6)가 있든 없든 같은 요청이다 — 앞 16자로 견준다."""
    return rid[:16]


def foreign_req_ids(diff_text, msg):
    """담긴 + 줄의 요청 id 중 커밋 메시지에 없는 것 → {id: 줄 수} (REQ-20260909-058).

    `git diff --cached -U0` 의 본을 받는다. 파일 머리(`--- a/…` 다음의 `+++ b/…`)로
    지금 어느 파일인지 좇고, 문서 경로는 건너뛴다. 한 줄에 같은 id 가 두 번이어도
    한 줄로 센다 — 사람이 볼 것은 「어느 hunk 몇 줄」이다."""
    known = {_req_base(m) for m in REQ_ID_RE.findall(msg)}
    counts = {}
    shown = {}
    path = None
    after_minus_header = False
    for ln in diff_text.splitlines():
        if ln.startswith("--- "):
            after_minus_header = True
            continue
        if after_minus_header and ln.startswith("+++ "):
            after_minus_header = False
            path = ln[4:].split("\t", 1)[0]
            if path.startswith("b/"):
                path = path[2:]
            continue
        after_minus_header = False
        if not ln.startswith("+") or path is None or path == "/dev/null":
            continue
        if path.startswith(HUNK_ID_SKIP_PREFIX) or path.endswith(".md"):
            continue
        seen = {}
        for m in REQ_ID_RE.findall(ln[1:]):
            b = _req_base(m)
            if b not in known:
                seen[b] = m if len(m) >= len(seen.get(b, "")) else seen[b]
        for b, full in seen.items():
            counts[b] = counts.get(b, 0) + 1
            if len(full) > len(shown.get(b, "")):
                shown[b] = full
    return {shown[b]: n for b, n in counts.items()}


def commit_msg_hunk_ids(path, cwd=None):
    """commit-msg 훅: 담긴 + 줄의 다른 요청 id 를 경고한다 — 막지 않는다
    (REQ-20260909-058).

    ff6fba57 은 036 작업자가 `git add bin/s9.py` 로 파일의 지금 상태를 담아
    033/034 의 hunk(주석에 그 id 가 적혀 있었다)가 딸려갔다. pre-commit 에는
    메시지가 아직 없고, commit-msg 시점에도 index 는 그대로 있으니 자리는 여기다."""
    try:
        with open(path, encoding="utf-8") as f:
            msg = "".join(ln for ln in f if not ln.startswith("#"))
    except OSError:
        return {}
    try:
        diff = subprocess.run(["git", "diff", "--cached", "-U0"],
                              capture_output=True, encoding="utf-8", errors="replace",
                              cwd=cwd or ROOT, timeout=60).stdout
    except Exception:
        return {}
    found = foreign_req_ids(diff, msg)
    if found:
        for rid, n in sorted(found.items()):
            print(f"[s9-guard] 담긴 + 줄에 커밋 메시지에 없는 요청 id: {rid} ({n}줄)",
                  file=sys.stderr)
        print("  남의 hunk 가 딸려온 것이면 `git add -p <파일>` 로 내 hunk 만 담거나 "
              "메시지에 그 id 를 적으세요 (REQ-20260909-058).", file=sys.stderr)
    return found


def main():
    if "--concurrent" in sys.argv[1:]:
        # 조회다 — 커밋 표식도 남기지 않고 어느 검사도 돌리지 않는다.
        paths = [a for a in sys.argv[1:] if a != "--concurrent"]
        return concurrent_report(paths or staged_now())
    if sys.argv[1:2] == ["commit-msg"] and len(sys.argv) > 2:
        commit_msg_swept(sys.argv[2])
        commit_msg_hunk_ids(sys.argv[2])
        commit_msg_red_cause(sys.argv[2])
        return commit_msg_terms(sys.argv[2])
    if "--after-commit" in sys.argv[1:]:
        k = sys.argv.index("--after-commit")
        sha = sys.argv[k + 1] if len(sys.argv) > k + 1 and not sys.argv[k + 1].startswith("-") else None
        return after_commit(sha)
    commit_mark_set()
    try:
        _pre_commit_gates()
    except SystemExit as e:
        if e.code not in (0, None):
            commit_mark_clear()      # 거부된 커밋에는 post-commit 이 없다
        raise
    except BaseException:
        commit_mark_clear()
        raise
    # 통과 — 표식은 남긴다. commit 이 실제로 HEAD 를 쓰고 post-commit 이 지운다.


def state_gate(staged):
    """state/ 는 기계 살림이다 — index 에 넣지 마라 (REQ-20260909-024). `.gitignore` 는
    `git add -f` 와 옛 추적을 못 막는다; 두 기계가 각자 고치는 같은 이름의 파일이
    추적되면 pull 이 「would be overwritten」로 멈춘다(맥미니 12시간 실측)."""
    # 삭제(D)는 index 에서 **빼는** 것이라 막지 않는다 — untrack 커밋(REQ-20260909-024
    # B단계)이 바로 그 모양이다(맥 실측 2026-09-09 10:51: 첫 판이 D 까지 세어 untrack 을
    # 거부했다). 더하거나 고치는 것(A·C·M·R)만 본다.
    try:
        added = subprocess.run(
            ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR"],
            capture_output=True, encoding="utf-8", errors="replace", cwd=ROOT).stdout.splitlines()
    except Exception:
        added = list(staged or [])
    hits = [f for f in added if f == "state" or f.startswith("state/")]
    if not hits:
        return
    print("[s9-guard] state/ 는 이 기계의 살림이다 — index 에 넣지 마라 (REQ-20260909-024): "
          + ", ".join(hits[:5]) + ("…" if len(hits) > 5 else ""), file=sys.stderr)
    print("  담긴 것을 빼려면: git rm -r --cached " + " ".join(hits[:5]), file=sys.stderr)
    sys.exit(1)


def _pre_commit_gates():
    staged = staged_now()
    staged_compile_gate(staged)   # 가장 싸고, 깨진 본은 아래 어느 검사도 볼 필요가 없다
    state_gate(staged)            # 기계 살림은 index 에 못 들어간다
    file_size_gate(staged)        # stat 만 본다 — 시험보다 앞이라 값이 거의 0이다
    concurrent_gate(staged)
    # **넓은 변경 판정을 먼저 묻는다** (REQ-20260904-003). 아래 검사가 시험을
    # 돌리면 그 실행이 tree 를 건드려(임시 파일·복원되는 파일) 지문이 움직이고,
    # 그러면 방금 만든 전체 통과 기록을 이 검사가 못 알아본다 — 사람이 시키는 대로
    # `python3 tests/` 를 돌려 통과를 만들어도 커밋이 또 막힌다(실측 2026-09-04:
    # 13:12 에 `--is-green` 이 0 이었는데 13:19 커밋에서 같은 검사가 막았다).
    # 묻는 값은 **커밋 시점의 tree**여야 한다. 그래서 판정을 먼저 뜨고,
    # 막을지는 시험 검사 뒤에 정한다 — 순서가 바뀌어도 사람이 보는 차례
    # (시험 실패가 먼저)는 그대로다.
    wide_verdict = wide_change_verdict(staged)
    # 담긴 diff 는 한 번만 뜬다 — 관련 시험 선택(REQ-20260909-059)과 역할 변경
    # 검사(REQ-20260902-032, 프로필 파일 전체가 아니라 `role:` 줄만)가 같이 읽는다.
    diff_text = staged_diff_text(staged)
    staged_tests_gate(staged, diff_text, deleted_now())
    wide_change_gate(staged, wide_verdict)
    secret_gate(staged)
    hits = protected_hits(staged)
    role_hits = role_change_hits(staged, diff_text)
    if not hits and not role_hits:
        sys.exit(0)

    user = current_user()
    role = role_of(user)
    if role == "admin":
        sys.exit(0)

    if role_hits:
        print("s9-guard: 사용자 역할(role:)을 바꾸는 커밋입니다 — admin 만 할 수 있습니다:",
              file=sys.stderr)
        for f in role_hits[:10]:
            print(f"  - {f}", file=sys.stderr)
    if hits:
        print("s9-guard: harness 보호 경로(실행 권위를 갖는 텍스트 포함)가 커밋에 "
              "포함되어 있습니다:", file=sys.stderr)
    for f in hits[:10]:
        print(f"  - {f}", file=sys.stderr)
    who = f"{user} (role: {role or '미등록'})"
    print(f"현재 사용자 {who} 는 admin이 아니므로 커밋이 거부됩니다.", file=sys.stderr)
    print("admin이라면: S9_USER=<admin이름> git commit ... 또는 s9 user role 로 역할 부여.",
          file=sys.stderr)
    print("(harness 변경은 PR로 제안하고 admin 승인을 받는 것이 원칙 — docs/09)",
          file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
    main()
