#!/usr/bin/env python3
"""section9 harness guard (git pre-commit hook).

보호 경로(harness)가 커밋에 포함되면 현재 사용자의 role을 확인해
admin이 아니면 커밋을 거부한다.

인가(authorization)만 있고 인증(authentication)은 없다 — S9_USER 위조로
우회 가능하며, 이는 의도된 설계다(실수 방지 + 규율 + 감사가 목표).
우회 불가능한 최종 게이트는 GitHub branch protection + CODEOWNERS (docs/09).
"""
import json
import os
import re
import subprocess
import sys


# 윈도우에서 출력을 UTF-8 로 고정한다 (REQ-20260903-005). 이 도구들의 출력은
# 거의 다 한국어인데, 파이프로 받으면 파이썬이 콘솔 코드페이지(한국어 윈도우는
# cp949)로 인코딩한다 — 실측에서 그 출력을 UTF-8 로 읽은 쪽이 통째로 깨졌다
# (`UnicodeDecodeError: 0xc0 in position 3`). 파일에 남는 기록도 같은 이유로
# 판마다 다른 바이트가 된다. 판을 가르는 자리는 이름을 붙여 한 곳에 둔다:
# 여기가 그 자리이고, 도구마다 같은 글자로 서 있는지는 시험이 못박는다.
if os.name == "nt":
    for _std in (sys.stdout, sys.stderr):
        try:
            _std.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, ValueError, OSError):
            pass

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "bin"))

PROTECTED = ("bin/", "web/", "harness/", ".github/", ".gitignore", ".gitattributes")
# **실행 권위를 갖는 텍스트**도 코드다 (REQ-20260902-032, white-hacker 검토 시나리오
# 4·5). `projects/<slug>/agents/*.md` 는 워커 프롬프트 서두에 그대로 주입되고
# `.claude/agents` 로 미러돼 네이티브 서브에이전트 정의가 된다. `users/<u>/skills|agents`
# 는 `~/.claude` 에 symlink 된다. 데이터 경로에 산다는 이유로 무보호였다 —
# 공유 리포에서는 push 권한자가 남의 세션 에이전트 정의를 바꿔 쓸 수 있었다.
PROTECTED_RE = (
    re.compile(r"^projects/[^/]+/agents/"),
    re.compile(r"^users/[^/]+/(skills|agents)/"),
)


def protected_hits(staged):
    """보호 경로에 걸리는 스테이지 파일 — 접두 목록과 패턴 목록을 한 자리에서."""
    out = []
    for f in staged:
        q = f.replace("\\", "/")
        if q.startswith(PROTECTED) or any(r.search(q) for r in PROTECTED_RE):
            out.append(f)
    return out


def role_change_hits(staged, diff_text):
    """profile.md 의 `role:` 줄을 바꾸는 커밋 (REQ-20260902-032).

    프로필은 훅이 늘 고쳐 쓰는 데이터 파일이라 통째로 보호할 수 없다 — 그러면
    모든 사람의 모든 커밋이 막힌다. 그래서 **바뀐 줄**을 본다: 스테이지 diff 에
    `+role:` 또는 `-role:` 이 있으면 그것은 역할 변경이고, admin 만 할 수 있다
    (`s9 user role` 의 CLI 검사와 같은 규칙 — REQ-20260902-029)."""
    files = [f for f in staged
             if re.search(r"(^|/)users/[^/]+/profile\.md$", f.replace("\\", "/"))]
    if not files or not diff_text:
        return []
    hits, cur = [], ""
    for line in diff_text.splitlines():
        if line.startswith("+++ b/"):
            cur = line[6:]
            continue
        if cur in files and re.match(r"^[+-]role:", line):
            if cur not in hits:
                hits.append(cur)
    return hits

# 동시 작업 보호 (REQ-20260826-021). 2026-08-26 하루에 같은 뿌리의 사고가 넷 났다.
# 21:42 에는 리드가 `git add web/index.html` 로 커밋하면서 같은 파일을 고치던
# 워커의 진행 중 편집을 함께 담았다 — 결과는 문법적으로 멀쩡해 커밋도 되고
# 서버도 뜨는 **반쪽 상태**였고, 같은 커밋에 들어 있던 테스트조차 통과 못 했다.
# 돌리기만 했으면 잡혔다.
#
# 그래서 게이트 둘: ① 무인 워커가 도는데 방금 만져진 파일을 담으려 하면 막는다
# ② 커밋에 테스트 파일이 있으면 그것만이라도 돌린다(전체 스위트는 2분이라 매
# 커밋에 물릴 수 없다 — 그 무게가 규율을 죽인다).
# 창의 폭은 **에이전트가 일하는 모습**에 맞춘다 (REQ-20260827-012).
# 처음엔 90초였다 — "방금 저장한 파일"을 잡으려는 값이다. 그런데 에이전트는
# 덩어리로 일한다: 몇 분 생각하고 한 번 쓰고, 또 몇 분 생각한다. **쓰는 순간은
# 드물고 잡고 있는 시간은 길다.** 실측(08:29): designer 가 4초 전까지 활동
# 중이었는데 그가 잡은 파일의 마지막 저장은 209초 전이라 게이트가 조용히
# 통과시켰다.
#
# 21:42 사고를 다시 보면 더 분명하다 — 워커의 마지막 저장과 리드의 `git add`
# 사이가 90초 안이었던 것은 **운**이었고, 몇 분만 어긋났어도 이 게이트는 그
# 사고를 못 막는다.
FRESH_SEC = 900                     # 15분: 에이전트가 파일을 잡고 있는 폭
OVERRIDE = "S9_ALLOW_CONCURRENT"    # 사람이 확인했으면 이걸로 지나간다


def current_user():
    u = os.environ.get("S9_USER")
    if u:
        return u
    import getpass
    acct = getpass.getuser()
    # 운영체제 계정을 그대로 쓰기 전에 os_accounts 별칭을 본다
    # (REQ-20260829-010). 계정 이름과 하네스의 사용자 이름이 다르면 그 사람은
    # 여기서 늘 '미등록'이고, admin 이어도 막힌다 — 그러면 권한 있는 사람이
    # `S9_USER=<admin> git commit` 을 손에 익히게 되고, 그 습관은 게이트가
    # 정말 막아야 할 때도 그대로 나온다. bin/s9 의 resolve_user() 는 이미 이
    # 매칭을 한다(REQ-20260827-060 이 CLI 와 화면 사이에서 겪은 것과 같은
    # 갈림이다 — 이번엔 CLI 와 게이트가 갈렸다).
    return _user_by_os_account(acct) or acct


def _user_by_os_account(acct):
    """os_accounts 에 이 운영체제 계정을 적어 둔 등록 사용자.

    매칭이지 승격이 아니다 — 모르는 계정은 그대로 두고, 역할은 role_of() 가
    따로 본다. 프로필이 깨져 있어도 커밋을 터뜨리지 않는다."""
    users = os.path.join(ROOT, "users")
    try:
        names = sorted(os.listdir(users))
    except OSError:
        return ""
    for name in names:
        profile = os.path.join(users, name, "profile.md")
        try:
            with open(profile, encoding="utf-8") as f:
                for line in f:
                    if not line.startswith("os_accounts:"):
                        continue
                    raw = line.split(":", 1)[1].strip()
                    try:
                        val = json.loads(raw)
                    except ValueError:
                        break
                    if isinstance(val, str):
                        val = [val]
                    if isinstance(val, list) and acct in val:
                        return name
                    break
        except OSError:
            continue
    return ""


def role_of(user):
    profile = os.path.join(ROOT, "users", user, "profile.md")
    try:
        with open(profile, encoding="utf-8") as f:
            for line in f:
                if line.startswith("role:"):
                    return line.split(":", 1)[1].strip()
        return "member"  # 등록됐지만 role 미지정
    except OSError:
        return ""  # 미등록


def live_workers():
    """지금 도는 작업 주체 — s9 에게 묻는다(판정을 두 벌로 두지 않는다).

    무인 워커뿐 아니라 서브에이전트도 포함된다 (REQ-20260827-002). 판정을
    여기 옮겨 오지 않고 `s9 workers` 에게 계속 묻는 덕에, 주체의 종류가
    늘어도 이 훅은 고칠 것이 없었다 — 실제로 서브에이전트를 더할 때
    이 함수는 한 줄도 안 바뀌었다.
    """
    try:
        out = subprocess.run([sys.executable, os.path.join(ROOT, "bin", "s9"), "workers",
                              "--quiet"], capture_output=True,
                                  encoding="utf-8", errors="replace",
                             cwd=ROOT, timeout=15)
        return [l for l in out.stdout.splitlines() if l.strip()]
    except Exception:
        return []


def concurrent_gate(staged):
    """워커가 도는 중에 '방금 만져진' 파일을 담으려 하면 막는다."""
    if os.environ.get(OVERRIDE):
        return
    workers = live_workers()
    if not workers:
        return
    import time
    now = time.time()
    fresh = []
    for f in staged:
        p = os.path.join(ROOT, f)
        try:
            age = now - os.path.getmtime(p)
        except OSError:
            continue
        if age < FRESH_SEC:
            fresh.append((f, int(age)))
    if not fresh:
        return
    print("s9-guard: 다른 작업자가 붙어 있는 중에, 그 사이 바뀐 파일을 "
          "담으려 합니다.", file=sys.stderr)
    print("  지금 도는 작업자:", file=sys.stderr)
    for w in workers[:5]:
        print(f"    {w}", file=sys.stderr)
    print("  최근에 바뀐 스테이지 파일:", file=sys.stderr)
    for f, age in fresh[:10]:
        m, sec = age // 60, age
        when = f"{m}분 전" if m else f"{sec}초 전"
        print(f"    - {f}  ({when} 바뀜)", file=sys.stderr)
    print("`git add <경로>` 는 '내 변경'이 아니라 '그 파일의 지금 상태'를 담습니다 —",
          file=sys.stderr)
    print("남이 쓰는 중이면 남의 미완성이 이 커밋의 일부가 됩니다(2026-08-26 21:42 실사고).",
          file=sys.stderr)
    print("`git diff --cached` 로 담기는 내용을 실제로 읽고, 네 것만 맞으면",
          file=sys.stderr)
    print(f"`{OVERRIDE}=1 git commit ...` 으로 진행하세요.", file=sys.stderr)
    sys.exit(1)


# git 이 훅에게 물려주는 환경변수. 훅이 부르는 자식은 이걸 물려받으면 안 된다.
GIT_ENV_VARS = ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE",
                "GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES",
                "GIT_COMMON_DIR", "GIT_PREFIX", "GIT_INDEX_VERSION",
                "GIT_QUARANTINE_PATH")


def clean_git_env(env=None):
    """훅이 물려받은 git 환경을 벗겨서 준다 (REQ-20260829-005).

    git 은 훅에 GIT_DIR 을 넘긴다. 워크트리에서 커밋하면 그 값은
    `<repo>/.git/worktrees/<이름>` 이다. 이 환경을 물려받은 자식이 `git init` 을
    부르면 — `-C <다른 경로>` 를 붙였든 말든 — GIT_DIR 이 이기므로 그 자리를
    다시 init 하고, 작업 트리가 없다고 판단해 **공용 .git/config 에
    core.bare=true 를 박는다**. 그 순간 본 체크아웃에서 status·add·commit 이
    전부 'must be run in a work tree' 로 거부된다.

    2026-08-29 에 실제로 이 경로로 매분 뒤집혔다: serve 의 워크트리 자동 보존
    커밋 → 이 훅 → 스테이지 테스트 → 임시 리포에 `git init`. 파일은 멀쩡해서
    커밋하려는 순간에야 드러난다.
    """
    e = dict(os.environ if env is None else env)
    for k in GIT_ENV_VARS:
        e.pop(k, None)
    return e


def staged_tests_gate(staged):
    """커밋 게이트 = 담긴 시험 ∪ 스모크 (REQ-20260830-029, 필수 계층 배선).

    21:42 커밋은 같은 커밋에 들어 있던 테스트조차 통과 못 했다. 전체 스위트는
    분 단위라 매 커밋에 물리면 규율이 먼저 죽는다 — 그래서 담긴 시험에
    **핵심 계약 12파일(--smoke)** 만 합친다: 병렬(--jobs 4)로 30~40초에 유계다.
    --changed 를 여기 쓰지 않는 이유: bin/s9 는 미커밋 변경이 잦아 매번 전체
    폴백(4분대)으로 밀린다 — 전체 확인은 review/done 전 수동 실행의 몫이다.
    담긴 시험은 정확한 파일명으로 넘긴다(러너가 정확명은 넓히지 않는다) —
    조각으로 넘기면 이웃 파일까지 끌려와 게이트가 뚱뚱해진다.
    """
    names = [os.path.basename(f)
             for f in staged
             if f.startswith("tests/test_") and f.endswith(".py")]
    if not names and not any(f.startswith(("bin/", "web/", "tests/"))
                             for f in staged):
        return   # 코드가 안 담겼으면(문서·상태 커밋) 게이트 생략 — 종전과 같다
    r = subprocess.run(["python3", "tests/", "--smoke", "--jobs", "4", *names],
                       capture_output=True,
                       encoding="utf-8", errors="replace", cwd=ROOT, timeout=600,
                       env=clean_git_env())
    if r.returncode == 0:
        return
    print("s9-guard: 커밋 게이트(담긴 시험 ∪ 스모크)가 실패합니다 — 커밋을 멈춥니다.",
          file=sys.stderr)
    print(f"  대상: 스모크 12파일 ∪ {' '.join(names) or '(담긴 시험 없음)'}",
          file=sys.stderr)
    _show_gate_failure(r)
    sys.exit(1)


def _show_gate_failure(r):
    """실패한 자리를 보여 준다 — 마지막 몇 줄이 아니라 (REQ-20260904-003).

    예전엔 출력의 **마지막 25줄**만 찍었다. 순차라면 그 자리가 실패 요약이지만,
    게이트는 `--jobs 4` 로 돈다 — 실패한 샤드의 출력이 먼저 나오고 통과한
    샤드가 뒤에 온다. 그래서 「실패합니다」라고 말한 뒤 **초록 결과를 보여
    줬다.** 2026-09-04 에 그 화면을 세 번 보고도 원인을 못 읽었다.

    막기만 하고 이유를 안 보여 주는 문은 사람이 `--no-verify` 를 배우게 한다.
    그러니 ① 실패한 줄과 그 앞뒤를 골라 보이고, ② 전문은 파일로 남겨 그
    경로를 말한다. 고르기가 빗나가도 전문이 있으면 사람은 길을 잃지 않는다.
    """
    import re as _re
    all_out = (r.stdout or "") + (r.stderr or "")
    lines = all_out.splitlines()
    try:
        os.makedirs(os.path.join(ROOT, "state"), exist_ok=True)
        full = os.path.join(ROOT, "state", "last-gate.log")
        with open(full, "w", encoding="utf-8") as f:
            f.write(all_out)
    except OSError:
        full = ""
    hot = _re.compile(r"^(FAIL|ERROR):|^FAILED|실패한 샤드|Traceback")
    marks = [i for i, ln in enumerate(lines) if hot.search(ln)]
    if marks:
        shown, last = 0, -1
        for i in marks:
            if shown >= 60:
                print("  … (남은 실패는 전문에서)", file=sys.stderr)
                break
            lo = max(last + 1, i - 1)
            for j in range(lo, min(len(lines), i + 12)):
                print(f"  {lines[j]}", file=sys.stderr)
                shown += 1
            last = min(len(lines), i + 12) - 1
    else:
        # 표식이 없으면 샤드가 **죽은** 것이다 — 끊긴 자리가 곧 단서다.
        print("  실패 표식이 없다 — 샤드가 도중에 죽었을 수 있다. 끊긴 자리:",
              file=sys.stderr)
        for ln in lines[-15:]:
            print(f"  {ln}", file=sys.stderr)
    if full:
        print(f"  전문: {full}", file=sys.stderr)


# 어디에 닿을지 셀 수 없는 파일 (REQ-20260903-012). 원본은 tests/__main__.py 의
# `COMMON` 이고 여기는 그 사본이다 — 훅은 시험 러너를 import 하지 않는다(그
# import 하나가 포트풀·임시자리까지 끌고 온다). 두 목록이 갈리는지는
# tests/test_wide_gate.py 가 값으로 대 본다.
WIDE = ("bin/s9", "bin/s9.py", "tests/__main__.py", "tests/portpool.py",
        "tests/tmproot.py", "tests/jobfile.py", "tests/precious.py")


def wide_change_verdict(staged):
    """(넓은 파일 목록, 지금 이 나무가 전체 초록인가) — **묻기만** 한다.

    시험을 한 건도 돌리지 않는다. 게이트가 시험을 돌리기 **전에** 떠 둬야
    그 실행의 부산물이 판정을 뒤집지 못한다 (REQ-20260904-003).
    고장 나면 초록으로 답한다 — 문이 고장 나 모든 커밋을 막으면 그날로 뽑힌다.
    """
    wide = [f for f in staged if f.replace("\\", "/") in WIDE]
    if not wide:
        return ([], True)
    try:
        r = subprocess.run([sys.executable or "python3",
                            os.path.join(ROOT, "tests"), "--is-green"],
                           capture_output=True, encoding="utf-8",
                           errors="replace", cwd=ROOT, timeout=120,
                           env=clean_git_env())
    except Exception:
        return (wide, True)
    return (wide, r.returncode == 0)


def wide_change_gate(staged, verdict=None):
    """넓게 닿는 파일이 담기면 **전체 green 기록**을 묻는다 (REQ-20260903-012).

    실사고: `bin/s9` 한 줄(REQ-20260902-017 `_local_binding_glob`)이 커밋에
    담기지 않은 시험 18건을 깨뜨렸다. 위의 `staged_tests_gate` 는 담긴 시험과
    스모크 12파일만 보는데 그 열둘과 깨진 여덟 파일은 하나도 겹치지 않았다 —
    게이트는 초록을 보고 통과시켰고 커밋은 붉은 채로 들어갔다.

    그렇다고 매 커밋에 전체를 물리지 않는다(분 단위라 규율이 먼저 죽는다).
    **돌리지 않고 묻는다**: 지금 이 나무 지문으로 전체가 초록이었던 기록이
    있나(`python3 tests/ --is-green`, REQ-20260903-010 의 선택별 green 기록).
    있으면 비용 0으로 지나가고, 없을 때만 막으며 돌릴 명령을 그대로 보인다.

    게이트가 고장 나면(파이썬 없음·시간 초과 등) 통과시킨다 — 문이 고장 나
    모든 커밋을 막으면 그날로 문이 뽑힌다.
    """
    wide, green = verdict if verdict is not None else wide_change_verdict(staged)
    if not wide or green:
        return
    print("s9-guard: 넓게 닿는 파일이 담겼는데 이 상태에서 전체 스위트가 "
          "통과한 기록이 없습니다 — 커밋을 멈춥니다.", file=sys.stderr)
    for f in wide[:10]:
        print(f"  - {f}", file=sys.stderr)
    print("  이 파일들은 어느 시험에 닿을지 셀 수 없어, 담긴 시험과 스모크만으로는",
          file=sys.stderr)
    print("  깨진 곳을 못 봅니다. 한 번 돌리고 다시 커밋하세요:", file=sys.stderr)
    print("      python3 tests/", file=sys.stderr)
    print("  (통과하면 그 기록이 남아 다음 커밋은 그냥 지나갑니다.)",
          file=sys.stderr)
    sys.exit(1)


def secret_gate(staged):
    """비밀값이 커밋으로 새는 것을 막는다 (REQ-20260827-035).

    경로만 보면 부족하다 — **값만 다른 파일에 붙여 넣는 것이 실제 유출 경로다.**
    그래서 스테이지된 내용도 본다. 판정은 bin/s9 의 `secret_leak` 한 곳에 있다:
    가드와 CLI 가 각자 알면 한쪽만 고쳐진다.

    이 가드는 사고를 막는다. 작정하고 우회하는 것은 못 막고, 그 사실을 문서에
    그대로 적어 두었다.
    """
    try:
        import importlib.machinery
        import importlib.util
        sp = importlib.util.spec_from_loader(
            "_s9_secret", importlib.machinery.SourceFileLoader(
                "_s9_secret", os.path.join(ROOT, "bin", "s9")))
        m = importlib.util.module_from_spec(sp)
        sp.loader.exec_module(m)
        blob = subprocess.run(["git", "diff", "--cached"], capture_output=True,
                              encoding="utf-8", errors="replace", cwd=ROOT).stdout
        hits = m.secret_leak(staged, blob, root=ROOT)
        # 권한이 실린 설정 미러도 같은 자리에서 막는다 (REQ-20260827-045) —
        # 경계를 막아도 손으로 붙여 넣으면 그대로 들어온다.
        hits += m.config_leak(staged, blob)
    except Exception:
        return          # 가드 고장이 커밋을 막으면 안 된다 — 본 게이트는 아래다
    if not hits:
        return
    print("s9-guard: 리포에 담지 않기로 한 것이 커밋에 섞여 있습니다 — 막았습니다.",
          file=sys.stderr)
    for h in hits[:10]:
        print(f"  - {h}", file=sys.stderr)
    print("비밀은 `s9 secret set <키>` 로 users/<이름>/secrets 에 두고, 명령에서는",
          file=sys.stderr)
    print("`s9 secret run -- <명령>` 의 {{secret:키}} 로 쓰세요 (값은 출력에서 가려집니다).",
          file=sys.stderr)
    sys.exit(1)


def main():
    out = subprocess.run(["git", "diff", "--cached", "--name-only"],
                         capture_output=True,
                             encoding="utf-8", errors="replace", cwd=ROOT)
    staged = [l for l in out.stdout.splitlines() if l.strip()]
    concurrent_gate(staged)
    # **넓은 변경 판정을 먼저 묻는다** (REQ-20260904-003). 아래 게이트가 시험을
    # 돌리면 그 실행이 나무를 건드려(임시 파일·복원되는 파일) 지문이 움직이고,
    # 그러면 방금 만든 전체 초록 기록을 이 문이 못 알아본다 — 사람이 시키는 대로
    # `python3 tests/` 를 돌려 초록을 만들어도 커밋이 또 막힌다(실측 2026-09-04:
    # 13:12 에 `--is-green` 이 0 이었는데 13:19 커밋에서 같은 문이 막았다).
    # 묻는 값은 **커밋 시점의 나무**여야 한다. 그래서 판정을 먼저 뜨고,
    # 막을지는 시험 게이트 뒤에 정한다 — 순서가 바뀌어도 사람이 보는 차례
    # (시험 실패가 먼저)는 그대로다.
    wide_verdict = wide_change_verdict(staged)
    staged_tests_gate(staged)
    wide_change_gate(staged, wide_verdict)
    secret_gate(staged)
    hits = protected_hits(staged)
    # 역할 변경은 프로필 파일 전체가 아니라 그 줄만 본다 (REQ-20260902-032)
    try:
        diff_text = subprocess.run(["git", "diff", "--cached", "-U0", "--",
                                    *[f for f in staged if f.endswith("profile.md")]],
                                   capture_output=True, encoding="utf-8", errors="replace", cwd=ROOT).stdout \
            if any(f.endswith("profile.md") for f in staged) else ""
    except Exception:
        diff_text = ""
    role_hits = role_change_hits(staged, diff_text)
    if not hits and not role_hits:
        sys.exit(0)

    user = current_user()
    role = role_of(user)
    if role == "admin":
        sys.exit(0)

    if role_hits:
        print("s9-guard: 사용자 역할(role:)을 바꾸는 커밋입니다 — admin 만 할 수 있습니다:",
              file=sys.stderr)
        for f in role_hits[:10]:
            print(f"  - {f}", file=sys.stderr)
    if hits:
        print("s9-guard: harness 보호 경로(실행 권위를 갖는 텍스트 포함)가 커밋에 "
              "포함되어 있습니다:", file=sys.stderr)
    for f in hits[:10]:
        print(f"  - {f}", file=sys.stderr)
    who = f"{user} (role: {role or '미등록'})"
    print(f"현재 사용자 {who} 는 admin이 아니므로 커밋이 거부됩니다.", file=sys.stderr)
    print("admin이라면: S9_USER=<admin이름> git commit ... 또는 s9 user role 로 역할 부여.",
          file=sys.stderr)
    print("(harness 변경은 PR로 제안하고 admin 승인을 받는 것이 원칙 — docs/09)",
          file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
    main()
