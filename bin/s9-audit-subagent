#!/usr/bin/env python3
"""section9 subagent audit hook (Claude Code SubagentStop).

리드가 Agent(서브에이전트)로 위임한 작업이 끝날 때, 그 서브에이전트의 최종 보고를
이 세션의 진행 중 REQ(binding.last_req)의 ## Notes 에 label=subagent 로 append 한다.

배경(B안): 리드의 최종 응답은 Stop 훅(s9-audit-response)이 잡지만, 위임한
서브에이전트의 산출물은 어디에도 안 남고 "리드가 받은 요약"만 남는 audit 공백이
있었다. 위임을 늘릴수록 실제 작업이 문서에서 빠지는 역설을 이 훅이 막는다.
→ REQ 문서 = 요청 + 리드응답(response) + 위임산출물(subagent) 의 완결 기록.

실제 SubagentStop 페이로드(검증됨):
  session_id            = 부모 세션의 전체 SID (앞 8자가 바인딩 키)
  last_assistant_message= 서브에이전트 최종 텍스트 (직접 제공 — 파싱 불필요)
  agent_transcript_path = 서브에이전트 전용 transcript (폴백 파싱용)
  agent_type, agent_id  = 어떤 에이전트였는지 (노트 헤더 맥락)
  transcript_path       = 부모 transcript (리드 응답용 — 여기선 쓰지 않는다)
session_id 가 부모라 binding.last_req 로 진행 중 REQ가 그대로 해석된다.
last_req 가 없으면 조용히 넘어간다. Question/Nothing 턴의 pause는 응답 캡처만
멈추고 last_req는 남기므로, 진행 중 위임 보고는 pause와 무관하게 캡처된다 (REQ-20260823-072).

원칙: 실패 시 조용히 exit 0. 비활성화: S9_AUDIT=off
"""
import json
import re
import os
import subprocess
import sys


# 윈도우에서 출력을 UTF-8 로 고정한다 (REQ-20260903-005). 이 도구들의 출력은
# 거의 다 한국어인데, 파이프로 받으면 파이썬이 콘솔 코드페이지(한국어 윈도우는
# cp949)로 인코딩한다 — 실측에서 그 출력을 UTF-8 로 읽은 쪽이 통째로 깨졌다
# (`UnicodeDecodeError: 0xc0 in position 3`). 파일에 남는 기록도 같은 이유로
# 판마다 다른 바이트가 된다. 판을 가르는 자리는 이름을 붙여 한 곳에 둔다:
# 여기가 그 자리이고, 도구마다 같은 글자로 서 있는지는 시험이 못박는다.
if os.name == "nt":
    for _std in (sys.stdout, sys.stderr):
        try:
            _std.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, ValueError, OSError):
            pass

S9 = os.path.join(os.path.dirname(os.path.abspath(__file__)), "s9")
# `bin/s9` 를 부르는 argv (REQ-20260903-005). 경로 하나만 넘기면 **윈도우에서
# 부를 수가 없다** — 그 판에는 shebang 이 없어 확장자 없는 스크립트가
# `CreateProcess` 를 통과하지 못한다(WinError 193/2). 판을 갈라 분기하는 대신
# 판에 기대는 것을 없앤다: 지금 도는 인터프리터로 그 파일을 연다. 리눅스·맥에서
# 하던 일과 결과가 같고(같은 python3 가 같은 스크립트를 연다), 실행 권한 비트나
# `env` 의 존재에도 기대지 않게 된다.
S9_ARGV = [sys.executable, S9]
MAX_CHARS = 12000



def _detect_root(data):
    """세션 cwd가 s9 리포(인스턴스)면 그 루트를 S9_ROOT로 승격 — 한 머신에서
    업스트림 카피와 인스턴스를 병행할 때 기록이 세션 위치를 따라간다
    (REQ-20260824-053). 명시된 S9_ROOT가 항상 우선."""
    if os.environ.get("S9_ROOT"):
        return
    cwd = (data.get("cwd") or "").strip()
    if cwd and os.path.exists(os.path.join(cwd, "bin", "s9")) \
            and os.path.isdir(os.path.join(cwd, "vault")):
        os.environ["S9_ROOT"] = cwd

def run(env, *argv, inp=None):
    return subprocess.run([*S9_ARGV, *argv], input=inp, capture_output=True,
                          encoding="utf-8", errors="replace", env=env, timeout=15)


def last_assistant_text(transcript_path):
    """transcript 마지막 assistant 텍스트 파트를 이어붙여 반환 (없으면 None).
    last_assistant_message 필드가 없는 하위호환 폴백 경로."""
    text = None
    try:
        with open(transcript_path, encoding="utf-8") as f:
            for line in f:
                try:
                    obj = json.loads(line)
                except ValueError:
                    continue
                if obj.get("type") != "assistant":
                    continue
                msg = obj.get("message") or {}
                parts = [c.get("text", "") for c in (msg.get("content") or [])
                         if isinstance(c, dict) and c.get("type") == "text"]
                t = "\n\n".join(p for p in parts if p).strip()
                if t:
                    text = t
    except OSError:
        return None
    return text


OPEN_STATES = ("open", "in-progress", "review", "blocked")


def _still_open(meta_text):
    """언급된 문서가 아직 진행 중인가 (REQ-20260825-066 후속).
    종결(done/cancelled)된 문서에는 언급을 근거로 보고를 붙이지 않는다 —
    끝난 일이 갑자기 갱신되면 사용자가 진행 상황을 오독한다.

    소유(승계) 판정은 여기서 하지 않는다 — s9의 _session_owns 한 곳에서만
    내린다(`s9 last --owns`). 훅이 프론트매터를 따로 긁으면 판정이 두 벌로
    갈라져 한쪽만 고쳐지는 사고가 난다."""
    for line in (meta_text or "").splitlines():
        if line.startswith("status:"):
            return line.split(":", 1)[1].strip().strip('"\'') in OPEN_STATES
    return True


def main():
    if os.environ.get("S9_AUDIT", "").lower() == "off":
        return
    data = json.load(sys.stdin)
    _detect_root(data)
    if data.get("stop_hook_active"):
        return

    # 서브에이전트 최종 보고: 페이로드가 직접 주면 그걸, 아니면 전용 transcript 파싱.
    # 절대 transcript_path(부모)로 폴백하지 않는다 — 리드 응답을 중복 캡처하게 된다.
    text = (data.get("last_assistant_message") or "").strip()
    if not text:
        atp = data.get("agent_transcript_path")
        if atp and os.path.exists(atp):
            text = (last_assistant_text(atp) or "").strip()
    if not text:
        return  # 텍스트 보고 없음(툴만 사용 등) — 붙일 것 없음

    session = (data.get("session_id") or "unknown")[:8]
    env = dict(os.environ)
    env["S9_SESSION"] = session

    # 귀속 대상 결정 (REQ-20260824-023): last_req는 훅이 매 프롬프트 회전시키므로
    # 병렬 위임 중엔 stale 오귀속이 난다(019 오염 실측). 보고 본문이 언급한 REQ 중
    # 이 세션의 실행 등록(active_reqs∪last_req)과 일치하는 것을 최우선으로 귀속한다.
    import re
    try:
        b = json.loads(run(env, "bind").stdout or "{}")
    except ValueError:
        b = {}
    last = (b.get("last_req") or "").strip()
    active = [x for x in (b.get("active_reqs") or []) if x]
    mentioned = re.findall(r"\bREQ-\d{8}-\d{3,}(?:-[0-9a-z]{4})?\b", text)
    # 1순위는 실행 등록(active_reqs/last_req)과 일치하는 언급이지만, 그 포인터
    # 자체가 stale일 수 있으므로 어느 경로든 소유 확인을 통과해야 한다 —
    # last_req가 남의 REQ를 가리키던 것이 이 사고의 출발점이었다.
    uniq = list(dict.fromkeys(mentioned))
    registered = [m for m in uniq if m in active or m == last]
    req = next((m for m in registered
                if run(env, "last", "--owns", m).stdout.strip() == m), None)
    if not req and mentioned:
        # 언급만으로 귀속하면 "읽은 문서"가 "작업한 문서"로 승격된다 —
        # 2026-08-25 done 상태의 REQ-20260824-065에 서브에이전트 보고가 붙어
        # 사용자가 "065 갑자기 왜 업데이트?"로 두 번 지적한 실사고 (REQ-066/-083).
        # 등록에 없는 언급은 (1) 이 세션이 승계·클레임했고 (2) 아직 열려 있을 때만
        # 받는다. 첫 언급 하나만 보지 않는다 — 남의 id를 먼저 말하고 자기 id를
        # 뒤에 말하는 보고가 흔하다.
        # 등록 밖 언급에는 '아직 열려 있을 것'을 더 요구한다. 등록된 REQ에는
        # 걸지 않는다 — 자기 REQ의 완결 보고는 done 직후에도 붙어야 한다.
        for cand in [m for m in uniq if m not in registered]:
            if run(env, "last", "--owns", cand).stdout.strip() != cand:
                continue
            chk = run(env, "show", cand, "--meta")
            if chk.returncode == 0 and _still_open(chk.stdout):
                req = cand
                break
        if not req:
            run(env, "log", "귀속 거부: " + ", ".join(dict.fromkeys(mentioned))
                + " (언급만 — 이 세션이 클레임하지 않았거나 종결된 문서, "
                  "REQ-20260825-066)")

    atype = data.get("agent_type") or "subagent"
    # actor 규격 (REQ-20260825-088): 기동 시 PostToolUse 훅이 등록한
    # sub:<타입>:<agentId8> 과 **같은 문자열**이어야 그 running 항목이 닫힌다.
    aid = (data.get("agent_id") or "")[:8]
    actor = f"sub:{atype}:{aid}" if aid else f"sub:{atype}"
    # 진행성 소음 필터: generic 타입 + REQ 무언급 보고는 문서에 붙이지 않는다(로그만) —
    # 장시간 위임 중 수십 건의 중간 보고가 무관 REQ를 오염시키던 문제
    if not req and atype == "subagent":
        run(env, "log", f"subagent 중간보고 생략 ({len(text)} chars)")
        return
    # 최종 폴백(last_req)도 소유 확인을 거친다 — 훅이 매 프롬프트 회전시키는
    # 포인터가 stale이면 그 자체로 남의 문서를 가리킨다. --active가 아니라
    # --owns를 쓰는 이유: 위임 보고 캡처는 pause(Question 턴)와 무관해야 한다
    # (REQ-20260823-072).
    if not req and last and run(env, "last", "--owns", last).stdout.strip() == last:
        req = last
    if not req:
        return  # 귀속처 없음 — 붙이지 않음
    if len(text) > MAX_CHARS:
        text = text[:MAX_CHARS] + "\n\n…(truncated)"
    # 위임 에이전트 귀속: 노트 헤더(agent: <type>)와 REQ 프론트매터 agents에 누적
    out = run(env, "note", req, "--label", "subagent", "--agent", actor,
              "--result", "done", *(["--transcript",
                                     data["agent_transcript_path"]]
                                    if data.get("agent_transcript_path") else []),
              inp=text)
    if out.returncode == 0:
        run(env, "log", f"subagent({actor}) → {req} ({len(text)} chars)")


if __name__ == "__main__":
    try:
        main()
    except Exception:
        sys.exit(0)
