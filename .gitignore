# 일시적 lock — 절대 커밋 금지
.s9.lock

# index/ 는 파생물 — 커밋하면 모든 머신의 모든 쓰기가 catalog.jsonl 충돌을 만든다.
# pull 후 git hook(post-merge/post-checkout)이 `s9 index rebuild` 로 재생성한다.
index/

# 비밀값은 어느 리포에도 올라가지 않는다 (REQ-20260827-035).
# users/ 를 track 하므로 여기서 명시하지 않으면 그대로 올라간다.
users/*/secrets/

# 대화 기록(미러)은 리포에 담지 않는다 (REQ-20260827-047).
# 한때 담았고(c16d407, 158MB) 이력에서 걷어냈다 — git 은 지운 것도 기억하므로
# 보관 기간을 1주일로 두어도 이력은 영구 누적이었다(한 달 0.3GB · 1년 4GB 규모).
# 아래 두 줄은 지금 자리와 앞으로 옮겨 갈 자리를 함께 막는다: 옮기고 나서
# 막으면 옮긴 경로가 또 한 번 이력에 실린다.
streams/
users/*/streams/

# ---- 로컬 전용 (vault/users/projects 는 track — REQ-20260827-036 판정) ----
# state/ 는 이 머신의 살림살이다 — 수신함·업로드 임시본·서버 로그·무인 스폰 기록·
# 세션 바인딩. state/sessions 도 2026-09-02 부터 이 머신 것이다(REQ-20260902-026):
# 다른 머신이 알아야 할 "누가 무엇을 맡았나"는 문서 frontmatter 의 lease 가 말하고,
# 바인딩의 pid·절대경로는 그 머신 밖에서 오판만 만들었다(DOC-20260902-001 D7).
state/*
scratchpad/
.claude/
*.log
__pycache__/
*.pyc
nul

# 비밀이 어디 있는지도 리포에 싣지 않는다 (REQ-20260828-028)
users/*/config/local.json
